resource "google_alloydb_backup" "example" {
    annotations = {
        key = "{{ annotations_value }}"
      }
    backup_id = "{{ backup_id }}"
    cluster_name = "{{ cluster_name }}"
    description = "{{ description }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    project = "{{ project }}"
    type = "{{ type }}"
    encryption_config {
      kms_key_name = "{{ kms_key_name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
