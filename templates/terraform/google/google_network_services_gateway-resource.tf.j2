resource "google_network_services_gateway" "example" {
    addresses = ["{{ addresses }}"]
    all_ports = {{ all_ports }}
    certificate_urls = ["{{ certificate_urls }}"]
    delete_swg_autogen_router_on_destroy = {{ delete_swg_autogen_router_on_destroy }}
    description = "{{ description }}"
    envoy_headers = "{{ envoy_headers }}"
    gateway_security_policy = "{{ gateway_security_policy }}"
    id = "{{ id }}"
    ip_version = "{{ ip_version }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    network = "{{ network }}"
    ports = ["{{ ports }}"]
    project = "{{ project }}"
    routing_mode = "{{ routing_mode }}"
    scope = "{{ scope }}"
    server_tls_policy = "{{ server_tls_policy }}"
    subnetwork = "{{ subnetwork }}"
    type = "{{ type }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
