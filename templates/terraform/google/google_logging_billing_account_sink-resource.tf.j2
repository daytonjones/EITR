resource "google_logging_billing_account_sink" "example" {
    billing_account = "{{ billing_account }}"
    description = "{{ description }}"
    destination = "{{ destination }}"
    disabled = {{ disabled }}
    filter = "{{ filter }}"
    id = "{{ id }}"
    name = "{{ name }}"
    bigquery_options {
      use_partitioned_tables = {{ use_partitioned_tables }}
    }
    exclusions {
      description = "{{ description }}"
      disabled = {{ disabled }}
      filter = "{{ filter }}"
      name = "{{ name }}"
    }
}
