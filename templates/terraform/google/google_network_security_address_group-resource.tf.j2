resource "google_network_security_address_group" "example" {
    capacity = {{ capacity }}
    description = "{{ description }}"
    id = "{{ id }}"
    items = ["{{ items }}"]
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    parent = "{{ parent }}"
    type = "{{ type }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
