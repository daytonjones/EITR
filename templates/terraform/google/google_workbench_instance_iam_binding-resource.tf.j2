resource "google_workbench_instance_iam_binding" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    members = ["{{ members }}"]
    name = "{{ name }}"
    project = "{{ project }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
