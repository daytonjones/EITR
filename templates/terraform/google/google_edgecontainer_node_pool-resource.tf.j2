resource "google_edgecontainer_node_pool" "example" {
    cluster = "{{ cluster }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    machine_filter = "{{ machine_filter }}"
    name = "{{ name }}"
    node_count = {{ node_count }}
    node_location = "{{ node_location }}"
    project = "{{ project }}"
    local_disk_encryption {
      kms_key = "{{ kms_key }}"
    }
    node_config {
      labels = {
        key = "{{ labels_value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
