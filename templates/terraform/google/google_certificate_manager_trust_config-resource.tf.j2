resource "google_certificate_manager_trust_config" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    allowlisted_certificates {
      pem_certificate = "{{ pem_certificate }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    trust_stores {
      intermediate_cas {
        pem_certificate = "{{ pem_certificate }}"
      }
      trust_anchors {
        pem_certificate = "{{ pem_certificate }}"
      }
    }
}
