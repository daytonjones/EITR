resource "google_gkeonprem_bare_metal_node_pool" "example" {
    annotations = {
        key = "{{ annotations_value }}"
      }
    bare_metal_cluster = "{{ bare_metal_cluster }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    node_pool_config {
      labels = {
        key = "{{ labels_value }}"
      }
      operating_system = "{{ operating_system }}"
      node_configs {
        labels = {
        key = "{{ labels_value }}"
      }
        node_ip = "{{ node_ip }}"
      }
      taints {
        effect = "{{ effect }}"
        key = "{{ key }}"
        value = "{{ value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
