resource "google_dataplex_datascan_iam_binding" "example" {
    data_scan_id = "{{ data_scan_id }}"
    id = "{{ id }}"
    location = "{{ location }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
