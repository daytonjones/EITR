resource "google_project" "example" {
    auto_create_network = {{ auto_create_network }}
    billing_account = "{{ billing_account }}"
    deletion_policy = "{{ deletion_policy }}"
    folder_id = "{{ folder_id }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    org_id = "{{ org_id }}"
    project_id = "{{ project_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
