resource "google_tags_tag_key" "example" {
    allowed_values_regex = "{{ allowed_values_regex }}"
    description = "{{ description }}"
    id = "{{ id }}"
    parent = "{{ parent }}"
    purpose = "{{ purpose }}"
    purpose_data = {
        key = "{{ purpose_data_value }}"
      }
    short_name = "{{ short_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
