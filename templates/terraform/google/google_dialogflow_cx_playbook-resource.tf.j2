resource "google_dialogflow_cx_playbook" "example" {
    display_name = "{{ display_name }}"
    goal = "{{ goal }}"
    id = "{{ id }}"
    parent = "{{ parent }}"
    playbook_type = "{{ playbook_type }}"
    referenced_tools = ["{{ referenced_tools }}"]
    instruction {
      guidelines = "{{ guidelines }}"
      steps {
        steps = "{{ steps }}"
        text = "{{ text }}"
      }
    }
    llm_model_settings {
      model = "{{ model }}"
      prompt_text = "{{ prompt_text }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
