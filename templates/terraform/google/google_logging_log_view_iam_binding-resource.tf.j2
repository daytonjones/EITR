resource "google_logging_log_view_iam_binding" "example" {
    bucket = "{{ bucket }}"
    id = "{{ id }}"
    location = "{{ location }}"
    members = ["{{ members }}"]
    name = "{{ name }}"
    parent = "{{ parent }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
