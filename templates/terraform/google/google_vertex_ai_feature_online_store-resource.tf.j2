resource "google_vertex_ai_feature_online_store" "example" {
    force_destroy = {{ force_destroy }}
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    project = "{{ project }}"
    region = "{{ region }}"
    bigtable {
      enable_direct_bigtable_access = {{ enable_direct_bigtable_access }}
      zone = "{{ zone }}"
      auto_scaling {
        cpu_utilization_target = {{ cpu_utilization_target }}
        max_node_count = {{ max_node_count }}
        min_node_count = {{ min_node_count }}
      }
    }
    dedicated_serving_endpoint {
      private_service_connect_config {
        enable_private_service_connect = {{ enable_private_service_connect }}
        project_allowlist = ["{{ project_allowlist }}"]
      }
    }
    encryption_spec {
      kms_key_name = "{{ kms_key_name }}"
    }
    optimized {
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
