resource "google_vertex_ai_feature_online_store_featureview" "example" {
    feature_online_store = "{{ feature_online_store }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    project = "{{ project }}"
    region = "{{ region }}"
    big_query_source {
      entity_id_columns = ["{{ entity_id_columns }}"]
      uri = "{{ uri }}"
    }
    feature_registry_source {
      project_number = "{{ project_number }}"
      feature_groups {
        feature_group_id = "{{ feature_group_id }}"
        feature_ids = ["{{ feature_ids }}"]
      }
    }
    sync_config {
      continuous = {{ continuous }}
      cron = "{{ cron }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
