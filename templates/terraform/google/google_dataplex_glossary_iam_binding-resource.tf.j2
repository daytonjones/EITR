resource "google_dataplex_glossary_iam_binding" "example" {
    glossary_id = "{{ glossary_id }}"
    id = "{{ id }}"
    location = "{{ location }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
