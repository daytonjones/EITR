resource "google_service_account" "example" {
    account_id = "{{ account_id }}"
    create_ignore_already_exists = {{ create_ignore_already_exists }}
    description = "{{ description }}"
    disabled = {{ disabled }}
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
    }
}
