resource "google_network_services_tls_route" "example" {
    description = "{{ description }}"
    gateways = ["{{ gateways }}"]
    id = "{{ id }}"
    location = "{{ location }}"
    meshes = ["{{ meshes }}"]
    name = "{{ name }}"
    project = "{{ project }}"
    target_proxies = ["{{ target_proxies }}"]
    rules {
      action {
        destinations {
          service_name = "{{ service_name }}"
          weight = {{ weight }}
        }
      }
      matches {
        alpn = ["{{ alpn }}"]
        sni_host = ["{{ sni_host }}"]
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
