resource "google_compute_region_disk" "example" {
    access_mode = "{{ access_mode }}"
    create_snapshot_before_destroy = {{ create_snapshot_before_destroy }}
    create_snapshot_before_destroy_prefix = "{{ create_snapshot_before_destroy_prefix }}"
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    licenses = ["{{ licenses }}"]
    name = "{{ name }}"
    physical_block_size_bytes = {{ physical_block_size_bytes }}
    project = "{{ project }}"
    provisioned_iops = {{ provisioned_iops }}
    provisioned_throughput = {{ provisioned_throughput }}
    region = "{{ region }}"
    replica_zones = ["{{ replica_zones }}"]
    size = {{ size }}
    snapshot = "{{ snapshot }}"
    source_disk = "{{ source_disk }}"
    type = "{{ type }}"
    async_primary_disk {
      disk = "{{ disk }}"
    }
    disk_encryption_key {
      kms_key_name = "{{ kms_key_name }}"
      raw_key = "{{ raw_key }}"
      rsa_encrypted_key = "{{ rsa_encrypted_key }}"
    }
    guest_os_features {
      type = "{{ type }}"
    }
    source_snapshot_encryption_key {
      raw_key = "{{ raw_key }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
