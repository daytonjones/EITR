resource "google_data_fusion_instance_iam_binding" "example" {
    id = "{{ id }}"
    members = ["{{ members }}"]
    name = "{{ name }}"
    project = "{{ project }}"
    region = "{{ region }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
