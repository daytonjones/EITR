resource "google_folder" "example" {
    deletion_protection = {{ deletion_protection }}
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    parent = "{{ parent }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
