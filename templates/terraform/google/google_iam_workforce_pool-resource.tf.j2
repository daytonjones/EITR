resource "google_iam_workforce_pool" "example" {
    description = "{{ description }}"
    disabled = {{ disabled }}
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    location = "{{ location }}"
    parent = "{{ parent }}"
    session_duration = "{{ session_duration }}"
    workforce_pool_id = "{{ workforce_pool_id }}"
    access_restrictions {
      disable_programmatic_signin = {{ disable_programmatic_signin }}
      allowed_services {
        domain = "{{ domain }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
