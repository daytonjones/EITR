resource "google_healthcare_hl7_v2_store" "example" {
    dataset = "{{ dataset }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    reject_duplicate_message = {{ reject_duplicate_message }}
    notification_config {
      pubsub_topic = "{{ pubsub_topic }}"
    }
    notification_configs {
      filter = "{{ filter }}"
      pubsub_topic = "{{ pubsub_topic }}"
    }
    parser_config {
      allow_null_header = {{ allow_null_header }}
      schema = "{{ schema }}"
      segment_terminator = "{{ segment_terminator }}"
      version = "{{ version }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
