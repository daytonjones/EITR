resource "google_kms_ekm_connection" "example" {
    crypto_space_path = "{{ crypto_space_path }}"
    etag = "{{ etag }}"
    id = "{{ id }}"
    key_management_mode = "{{ key_management_mode }}"
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    service_resolvers {
      endpoint_filter = "{{ endpoint_filter }}"
      hostname = "{{ hostname }}"
      service_directory_service = "{{ service_directory_service }}"
      server_certificates {
        raw_der = "{{ raw_der }}"
        subject_alternative_dns_names = ["{{ subject_alternative_dns_names }}"]
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
