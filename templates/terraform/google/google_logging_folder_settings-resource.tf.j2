resource "google_logging_folder_settings" "example" {
    disable_default_sink = {{ disable_default_sink }}
    folder = "{{ folder }}"
    id = "{{ id }}"
    kms_key_name = "{{ kms_key_name }}"
    storage_location = "{{ storage_location }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
