resource "google_network_services_multicast_consumer_association" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    multicast_consumer_association_id = "{{ multicast_consumer_association_id }}"
    multicast_domain_activation = "{{ multicast_domain_activation }}"
    network = "{{ network }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
