resource "google_dataplex_glossary_category" "example" {
    category_id = "{{ category_id }}"
    description = "{{ description }}"
    display_name = "{{ display_name }}"
    glossary_id = "{{ glossary_id }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    parent = "{{ parent }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
