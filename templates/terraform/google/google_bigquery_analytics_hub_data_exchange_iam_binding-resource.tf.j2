resource "google_bigquery_analytics_hub_data_exchange_iam_binding" "example" {
    data_exchange_id = "{{ data_exchange_id }}"
    id = "{{ id }}"
    location = "{{ location }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
