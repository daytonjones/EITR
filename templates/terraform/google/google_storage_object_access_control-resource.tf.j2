resource "google_storage_object_access_control" "example" {
    bucket = "{{ bucket }}"
    entity = "{{ entity }}"
    id = "{{ id }}"
    object = "{{ object }}"
    role = "{{ role }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
