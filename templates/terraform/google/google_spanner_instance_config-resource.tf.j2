resource "google_spanner_instance_config" "example" {
    base_config = "{{ base_config }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    project = "{{ project }}"
    replicas {
      default_leader_location = {{ default_leader_location }}
      location = "{{ location }}"
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
