resource "google_compute_security_policy_rule" "example" {
    action = "{{ action }}"
    description = "{{ description }}"
    id = "{{ id }}"
    preview = {{ preview }}
    priority = {{ priority }}
    project = "{{ project }}"
    security_policy = "{{ security_policy }}"
    header_action {
      request_headers_to_adds {
        header_name = "{{ header_name }}"
        header_value = "{{ header_value }}"
      }
    }
    match {
      versioned_expr = "{{ versioned_expr }}"
      config {
        src_ip_ranges = ["{{ src_ip_ranges }}"]
      }
      expr {
        expression = "{{ expression }}"
      }
      expr_options {
        recaptcha_options {
          action_token_site_keys = ["{{ action_token_site_keys }}"]
          session_token_site_keys = ["{{ session_token_site_keys }}"]
        }
      }
    }
    preconfigured_waf_config {
      exclusion {
        target_rule_ids = ["{{ target_rule_ids }}"]
        target_rule_set = "{{ target_rule_set }}"
        request_cookie {
          operator = "{{ operator }}"
          value = "{{ value }}"
        }
        request_header {
          operator = "{{ operator }}"
          value = "{{ value }}"
        }
        request_query_param {
          operator = "{{ operator }}"
          value = "{{ value }}"
        }
        request_uri {
          operator = "{{ operator }}"
          value = "{{ value }}"
        }
      }
    }
    rate_limit_options {
      ban_duration_sec = {{ ban_duration_sec }}
      conform_action = "{{ conform_action }}"
      enforce_on_key = "{{ enforce_on_key }}"
      enforce_on_key_name = "{{ enforce_on_key_name }}"
      exceed_action = "{{ exceed_action }}"
      ban_threshold {
        count = {{ count }}
        interval_sec = {{ interval_sec }}
      }
      enforce_on_key_configs {
        enforce_on_key_name = "{{ enforce_on_key_name }}"
        enforce_on_key_type = "{{ enforce_on_key_type }}"
      }
      exceed_redirect_options {
        target = "{{ target }}"
        type = "{{ type }}"
      }
      rate_limit_threshold {
        count = {{ count }}
        interval_sec = {{ interval_sec }}
      }
    }
    redirect_options {
      target = "{{ target }}"
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
