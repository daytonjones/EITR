resource "google_bigquery_row_access_policy" "example" {
    dataset_id = "{{ dataset_id }}"
    filter_predicate = "{{ filter_predicate }}"
    grantees = ["{{ grantees }}"]
    id = "{{ id }}"
    policy_id = "{{ policy_id }}"
    project = "{{ project }}"
    table_id = "{{ table_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
