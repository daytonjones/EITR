resource "google_binary_authorization_attestor_iam_binding" "example" {
    attestor = "{{ attestor }}"
    id = "{{ id }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
