resource "google_network_services_mesh" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    interception_port = {{ interception_port }}
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
