resource "google_dns_managed_zone_iam_binding" "example" {
    id = "{{ id }}"
    managed_zone = "{{ managed_zone }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
