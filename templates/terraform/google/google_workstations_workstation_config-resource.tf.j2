resource "google_workstations_workstation_config" "example" {
    annotations = {
        key = "{{ annotations_value }}"
      }
    disable_tcp_connections = {{ disable_tcp_connections }}
    display_name = "{{ display_name }}"
    enable_audit_agent = {{ enable_audit_agent }}
    id = "{{ id }}"
    idle_timeout = "{{ idle_timeout }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    max_usable_workstations = {{ max_usable_workstations }}
    project = "{{ project }}"
    replica_zones = ["{{ replica_zones }}"]
    running_timeout = "{{ running_timeout }}"
    workstation_cluster_id = "{{ workstation_cluster_id }}"
    workstation_config_id = "{{ workstation_config_id }}"
    allowed_ports {
      first = {{ first }}
      last = {{ last }}
    }
    container {
      args = ["{{ args }}"]
      command = ["{{ command }}"]
      env = {
        key = "{{ env_value }}"
      }
      image = "{{ image }}"
      run_as_user = {{ run_as_user }}
      working_dir = "{{ working_dir }}"
    }
    encryption_key {
      kms_key = "{{ kms_key }}"
      kms_key_service_account = "{{ kms_key_service_account }}"
    }
    ephemeral_directories {
      mount_path = "{{ mount_path }}"
      gce_pd {
        disk_type = "{{ disk_type }}"
        read_only = {{ read_only }}
        source_image = "{{ source_image }}"
        source_snapshot = "{{ source_snapshot }}"
      }
    }
    host {
      gce_instance {
        boot_disk_size_gb = {{ boot_disk_size_gb }}
        disable_public_ip_addresses = {{ disable_public_ip_addresses }}
        disable_ssh = {{ disable_ssh }}
        enable_nested_virtualization = {{ enable_nested_virtualization }}
        machine_type = "{{ machine_type }}"
        pool_size = {{ pool_size }}
        service_account = "{{ service_account }}"
        service_account_scopes = ["{{ service_account_scopes }}"]
        tags = ["{{ tags }}"]
        vm_tags = {
        key = "{{ vm_tags_value }}"
      }
        accelerators {
          count = {{ count }}
          type = "{{ type }}"
        }
        boost_configs {
          boot_disk_size_gb = {{ boot_disk_size_gb }}
          enable_nested_virtualization = {{ enable_nested_virtualization }}
          id = "{{ id }}"
          machine_type = "{{ machine_type }}"
          pool_size = {{ pool_size }}
          accelerators {
            count = {{ count }}
            type = "{{ type }}"
          }
        }
        confidential_instance_config {
          enable_confidential_compute = {{ enable_confidential_compute }}
        }
        shielded_instance_config {
          enable_integrity_monitoring = {{ enable_integrity_monitoring }}
          enable_secure_boot = {{ enable_secure_boot }}
          enable_vtpm = {{ enable_vtpm }}
        }
      }
    }
    persistent_directories {
      mount_path = "{{ mount_path }}"
      gce_pd {
        disk_type = "{{ disk_type }}"
        fs_type = "{{ fs_type }}"
        reclaim_policy = "{{ reclaim_policy }}"
        size_gb = {{ size_gb }}
        source_snapshot = "{{ source_snapshot }}"
      }
    }
    readiness_checks {
      path = "{{ path }}"
      port = {{ port }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
