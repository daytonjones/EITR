resource "google_gke_hub_membership_binding" "example" {
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    membership_binding_id = "{{ membership_binding_id }}"
    membership_id = "{{ membership_id }}"
    project = "{{ project }}"
    scope = "{{ scope }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
