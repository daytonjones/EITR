resource "google_dialogflow_cx_generator" "example" {
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    language_code = "{{ language_code }}"
    parent = "{{ parent }}"
    llm_model_settings {
      model = "{{ model }}"
      prompt_text = "{{ prompt_text }}"
    }
    model_parameter {
      max_decode_steps = {{ max_decode_steps }}
      temperature = {{ temperature }}
      top_k = {{ top_k }}
      top_p = {{ top_p }}
    }
    placeholders {
      id = "{{ id }}"
      name = "{{ name }}"
    }
    prompt_text {
      text = "{{ text }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
