resource "google_network_security_authz_policy" "example" {
    action = "{{ action }}"
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    policy_profile = "{{ policy_profile }}"
    project = "{{ project }}"
    custom_provider {
      authz_extension {
        resources = ["{{ resources }}"]
      }
      cloud_iap {
        enabled = {{ enabled }}
      }
    }
    http_rules {
      when = "{{ when }}"
      from {
        not_sources {
          ip_blocks {
            length = {{ length }}
            prefix = "{{ prefix }}"
          }
          principals {
            contains = "{{ contains }}"
            exact = "{{ exact }}"
            ignore_case = {{ ignore_case }}
            prefix = "{{ prefix }}"
            principal_selector = "{{ principal_selector }}"
            suffix = "{{ suffix }}"
