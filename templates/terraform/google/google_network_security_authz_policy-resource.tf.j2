    target {
      load_balancing_scheme = "{{ load_balancing_scheme }}"
      resources = ["{{ resources }}"]
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
