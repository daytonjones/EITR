resource "google_network_connectivity_regional_endpoint" "example" {
    access_type = "{{ access_type }}"
    address = "{{ address }}"
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    network = "{{ network }}"
    project = "{{ project }}"
    subnetwork = "{{ subnetwork }}"
    target_google_api = "{{ target_google_api }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
