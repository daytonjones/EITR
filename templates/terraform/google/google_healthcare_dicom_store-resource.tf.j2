resource "google_healthcare_dicom_store" "example" {
    dataset = "{{ dataset }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    notification_config {
      pubsub_topic = "{{ pubsub_topic }}"
      send_for_bulk_import = {{ send_for_bulk_import }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
