resource "google_project_organization_policy" "example" {
    constraint = "{{ constraint }}"
    id = "{{ id }}"
    project = "{{ project }}"
    version = {{ version }}
    boolean_policy {
      enforced = {{ enforced }}
    }
    list_policy {
      inherit_from_parent = {{ inherit_from_parent }}
      suggested_value = "{{ suggested_value }}"
      allow {
        all = {{ all }}
        values = ["{{ values }}"]
      }
      deny {
        all = {{ all }}
        values = ["{{ values }}"]
      }
    }
    restore_policy {
      default = {{ default }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
