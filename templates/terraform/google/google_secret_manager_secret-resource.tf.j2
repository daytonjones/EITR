resource "google_secret_manager_secret" "example" {
    annotations = {
        key = "{{ annotations_value }}"
      }
    deletion_protection = {{ deletion_protection }}
    expire_time = "{{ expire_time }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    project = "{{ project }}"
    secret_id = "{{ secret_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    ttl = "{{ ttl }}"
    version_aliases = {
        key = "{{ version_aliases_value }}"
      }
    version_destroy_ttl = "{{ version_destroy_ttl }}"
    replication {
      auto {
        customer_managed_encryption {
          kms_key_name = "{{ kms_key_name }}"
        }
      }
      user_managed {
        replicas {
          location = "{{ location }}"
          customer_managed_encryption {
            kms_key_name = "{{ kms_key_name }}"
          }
        }
      }
    }
    rotation {
      next_rotation_time = "{{ next_rotation_time }}"
      rotation_period = "{{ rotation_period }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    topics {
      name = "{{ name }}"
    }
}
