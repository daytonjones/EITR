resource "google_healthcare_workspace" "example" {
    dataset = "{{ dataset }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    settings {
      data_project_ids = ["{{ data_project_ids }}"]
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
