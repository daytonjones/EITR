resource "google_network_connectivity_policy_based_route" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    network = "{{ network }}"
    next_hop_ilb_ip = "{{ next_hop_ilb_ip }}"
    next_hop_other_routes = "{{ next_hop_other_routes }}"
    priority = {{ priority }}
    project = "{{ project }}"
    filter {
      dest_range = "{{ dest_range }}"
      ip_protocol = "{{ ip_protocol }}"
      protocol_version = "{{ protocol_version }}"
      src_range = "{{ src_range }}"
    }
    interconnect_attachment {
      region = "{{ region }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    virtual_machine {
      tags = ["{{ tags }}"]
    }
}
