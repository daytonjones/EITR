resource "google_backup_dr_backup_plan" "example" {
    backup_plan_id = "{{ backup_plan_id }}"
    backup_vault = "{{ backup_vault }}"
    description = "{{ description }}"
    id = "{{ id }}"
    location = "{{ location }}"
    log_retention_days = {{ log_retention_days }}
    max_custom_on_demand_retention_days = {{ max_custom_on_demand_retention_days }}
    project = "{{ project }}"
    resource_type = "{{ resource_type }}"
    backup_rules {
      backup_retention_days = {{ backup_retention_days }}
      rule_id = "{{ rule_id }}"
      standard_schedule {
        days_of_month = ["{{ days_of_month }}"]
        days_of_week = ["{{ days_of_week }}"]
        hourly_frequency = {{ hourly_frequency }}
        months = ["{{ months }}"]
        recurrence_type = "{{ recurrence_type }}"
        time_zone = "{{ time_zone }}"
        backup_window {
          end_hour_of_day = {{ end_hour_of_day }}
          start_hour_of_day = {{ start_hour_of_day }}
        }
        week_day_of_month {
          day_of_week = "{{ day_of_week }}"
          week_of_month = "{{ week_of_month }}"
        }
      }
    }
    disk_backup_plan_properties {
      guest_flush = {{ guest_flush }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
