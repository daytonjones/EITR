resource "google_scc_v2_folder_notification_config" "example" {
    config_id = "{{ config_id }}"
    description = "{{ description }}"
    folder = "{{ folder }}"
    id = "{{ id }}"
    location = "{{ location }}"
    pubsub_topic = "{{ pubsub_topic }}"
    streaming_config {
      filter = "{{ filter }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
