resource "google_composer_user_workloads_config_map" "example" {
    data = {
        key = "{{ data_value }}"
      }
    environment = "{{ environment }}"
    id = "{{ id }}"
    name = "{{ name }}"
    project = "{{ project }}"
    region = "{{ region }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
