resource "google_network_services_edge_cache_keyset" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    project = "{{ project }}"
    public_key {
      id = "{{ id }}"
      managed = {{ managed }}
      value = "{{ value }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    validation_shared_keys {
      secret_version = "{{ secret_version }}"
    }
}
