resource "google_app_engine_domain_mapping" "example" {
    domain_name = "{{ domain_name }}"
    id = "{{ id }}"
    override_strategy = "{{ override_strategy }}"
    project = "{{ project }}"
    ssl_settings {
      certificate_id = "{{ certificate_id }}"
      ssl_management_type = "{{ ssl_management_type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
