resource "google_compute_target_http_proxy" "example" {
    description = "{{ description }}"
    http_keep_alive_timeout_sec = {{ http_keep_alive_timeout_sec }}
    id = "{{ id }}"
    name = "{{ name }}"
    project = "{{ project }}"
    proxy_bind = {{ proxy_bind }}
    url_map = "{{ url_map }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
