resource "google_gke_hub_membership" "example" {
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    membership_id = "{{ membership_id }}"
    project = "{{ project }}"
    authority {
      issuer = "{{ issuer }}"
    }
    endpoint {
      gke_cluster {
        resource_link = "{{ resource_link }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
