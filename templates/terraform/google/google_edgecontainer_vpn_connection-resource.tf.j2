resource "google_edgecontainer_vpn_connection" "example" {
    cluster = "{{ cluster }}"
    enable_high_availability = {{ enable_high_availability }}
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    nat_gateway_ip = "{{ nat_gateway_ip }}"
    project = "{{ project }}"
    router = "{{ router }}"
    vpc = "{{ vpc }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    vpc_project {
      project_id = "{{ project_id }}"
    }
}
