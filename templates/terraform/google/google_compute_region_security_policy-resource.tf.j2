resource "google_compute_region_security_policy" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    project = "{{ project }}"
    region = "{{ region }}"
    type = "{{ type }}"
    advanced_options_config {
      json_parsing = "{{ json_parsing }}"
      log_level = "{{ log_level }}"
      user_ip_request_headers = ["{{ user_ip_request_headers }}"]
      json_custom_config {
        content_types = ["{{ content_types }}"]
      }
    }
    ddos_protection_config {
      ddos_protection = "{{ ddos_protection }}"
    }
    rules {
      action = "{{ action }}"
      description = "{{ description }}"
      preview = {{ preview }}
      priority = {{ priority }}
      match {
        versioned_expr = "{{ versioned_expr }}"
        config {
          src_ip_ranges = ["{{ src_ip_ranges }}"]
        }
        expr {
          expression = "{{ expression }}"
        }
      }
      network_match {
        dest_ip_ranges = ["{{ dest_ip_ranges }}"]
        dest_ports = ["{{ dest_ports }}"]
        ip_protocols = ["{{ ip_protocols }}"]
        src_asns = ["{{ src_asns }}"]
        src_ip_ranges = ["{{ src_ip_ranges }}"]
        src_ports = ["{{ src_ports }}"]
        src_region_codes = ["{{ src_region_codes }}"]
        user_defined_fields {
          name = "{{ name }}"
          values = ["{{ values }}"]
        }
      }
      preconfigured_waf_config {
        exclusion {
          target_rule_ids = ["{{ target_rule_ids }}"]
          target_rule_set = "{{ target_rule_set }}"
          request_cookie {
            operator = "{{ operator }}"
            value = "{{ value }}"
          }
          request_header {
            operator = "{{ operator }}"
            value = "{{ value }}"
          }
          request_query_param {
            operator = "{{ operator }}"
            value = "{{ value }}"
          }
          request_uri {
            operator = "{{ operator }}"
            value = "{{ value }}"
          }
        }
      }
      rate_limit_options {
        ban_duration_sec = {{ ban_duration_sec }}
        conform_action = "{{ conform_action }}"
        enforce_on_key = "{{ enforce_on_key }}"
        enforce_on_key_name = "{{ enforce_on_key_name }}"
        exceed_action = "{{ exceed_action }}"
        ban_threshold {
          count = {{ count }}
          interval_sec = {{ interval_sec }}
        }
        enforce_on_key_configs {
          enforce_on_key_name = "{{ enforce_on_key_name }}"
          enforce_on_key_type = "{{ enforce_on_key_type }}"
        }
        rate_limit_threshold {
          count = {{ count }}
          interval_sec = {{ interval_sec }}
        }
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    user_defined_fields {
      base = "{{ base }}"
      mask = "{{ mask }}"
      name = "{{ name }}"
      offset = {{ offset }}
      size = {{ size }}
    }
}
