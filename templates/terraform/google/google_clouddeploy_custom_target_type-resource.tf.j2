resource "google_clouddeploy_custom_target_type" "example" {
    annotations = {
        key = "{{ annotations_value }}"
      }
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    custom_actions {
      deploy_action = "{{ deploy_action }}"
      render_action = "{{ render_action }}"
      include_skaffold_modules {
        configs = ["{{ configs }}"]
        git {
          path = "{{ path }}"
          ref = "{{ ref }}"
          repo = "{{ repo }}"
        }
        google_cloud_build_repo {
          path = "{{ path }}"
          ref = "{{ ref }}"
          repository = "{{ repository }}"
        }
        google_cloud_storage {
          path = "{{ path }}"
          source = "{{ source }}"
        }
      }
    }
    tasks {
      deploy {
        container {
          args = ["{{ args }}"]
          command = ["{{ command }}"]
          env = {
        key = "{{ env_value }}"
      }
          image = "{{ image }}"
        }
      }
      render {
        container {
          args = ["{{ args }}"]
          command = ["{{ command }}"]
          env = {
        key = "{{ env_value }}"
      }
          image = "{{ image }}"
        }
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
