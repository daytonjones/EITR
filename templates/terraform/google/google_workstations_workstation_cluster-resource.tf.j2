resource "google_workstations_workstation_cluster" "example" {
    annotations = {
        key = "{{ annotations_value }}"
      }
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    network = "{{ network }}"
    project = "{{ project }}"
    subnetwork = "{{ subnetwork }}"
    tags = {
        key = "{{ tags_value }}"
      }
    workstation_cluster_id = "{{ workstation_cluster_id }}"
    domain_config {
      domain = "{{ domain }}"
    }
    private_cluster_config {
      allowed_projects = ["{{ allowed_projects }}"]
      enable_private_endpoint = {{ enable_private_endpoint }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
