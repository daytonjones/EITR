resource "google_compute_region_commitment" "example" {
    auto_renew = {{ auto_renew }}
    category = "{{ category }}"
    description = "{{ description }}"
    existing_reservations = "{{ existing_reservations }}"
    id = "{{ id }}"
    name = "{{ name }}"
    plan = "{{ plan }}"
    project = "{{ project }}"
    region = "{{ region }}"
    type = "{{ type }}"
    license_resource {
      amount = "{{ amount }}"
      cores_per_license = "{{ cores_per_license }}"
      license = "{{ license }}"
    }
    resources {
      accelerator_type = "{{ accelerator_type }}"
      amount = "{{ amount }}"
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
