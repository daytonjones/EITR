resource "google_integration_connectors_endpoint_attachment" "example" {
    description = "{{ description }}"
    endpoint_global_access = {{ endpoint_global_access }}
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    service_attachment = "{{ service_attachment }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
