resource "google_service_directory_endpoint" "example" {
    address = "{{ address }}"
    endpoint_id = "{{ endpoint_id }}"
    id = "{{ id }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    network = "{{ network }}"
    port = {{ port }}
    service = "{{ service }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
