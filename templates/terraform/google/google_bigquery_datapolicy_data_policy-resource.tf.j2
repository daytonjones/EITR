resource "google_bigquery_datapolicy_data_policy" "example" {
    data_policy_id = "{{ data_policy_id }}"
    data_policy_type = "{{ data_policy_type }}"
    id = "{{ id }}"
    location = "{{ location }}"
    policy_tag = "{{ policy_tag }}"
    project = "{{ project }}"
    data_masking_policy {
      predefined_expression = "{{ predefined_expression }}"
      routine = "{{ routine }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
