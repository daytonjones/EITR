resource "google_memcache_instance" "example" {
    authorized_network = "{{ authorized_network }}"
    deletion_protection = {{ deletion_protection }}
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    memcache_version = "{{ memcache_version }}"
    name = "{{ name }}"
    node_count = {{ node_count }}
    project = "{{ project }}"
    region = "{{ region }}"
    reserved_ip_range_id = ["{{ reserved_ip_range_id }}"]
    zones = ["{{ zones }}"]
    maintenance_policy {
      description = "{{ description }}"
      weekly_maintenance_window {
        day = "{{ day }}"
        duration = "{{ duration }}"
        start_time {
          hours = {{ hours }}
          minutes = {{ minutes }}
          nanos = {{ nanos }}
          seconds = {{ seconds }}
        }
      }
    }
    memcache_parameters {
      params = {
        key = "{{ params_value }}"
      }
    }
    node_config {
      cpu_count = {{ cpu_count }}
      memory_size_mb = {{ memory_size_mb }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
