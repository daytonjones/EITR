resource "google_compute_resize_request" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    instance_group_manager = "{{ instance_group_manager }}"
    name = "{{ name }}"
    project = "{{ project }}"
    resize_by = {{ resize_by }}
    zone = "{{ zone }}"
    requested_run_duration {
      nanos = {{ nanos }}
      seconds = "{{ seconds }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
