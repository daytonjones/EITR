resource "google_scc_source_iam_binding" "example" {
    id = "{{ id }}"
    members = ["{{ members }}"]
    organization = "{{ organization }}"
    role = "{{ role }}"
    source = "{{ source }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
