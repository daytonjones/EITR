resource "google_firebase_app_check_recaptcha_v3_config" "example" {
    app_id = "{{ app_id }}"
    id = "{{ id }}"
    project = "{{ project }}"
    site_secret = "{{ site_secret }}"
    token_ttl = "{{ token_ttl }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
