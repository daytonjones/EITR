resource "google_integration_connectors_managed_zone" "example" {
    description = "{{ description }}"
    dns = "{{ dns }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    project = "{{ project }}"
    target_project = "{{ target_project }}"
    target_vpc = "{{ target_vpc }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
