resource "google_compute_region_target_http_proxy" "example" {
    description = "{{ description }}"
    http_keep_alive_timeout_sec = {{ http_keep_alive_timeout_sec }}
    id = "{{ id }}"
    name = "{{ name }}"
    project = "{{ project }}"
    region = "{{ region }}"
    url_map = "{{ url_map }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
