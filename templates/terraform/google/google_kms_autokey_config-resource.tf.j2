resource "google_kms_autokey_config" "example" {
    folder = "{{ folder }}"
    id = "{{ id }}"
    key_project = "{{ key_project }}"
    key_project_resolution_mode = "{{ key_project_resolution_mode }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
