resource "google_workstations_workstation" "example" {
    annotations = {
        key = "{{ annotations_value }}"
      }
    display_name = "{{ display_name }}"
    env = {
        key = "{{ env_value }}"
      }
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    project = "{{ project }}"
    source_workstation = "{{ source_workstation }}"
    workstation_cluster_id = "{{ workstation_cluster_id }}"
    workstation_config_id = "{{ workstation_config_id }}"
    workstation_id = "{{ workstation_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
