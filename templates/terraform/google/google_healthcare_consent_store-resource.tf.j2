resource "google_healthcare_consent_store" "example" {
    dataset = "{{ dataset }}"
    default_consent_ttl = "{{ default_consent_ttl }}"
    enable_consent_create_on_update = {{ enable_consent_create_on_update }}
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
