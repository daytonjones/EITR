resource "google_kms_crypto_key_version" "example" {
    crypto_key = "{{ crypto_key }}"
    id = "{{ id }}"
    state = "{{ state }}"
    external_protection_level_options {
      ekm_connection_key_path = "{{ ekm_connection_key_path }}"
      external_key_uri = "{{ external_key_uri }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
