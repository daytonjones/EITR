resource "google_monitoring_service" "example" {
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    project = "{{ project }}"
    service_id = "{{ service_id }}"
    user_labels = {
        key = "{{ user_labels_value }}"
      }
    basic_service {
      service_labels = {
        key = "{{ service_labels_value }}"
      }
      service_type = "{{ service_type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
