resource "google_pubsub_schema_iam_binding" "example" {
    id = "{{ id }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    schema = "{{ schema }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
