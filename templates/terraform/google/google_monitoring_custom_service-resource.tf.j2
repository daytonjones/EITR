resource "google_monitoring_custom_service" "example" {
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    project = "{{ project }}"
    service_id = "{{ service_id }}"
    user_labels = {
        key = "{{ user_labels_value }}"
      }
    telemetry {
      resource_name = "{{ resource_name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
