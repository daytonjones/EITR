resource "google_compute_vpn_gateway" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    network = "{{ network }}"
    project = "{{ project }}"
    region = "{{ region }}"
    params {
      resource_manager_tags = {
        key = "{{ resource_manager_tags_value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
