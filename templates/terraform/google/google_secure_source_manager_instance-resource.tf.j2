resource "google_secure_source_manager_instance" "example" {
    deletion_policy = "{{ deletion_policy }}"
    id = "{{ id }}"
    instance_id = "{{ instance_id }}"
    kms_key = "{{ kms_key }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    project = "{{ project }}"
    private_config {
      ca_pool = "{{ ca_pool }}"
      is_private = {{ is_private }}
      custom_host_config {
        api = "{{ api }}"
        git_http = "{{ git_http }}"
        git_ssh = "{{ git_ssh }}"
        html = "{{ html }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    workforce_identity_federation_config {
      enabled = {{ enabled }}
    }
}
