resource "google_identity_platform_default_supported_idp_config" "example" {
    client_id = "{{ client_id }}"
    client_secret = "{{ client_secret }}"
    enabled = {{ enabled }}
    id = "{{ id }}"
    idp_id = "{{ idp_id }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
