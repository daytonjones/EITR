resource "google_network_services_endpoint_policy" "example" {
    authorization_policy = "{{ authorization_policy }}"
    client_tls_policy = "{{ client_tls_policy }}"
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    project = "{{ project }}"
    server_tls_policy = "{{ server_tls_policy }}"
    type = "{{ type }}"
    endpoint_matcher {
      metadata_label_matcher {
        metadata_label_match_criteria = "{{ metadata_label_match_criteria }}"
        metadata_labels {
          label_name = "{{ label_name }}"
          label_value = "{{ label_value }}"
        }
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    traffic_port_selector {
      ports = ["{{ ports }}"]
    }
}
