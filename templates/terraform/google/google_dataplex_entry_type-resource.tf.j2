resource "google_dataplex_entry_type" "example" {
    description = "{{ description }}"
    display_name = "{{ display_name }}"
    entry_type_id = "{{ entry_type_id }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    platform = "{{ platform }}"
    project = "{{ project }}"
    system = "{{ system }}"
    type_aliases = ["{{ type_aliases }}"]
    required_aspects {
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
