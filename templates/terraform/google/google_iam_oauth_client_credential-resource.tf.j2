resource "google_iam_oauth_client_credential" "example" {
    disabled = {{ disabled }}
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    location = "{{ location }}"
    oauth_client_credential_id = "{{ oauth_client_credential_id }}"
    oauthclient = "{{ oauthclient }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
