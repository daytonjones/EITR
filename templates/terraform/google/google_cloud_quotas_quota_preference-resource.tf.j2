resource "google_cloud_quotas_quota_preference" "example" {
    contact_email = "{{ contact_email }}"
    dimensions = {
        key = "{{ dimensions_value }}"
      }
    id = "{{ id }}"
    ignore_safety_checks = "{{ ignore_safety_checks }}"
    justification = "{{ justification }}"
    name = "{{ name }}"
    parent = "{{ parent }}"
    quota_id = "{{ quota_id }}"
    service = "{{ service }}"
    quota_config {
      annotations = {
        key = "{{ annotations_value }}"
      }
      preferred_value = "{{ preferred_value }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
