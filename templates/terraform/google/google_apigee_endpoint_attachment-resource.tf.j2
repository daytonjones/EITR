resource "google_apigee_endpoint_attachment" "example" {
    endpoint_attachment_id = "{{ endpoint_attachment_id }}"
    id = "{{ id }}"
    location = "{{ location }}"
    org_id = "{{ org_id }}"
    service_attachment = "{{ service_attachment }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
