resource "google_gemini_data_sharing_with_google_setting" "example" {
    data_sharing_with_google_setting_id = "{{ data_sharing_with_google_setting_id }}"
    enable_data_sharing = {{ enable_data_sharing }}
    enable_preview_data_sharing = {{ enable_preview_data_sharing }}
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
