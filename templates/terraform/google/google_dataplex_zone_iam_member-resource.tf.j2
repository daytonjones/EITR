resource "google_dataplex_zone_iam_member" "example" {
    dataplex_zone = "{{ dataplex_zone }}"
    id = "{{ id }}"
    lake = "{{ lake }}"
    location = "{{ location }}"
    member = "{{ member }}"
    project = "{{ project }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
