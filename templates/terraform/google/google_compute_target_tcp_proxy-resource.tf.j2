resource "google_compute_target_tcp_proxy" "example" {
    backend_service = "{{ backend_service }}"
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    project = "{{ project }}"
    proxy_bind = {{ proxy_bind }}
    proxy_header = "{{ proxy_header }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
