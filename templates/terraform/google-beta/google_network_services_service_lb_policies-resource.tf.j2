resource "google_network_services_service_lb_policies" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    load_balancing_algorithm = "{{ load_balancing_algorithm }}"
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    auto_capacity_drain {
      enable = {{ enable }}
    }
    failover_config {
      failover_health_threshold = {{ failover_health_threshold }}
    }
    isolation_config {
      isolation_granularity = "{{ isolation_granularity }}"
      isolation_mode = "{{ isolation_mode }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
