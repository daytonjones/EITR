resource "google_api_gateway_gateway_iam_binding" "example" {
    gateway = "{{ gateway }}"
    id = "{{ id }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    region = "{{ region }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
