resource "google_firebase_app_check_debug_token" "example" {
    app_id = "{{ app_id }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    project = "{{ project }}"
    token = "{{ token }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
