resource "google_container_azure_node_pool" "example" {
    annotations = {
        key = "{{ annotations_value }}"
      }
    azure_availability_zone = "{{ azure_availability_zone }}"
    cluster = "{{ cluster }}"
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    subnet_id = "{{ subnet_id }}"
    version = "{{ version }}"
    autoscaling {
      max_node_count = {{ max_node_count }}
      min_node_count = {{ min_node_count }}
    }
    config {
      image_type = "{{ image_type }}"
      labels = {
        key = "{{ labels_value }}"
      }
      tags = {
        key = "{{ tags_value }}"
      }
      vm_size = "{{ vm_size }}"
      proxy_config {
        resource_group_id = "{{ resource_group_id }}"
        secret_id = "{{ secret_id }}"
      }
      root_volume {
        size_gib = {{ size_gib }}
      }
      ssh_config {
        authorized_key = "{{ authorized_key }}"
      }
    }
    management {
      auto_repair = {{ auto_repair }}
    }
    max_pods_constraint {
      max_pods_per_node = {{ max_pods_per_node }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
