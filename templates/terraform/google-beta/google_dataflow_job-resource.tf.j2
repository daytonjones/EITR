resource "google_dataflow_job" "example" {
    additional_experiments = ["{{ additional_experiments }}"]
    enable_streaming_engine = {{ enable_streaming_engine }}
    id = "{{ id }}"
    ip_configuration = "{{ ip_configuration }}"
    kms_key_name = "{{ kms_key_name }}"
    labels = {
        key = "{{ labels_value }}"
      }
    machine_type = "{{ machine_type }}"
    max_workers = {{ max_workers }}
    name = "{{ name }}"
    network = "{{ network }}"
    on_delete = "{{ on_delete }}"
    parameters = {
        key = "{{ parameters_value }}"
      }
    project = "{{ project }}"
    region = "{{ region }}"
    service_account_email = "{{ service_account_email }}"
    skip_wait_on_job_termination = {{ skip_wait_on_job_termination }}
    subnetwork = "{{ subnetwork }}"
    temp_gcs_location = "{{ temp_gcs_location }}"
    template_gcs_path = "{{ template_gcs_path }}"
    transform_name_mapping = {
        key = "{{ transform_name_mapping_value }}"
      }
    zone = "{{ zone }}"
    timeouts {
      update = "{{ update }}"
    }
}
