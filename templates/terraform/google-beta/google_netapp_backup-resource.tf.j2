resource "google_netapp_backup" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    source_snapshot = "{{ source_snapshot }}"
    source_volume = "{{ source_volume }}"
    vault_name = "{{ vault_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
