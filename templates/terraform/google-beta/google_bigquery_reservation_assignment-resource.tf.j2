resource "google_bigquery_reservation_assignment" "example" {
    assignee = "{{ assignee }}"
    id = "{{ id }}"
    job_type = "{{ job_type }}"
    location = "{{ location }}"
    project = "{{ project }}"
    reservation = "{{ reservation }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
