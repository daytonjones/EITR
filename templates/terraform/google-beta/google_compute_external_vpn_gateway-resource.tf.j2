resource "google_compute_external_vpn_gateway" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    project = "{{ project }}"
    redundancy_type = "{{ redundancy_type }}"
    interface {
      id = {{ id }}
      ip_address = "{{ ip_address }}"
      ipv6_address = "{{ ipv6_address }}"
    }
    params {
      resource_manager_tags = {
        key = "{{ resource_manager_tags_value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
