resource "google_data_loss_prevention_discovery_config" "example" {
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    inspect_templates = ["{{ inspect_templates }}"]
    location = "{{ location }}"
    parent = "{{ parent }}"
    status = "{{ status }}"
    actions {
      export_data {
        profile_table {
          dataset_id = "{{ dataset_id }}"
          project_id = "{{ project_id }}"
          table_id = "{{ table_id }}"
        }
        sample_findings_table {
          dataset_id = "{{ dataset_id }}"
          project_id = "{{ project_id }}"
          table_id = "{{ table_id }}"
        }
      }
      pub_sub_notification {
        detail_of_message = "{{ detail_of_message }}"
        event = "{{ event }}"
        topic = "{{ topic }}"
        pubsub_condition {
          expressions {
            logical_operator = "{{ logical_operator }}"
            conditions {
              minimum_risk_score = "{{ minimum_risk_score }}"
              minimum_sensitivity_score = "{{ minimum_sensitivity_score }}"
            }
          }
        }
      }
      publish_to_chronicle {
      }
      publish_to_dataplex_catalog {
      }
      publish_to_scc {
      }
      tag_resources {
        lower_data_risk_to_low = {{ lower_data_risk_to_low }}
        profile_generations_to_tag = ["{{ profile_generations_to_tag }}"]
        tag_conditions {
          sensitivity_score {
            score = "{{ score }}"
          }
          tag {
            namespaced_value = "{{ namespaced_value }}"
          }
        }
      }
    }
    org_config {
      project_id = "{{ project_id }}"
      location {
        folder_id = "{{ folder_id }}"
        organization_id = "{{ organization_id }}"
      }
    }
    other_cloud_starting_location {
      aws_location {
        account_id = "{{ account_id }}"
        all_asset_inventory_assets = {{ all_asset_inventory_assets }}
      }
    }
    targets {
      big_query_target {
        cadence {
          inspect_template_modified_cadence {
            frequency = "{{ frequency }}"
          }
          schema_modified_cadence {
            frequency = "{{ frequency }}"
            types = ["{{ types }}"]
          }
          table_modified_cadence {
            frequency = "{{ frequency }}"
            types = ["{{ types }}"]
          }
        }
        conditions {
          created_after = "{{ created_after }}"
          type_collection = "{{ type_collection }}"
          or_conditions {
            min_age = "{{ min_age }}"
            min_row_count = {{ min_row_count }}
          }
          types {
            types = ["{{ types }}"]
          }
        }
        disabled {
        }
        filter {
          other_tables {
          }
          table_reference {
            dataset_id = "{{ dataset_id }}"
            project_id = "{{ project_id }}"
            table_id = "{{ table_id }}"
          }
          tables {
            include_regexes {
              patterns {
                dataset_id_regex = "{{ dataset_id_regex }}"
                project_id_regex = "{{ project_id_regex }}"
                table_id_regex = "{{ table_id_regex }}"
              }
            }
          }
        }
      }
      cloud_sql_target {
        conditions {
          database_engines = ["{{ database_engines }}"]
          types = ["{{ types }}"]
        }
        disabled {
        }
        filter {
          collection {
            include_regexes {
              patterns {
                database_regex = "{{ database_regex }}"
                database_resource_name_regex = "{{ database_resource_name_regex }}"
                instance_regex = "{{ instance_regex }}"
                project_id_regex = "{{ project_id_regex }}"
              }
            }
          }
          database_resource_reference {
            database = "{{ database }}"
            database_resource = "{{ database_resource }}"
            instance = "{{ instance }}"
            project_id = "{{ project_id }}"
          }
          others {
          }
        }
        generation_cadence {
          refresh_frequency = "{{ refresh_frequency }}"
          inspect_template_modified_cadence {
            frequency = "{{ frequency }}"
          }
          schema_modified_cadence {
            frequency = "{{ frequency }}"
            types = ["{{ types }}"]
          }
        }
      }
      cloud_storage_target {
        conditions {
          created_after = "{{ created_after }}"
          min_age = "{{ min_age }}"
          cloud_storage_conditions {
            included_bucket_attributes = ["{{ included_bucket_attributes }}"]
            included_object_attributes = ["{{ included_object_attributes }}"]
          }
        }
        disabled {
        }
        filter {
          cloud_storage_resource_reference {
            bucket_name = "{{ bucket_name }}"
            project_id = "{{ project_id }}"
          }
          collection {
            include_regexes {
              patterns {
                cloud_storage_regex {
                  bucket_name_regex = "{{ bucket_name_regex }}"
                  project_id_regex = "{{ project_id_regex }}"
                }
              }
            }
            include_tags {
              tag_filters {
                namespaced_tag_key = "{{ namespaced_tag_key }}"
                namespaced_tag_value = "{{ namespaced_tag_value }}"
              }
            }
          }
          others {
          }
        }
        generation_cadence {
          refresh_frequency = "{{ refresh_frequency }}"
          inspect_template_modified_cadence {
            frequency = "{{ frequency }}"
          }
        }
      }
      other_cloud_target {
        conditions {
          min_age = "{{ min_age }}"
          amazon_s3_bucket_conditions {
            bucket_types = ["{{ bucket_types }}"]
            object_storage_classes = ["{{ object_storage_classes }}"]
          }
        }
        data_source_type {
          data_source = "{{ data_source }}"
        }
        disabled {
        }
        filter {
          collection {
            include_regexes {
              patterns {
                amazon_s3_bucket_regex {
                  bucket_name_regex = "{{ bucket_name_regex }}"
                  aws_account_regex {
                    account_id_regex = "{{ account_id_regex }}"
                  }
                }
              }
            }
          }
          others {
          }
          single_resource {
            amazon_s3_bucket {
              bucket_name = "{{ bucket_name }}"
              aws_account {
                account_id = "{{ account_id }}"
              }
            }
          }
        }
        generation_cadence {
          refresh_frequency = "{{ refresh_frequency }}"
          inspect_template_modified_cadence {
            frequency = "{{ frequency }}"
          }
        }
      }
      secrets_target {
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
