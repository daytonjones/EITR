resource "google_biglake_database" "example" {
    catalog = "{{ catalog }}"
    id = "{{ id }}"
    name = "{{ name }}"
    type = "{{ type }}"
    hive_options {
      location_uri = "{{ location_uri }}"
      parameters = {
        key = "{{ parameters_value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
