resource "google_network_services_multicast_domain" "example" {
    admin_network = "{{ admin_network }}"
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    multicast_domain_group = "{{ multicast_domain_group }}"
    multicast_domain_id = "{{ multicast_domain_id }}"
    project = "{{ project }}"
    connection_config {
      connection_type = "{{ connection_type }}"
      ncc_hub = "{{ ncc_hub }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    ull_multicast_domain {
      preconfigured_ull_domain = "{{ preconfigured_ull_domain }}"
    }
}
