resource "google_migration_center_group" "example" {
    description = "{{ description }}"
    display_name = "{{ display_name }}"
    group_id = "{{ group_id }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
