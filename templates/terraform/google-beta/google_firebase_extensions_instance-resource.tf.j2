resource "google_firebase_extensions_instance" "example" {
    id = "{{ id }}"
    instance_id = "{{ instance_id }}"
    project = "{{ project }}"
    config {
      allowed_event_types = ["{{ allowed_event_types }}"]
      eventarc_channel = "{{ eventarc_channel }}"
      extension_ref = "{{ extension_ref }}"
      extension_version = "{{ extension_version }}"
      params = {
        key = "{{ params_value }}"
      }
      system_params = {
        key = "{{ system_params_value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
