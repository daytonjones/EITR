resource "google_org_policy_custom_constraint" "example" {
    action_type = "{{ action_type }}"
    condition = "{{ condition }}"
    description = "{{ description }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    method_types = ["{{ method_types }}"]
    name = "{{ name }}"
    parent = "{{ parent }}"
    resource_types = ["{{ resource_types }}"]
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
