resource "google_firebase_app_check_device_check_config" "example" {
    app_id = "{{ app_id }}"
    id = "{{ id }}"
    key_id = "{{ key_id }}"
    private_key = "{{ private_key }}"
    project = "{{ project }}"
    token_ttl = "{{ token_ttl }}"
