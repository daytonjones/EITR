resource "google_certificate_manager_certificate_map_entry" "example" {
    certificates = ["{{ certificates }}"]
    description = "{{ description }}"
    hostname = "{{ hostname }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    map = "{{ map }}"
    matcher = "{{ matcher }}"
    name = "{{ name }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
