resource "google_firebase_app_check_recaptcha_enterprise_config" "example" {
    app_id = "{{ app_id }}"
    id = "{{ id }}"
    project = "{{ project }}"
    site_key = "{{ site_key }}"
    token_ttl = "{{ token_ttl }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
