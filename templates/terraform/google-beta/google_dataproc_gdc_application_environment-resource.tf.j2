resource "google_dataproc_gdc_application_environment" "example" {
    annotations = {
        key = "{{ annotations_value }}"
      }
    application_environment_id = "{{ application_environment_id }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    namespace = "{{ namespace }}"
    project = "{{ project }}"
    serviceinstance = "{{ serviceinstance }}"
    spark_application_environment_config {
      default_properties = {
        key = "{{ default_properties_value }}"
      }
      default_version = "{{ default_version }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
