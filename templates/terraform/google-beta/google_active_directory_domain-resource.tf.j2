resource "google_active_directory_domain" "example" {
    admin = "{{ admin }}"
    authorized_networks = ["{{ authorized_networks }}"]
    deletion_protection = {{ deletion_protection }}
    domain_name = "{{ domain_name }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    locations = ["{{ locations }}"]
    project = "{{ project }}"
    reserved_ip_range = "{{ reserved_ip_range }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
