resource "google_vertex_ai_feature_group_feature" "example" {
    description = "{{ description }}"
    feature_group = "{{ feature_group }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    project = "{{ project }}"
    region = "{{ region }}"
    version_column_name = "{{ version_column_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
