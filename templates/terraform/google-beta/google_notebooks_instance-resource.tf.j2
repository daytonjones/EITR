resource "google_notebooks_instance" "example" {
    boot_disk_size_gb = {{ boot_disk_size_gb }}
    boot_disk_type = "{{ boot_disk_type }}"
    create_time = "{{ create_time }}"
    custom_gpu_driver_path = "{{ custom_gpu_driver_path }}"
    data_disk_size_gb = {{ data_disk_size_gb }}
    data_disk_type = "{{ data_disk_type }}"
    desired_state = "{{ desired_state }}"
    disk_encryption = "{{ disk_encryption }}"
    id = "{{ id }}"
    install_gpu_driver = {{ install_gpu_driver }}
    instance_owners = ["{{ instance_owners }}"]
    kms_key = "{{ kms_key }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    machine_type = "{{ machine_type }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    name = "{{ name }}"
    network = "{{ network }}"
    nic_type = "{{ nic_type }}"
    no_proxy_access = {{ no_proxy_access }}
    no_public_ip = {{ no_public_ip }}
    no_remove_data_disk = {{ no_remove_data_disk }}
    post_startup_script = "{{ post_startup_script }}"
    project = "{{ project }}"
    service_account = "{{ service_account }}"
    service_account_scopes = ["{{ service_account_scopes }}"]
    subnet = "{{ subnet }}"
    tags = ["{{ tags }}"]
    update_time = "{{ update_time }}"
    accelerator_config {
      core_count = {{ core_count }}
      type = "{{ type }}"
    }
    container_image {
      repository = "{{ repository }}"
      tag = "{{ tag }}"
    }
    reservation_affinity {
      consume_reservation_type = "{{ consume_reservation_type }}"
      key = "{{ key }}"
      values = ["{{ values }}"]
    }
    shielded_instance_config {
      enable_integrity_monitoring = {{ enable_integrity_monitoring }}
      enable_secure_boot = {{ enable_secure_boot }}
      enable_vtpm = {{ enable_vtpm }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    vm_image {
      image_family = "{{ image_family }}"
      image_name = "{{ image_name }}"
      project = "{{ project }}"
    }
}
