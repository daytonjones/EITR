resource "google_access_context_manager_access_levels" "example" {
    id = "{{ id }}"
    parent = "{{ parent }}"
    access_levels {
      description = "{{ description }}"
      name = "{{ name }}"
      title = "{{ title }}"
      basic {
        combining_function = "{{ combining_function }}"
        conditions {
          ip_subnetworks = ["{{ ip_subnetworks }}"]
          members = ["{{ members }}"]
          negate = {{ negate }}
          regions = ["{{ regions }}"]
          required_access_levels = ["{{ required_access_levels }}"]
          device_policy {
            allowed_device_management_levels = ["{{ allowed_device_management_levels }}"]
            allowed_encryption_statuses = ["{{ allowed_encryption_statuses }}"]
            require_admin_approval = {{ require_admin_approval }}
            require_corp_owned = {{ require_corp_owned }}
            require_screen_lock = {{ require_screen_lock }}
            os_constraints {
              minimum_version = "{{ minimum_version }}"
              os_type = "{{ os_type }}"
            }
          }
          vpc_network_sources {
            vpc_subnetwork {
              network = "{{ network }}"
              vpc_ip_subnetworks = ["{{ vpc_ip_subnetworks }}"]
            }
          }
        }
      }
      custom {
        expr {
          description = "{{ description }}"
          expression = "{{ expression }}"
          location = "{{ location }}"
          title = "{{ title }}"
        }
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
