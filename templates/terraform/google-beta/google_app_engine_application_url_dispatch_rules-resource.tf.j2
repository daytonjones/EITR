resource "google_app_engine_application_url_dispatch_rules" "example" {
    id = "{{ id }}"
    project = "{{ project }}"
    dispatch_rules {
      domain = "{{ domain }}"
      path = "{{ path }}"
      service = "{{ service }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
