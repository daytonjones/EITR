resource "google_compute_instant_snapshot" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    project = "{{ project }}"
    source_disk = "{{ source_disk }}"
    zone = "{{ zone }}"
    params {
      resource_manager_tags = {
        key = "{{ resource_manager_tags_value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
