resource "google_bigquery_table_iam_binding" "example" {
    dataset_id = "{{ dataset_id }}"
    id = "{{ id }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    table_id = "{{ table_id }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
