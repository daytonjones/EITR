resource "google_cloudbuild_bitbucket_server_config" "example" {
    api_key = "{{ api_key }}"
    config_id = "{{ config_id }}"
    host_uri = "{{ host_uri }}"
    id = "{{ id }}"
    location = "{{ location }}"
    peered_network = "{{ peered_network }}"
    project = "{{ project }}"
    ssl_ca = "{{ ssl_ca }}"
    username = "{{ username }}"
    connected_repositories {
      project_key = "{{ project_key }}"
      repo_slug = "{{ repo_slug }}"
    }
    secrets {
      admin_access_token_version_name = "{{ admin_access_token_version_name }}"
      read_access_token_version_name = "{{ read_access_token_version_name }}"
      webhook_secret_version_name = "{{ webhook_secret_version_name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
