resource "google_service_usage_consumer_quota_override" "example" {
    dimensions = {
        key = "{{ dimensions_value }}"
      }
    force = {{ force }}
    id = "{{ id }}"
    limit = "{{ limit }}"
    metric = "{{ metric }}"
    override_value = "{{ override_value }}"
    project = "{{ project }}"
    service = "{{ service }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
