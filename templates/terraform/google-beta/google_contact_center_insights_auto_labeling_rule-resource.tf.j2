resource "google_contact_center_insights_auto_labeling_rule" "example" {
    active = {{ active }}
    auto_labeling_rule_id = "{{ auto_labeling_rule_id }}"
    description = "{{ description }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    label_key = "{{ label_key }}"
    label_key_type = "{{ label_key_type }}"
    location = "{{ location }}"
    project = "{{ project }}"
    conditions {
      condition = "{{ condition }}"
      value = "{{ value }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
