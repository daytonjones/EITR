resource "google_access_context_manager_authorized_orgs_desc" "example" {
    asset_type = "{{ asset_type }}"
    authorization_direction = "{{ authorization_direction }}"
    authorization_type = "{{ authorization_type }}"
    id = "{{ id }}"
    name = "{{ name }}"
    orgs = ["{{ orgs }}"]
    parent = "{{ parent }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
