data "google_storage_object_signed_url" "example" {
    bucket = "{{ bucket }}"
    content_md5 = "{{ content_md5 }}"
    content_type = "{{ content_type }}"
    credentials = "{{ credentials }}"
    duration = "{{ duration }}"
    extension_headers = {
        key = "{{ extension_headers_value }}"
      }
    http_method = "{{ http_method }}"
    id = "{{ id }}"
    path = "{{ path }}"
}
