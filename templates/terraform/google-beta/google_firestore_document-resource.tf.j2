resource "google_firestore_document" "example" {
    collection = "{{ collection }}"
    database = "{{ database }}"
    document_id = "{{ document_id }}"
    fields = "{{ fields }}"
    id = "{{ id }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
