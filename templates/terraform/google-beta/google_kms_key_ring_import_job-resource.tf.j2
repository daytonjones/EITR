resource "google_kms_key_ring_import_job" "example" {
    id = "{{ id }}"
    import_job_id = "{{ import_job_id }}"
    import_method = "{{ import_method }}"
    key_ring = "{{ key_ring }}"
    protection_level = "{{ protection_level }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
