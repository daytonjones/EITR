resource "google_compute_disk" "example" {
    access_mode = "{{ access_mode }}"
    architecture = "{{ architecture }}"
    create_snapshot_before_destroy = {{ create_snapshot_before_destroy }}
    create_snapshot_before_destroy_prefix = "{{ create_snapshot_before_destroy_prefix }}"
    description = "{{ description }}"
    enable_confidential_compute = {{ enable_confidential_compute }}
    erase_windows_vss_signature = {{ erase_windows_vss_signature }}
    id = "{{ id }}"
    image = "{{ image }}"
    interface = "{{ interface }}"
    labels = {
        key = "{{ labels_value }}"
      }
    licenses = ["{{ licenses }}"]
    multi_writer = {{ multi_writer }}
    name = "{{ name }}"
    physical_block_size_bytes = {{ physical_block_size_bytes }}
    project = "{{ project }}"
    provisioned_iops = {{ provisioned_iops }}
    provisioned_throughput = {{ provisioned_throughput }}
    resource_policies = ["{{ resource_policies }}"]
    size = {{ size }}
    snapshot = "{{ snapshot }}"
    source_disk = "{{ source_disk }}"
    source_instant_snapshot = "{{ source_instant_snapshot }}"
    source_storage_object = "{{ source_storage_object }}"
    storage_pool = "{{ storage_pool }}"
    type = "{{ type }}"
    zone = "{{ zone }}"
    async_primary_disk {
      disk = "{{ disk }}"
    }
    disk_encryption_key {
      kms_key_self_link = "{{ kms_key_self_link }}"
      kms_key_service_account = "{{ kms_key_service_account }}"
      raw_key = "{{ raw_key }}"
      rsa_encrypted_key = "{{ rsa_encrypted_key }}"
    }
    guest_os_features {
      type = "{{ type }}"
    }
    params {
      resource_manager_tags = {
        key = "{{ resource_manager_tags_value }}"
      }
    }
    source_image_encryption_key {
      kms_key_self_link = "{{ kms_key_self_link }}"
      kms_key_service_account = "{{ kms_key_service_account }}"
      raw_key = "{{ raw_key }}"
    }
    source_snapshot_encryption_key {
      kms_key_self_link = "{{ kms_key_self_link }}"
      kms_key_service_account = "{{ kms_key_service_account }}"
      raw_key = "{{ raw_key }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
