resource "google_api_gateway_gateway" "example" {
    api_config = "{{ api_config }}"
    display_name = "{{ display_name }}"
    gateway_id = "{{ gateway_id }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    project = "{{ project }}"
    region = "{{ region }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
