resource "google_cloud_ids_endpoint" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    network = "{{ network }}"
    project = "{{ project }}"
    severity = "{{ severity }}"
    threat_exceptions = ["{{ threat_exceptions }}"]
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
