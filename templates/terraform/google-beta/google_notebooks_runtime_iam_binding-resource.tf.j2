resource "google_notebooks_runtime_iam_binding" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    runtime_name = "{{ runtime_name }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
