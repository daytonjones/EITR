resource "google_data_catalog_taxonomy_iam_binding" "example" {
    id = "{{ id }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    region = "{{ region }}"
    role = "{{ role }}"
    taxonomy = "{{ taxonomy }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
