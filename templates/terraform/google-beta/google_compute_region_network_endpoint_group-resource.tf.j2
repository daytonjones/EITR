resource "google_compute_region_network_endpoint_group" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    network = "{{ network }}"
    network_endpoint_type = "{{ network_endpoint_type }}"
    project = "{{ project }}"
    psc_target_service = "{{ psc_target_service }}"
    region = "{{ region }}"
    subnetwork = "{{ subnetwork }}"
    app_engine {
      service = "{{ service }}"
      url_mask = "{{ url_mask }}"
      version = "{{ version }}"
    }
    cloud_function {
      function = "{{ function }}"
      url_mask = "{{ url_mask }}"
    }
    cloud_run {
      service = "{{ service }}"
      tag = "{{ tag }}"
      url_mask = "{{ url_mask }}"
    }
    psc_data {
      producer_port = "{{ producer_port }}"
    }
    serverless_deployment {
      platform = "{{ platform }}"
      resource = "{{ resource }}"
      url_mask = "{{ url_mask }}"
      version = "{{ version }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
