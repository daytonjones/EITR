resource "google_gke_hub_rollout_sequence" "example" {
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    project = "{{ project }}"
    rollout_sequence_id = "{{ rollout_sequence_id }}"
    ignored_clusters_selector {
      label_selector = "{{ label_selector }}"
    }
    stages {
      fleet_projects = ["{{ fleet_projects }}"]
      soak_duration = "{{ soak_duration }}"
      cluster_selector {
        label_selector = "{{ label_selector }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
