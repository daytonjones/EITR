resource "google_cloud_identity_group_membership" "example" {
    create_ignore_already_exists = {{ create_ignore_already_exists }}
    group = "{{ group }}"
    id = "{{ id }}"
    member_key {
      id = "{{ id }}"
      namespace = "{{ namespace }}"
    }
    preferred_member_key {
      id = "{{ id }}"
      namespace = "{{ namespace }}"
    }
    roles {
      name = "{{ name }}"
      expiry_detail {
        expire_time = "{{ expire_time }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
