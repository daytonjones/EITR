resource "google_endpoints_service" "example" {
    grpc_config = "{{ grpc_config }}"
    id = "{{ id }}"
    openapi_config = "{{ openapi_config }}"
    project = "{{ project }}"
    protoc_output_base64 = "{{ protoc_output_base64 }}"
    service_name = "{{ service_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
