resource "google_iap_tunnel_instance_iam_binding" "example" {
    id = "{{ id }}"
    instance = "{{ instance }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    zone = "{{ zone }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
