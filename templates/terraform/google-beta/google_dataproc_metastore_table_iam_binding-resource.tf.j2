resource "google_dataproc_metastore_table_iam_binding" "example" {
    database_id = "{{ database_id }}"
    id = "{{ id }}"
    location = "{{ location }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    service_id = "{{ service_id }}"
    table = "{{ table }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
