resource "google_active_directory_peering" "example" {
    authorized_network = "{{ authorized_network }}"
    domain_resource = "{{ domain_resource }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    peering_id = "{{ peering_id }}"
    project = "{{ project }}"
    status = "{{ status }}"
    status_message = "{{ status_message }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
