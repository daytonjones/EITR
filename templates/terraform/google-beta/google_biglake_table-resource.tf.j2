resource "google_biglake_table" "example" {
    database = "{{ database }}"
    id = "{{ id }}"
    name = "{{ name }}"
    type = "{{ type }}"
    hive_options {
      parameters = {
        key = "{{ parameters_value }}"
      }
      table_type = "{{ table_type }}"
      storage_descriptor {
        input_format = "{{ input_format }}"
        location_uri = "{{ location_uri }}"
        output_format = "{{ output_format }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
