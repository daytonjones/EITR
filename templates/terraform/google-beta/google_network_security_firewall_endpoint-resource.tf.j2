resource "google_network_security_firewall_endpoint" "example" {
    billing_project_id = "{{ billing_project_id }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    parent = "{{ parent }}"
    endpoint_settings {
      jumbo_frames_enabled = {{ jumbo_frames_enabled }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
