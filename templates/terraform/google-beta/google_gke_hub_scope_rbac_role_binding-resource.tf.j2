resource "google_gke_hub_scope_rbac_role_binding" "example" {
    group = "{{ group }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    project = "{{ project }}"
    scope_id = "{{ scope_id }}"
    scope_rbac_role_binding_id = "{{ scope_rbac_role_binding_id }}"
    user = "{{ user }}"
    role {
      custom_role = "{{ custom_role }}"
      predefined_role = "{{ predefined_role }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
