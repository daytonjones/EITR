resource "google_network_security_intercept_deployment_group" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    intercept_deployment_group_id = "{{ intercept_deployment_group_id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    network = "{{ network }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
