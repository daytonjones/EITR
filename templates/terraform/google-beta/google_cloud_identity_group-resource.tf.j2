resource "google_cloud_identity_group" "example" {
    description = "{{ description }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    initial_group_config = "{{ initial_group_config }}"
    labels = {
        key = "{{ labels_value }}"
      }
    parent = "{{ parent }}"
    group_key {
      id = "{{ id }}"
      namespace = "{{ namespace }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
