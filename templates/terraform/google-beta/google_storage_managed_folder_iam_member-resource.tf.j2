resource "google_storage_managed_folder_iam_member" "example" {
    bucket = "{{ bucket }}"
    id = "{{ id }}"
    managed_folder = "{{ managed_folder }}"
    member = "{{ member }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
