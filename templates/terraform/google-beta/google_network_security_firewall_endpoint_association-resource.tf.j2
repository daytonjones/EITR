resource "google_network_security_firewall_endpoint_association" "example" {
    disabled = {{ disabled }}
    firewall_endpoint = "{{ firewall_endpoint }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    network = "{{ network }}"
    parent = "{{ parent }}"
    tls_inspection_policy = "{{ tls_inspection_policy }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
