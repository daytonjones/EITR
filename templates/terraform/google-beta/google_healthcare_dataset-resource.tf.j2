resource "google_healthcare_dataset" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    time_zone = "{{ time_zone }}"
    encryption_spec {
      kms_key_name = "{{ kms_key_name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
