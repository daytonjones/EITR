resource "google_firebase_app_hosting_default_domain" "example" {
    backend = "{{ backend }}"
    disabled = {{ disabled }}
    domain_id = "{{ domain_id }}"
    id = "{{ id }}"
    location = "{{ location }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
