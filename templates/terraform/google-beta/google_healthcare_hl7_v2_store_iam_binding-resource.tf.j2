resource "google_healthcare_hl7_v2_store_iam_binding" "example" {
    hl7_v2_store_id = "{{ hl7_v2_store_id }}"
    id = "{{ id }}"
    members = ["{{ members }}"]
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
