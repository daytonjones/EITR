resource "google_netapp_backup_policy" "example" {
    daily_backup_limit = {{ daily_backup_limit }}
    description = "{{ description }}"
    enabled = {{ enabled }}
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    monthly_backup_limit = {{ monthly_backup_limit }}
    name = "{{ name }}"
    project = "{{ project }}"
    weekly_backup_limit = {{ weekly_backup_limit }}
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
