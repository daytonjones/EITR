resource "google_dns_response_policy_rule" "example" {
    behavior = "{{ behavior }}"
    dns_name = "{{ dns_name }}"
    id = "{{ id }}"
    project = "{{ project }}"
    response_policy = "{{ response_policy }}"
    rule_name = "{{ rule_name }}"
    local_data {
      local_datas {
        name = "{{ name }}"
        rrdatas = ["{{ rrdatas }}"]
        ttl = {{ ttl }}
        type = "{{ type }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
