resource "google_oracle_database_db_system" "example" {
    db_system_id = "{{ db_system_id }}"
    deletion_protection = {{ deletion_protection }}
    display_name = "{{ display_name }}"
    gcp_oracle_zone = "{{ gcp_oracle_zone }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    odb_network = "{{ odb_network }}"
    odb_subnet = "{{ odb_subnet }}"
    project = "{{ project }}"
    properties {
      compute_count = {{ compute_count }}
      compute_model = "{{ compute_model }}"
      data_storage_size_gb = {{ data_storage_size_gb }}
      database_edition = "{{ database_edition }}"
      domain = "{{ domain }}"
      hostname_prefix = "{{ hostname_prefix }}"
      initial_data_storage_size_gb = {{ initial_data_storage_size_gb }}
      license_model = "{{ license_model }}"
      memory_size_gb = {{ memory_size_gb }}
      node_count = {{ node_count }}
      private_ip = "{{ private_ip }}"
      reco_storage_size_gb = {{ reco_storage_size_gb }}
      shape = "{{ shape }}"
      ssh_public_keys = ["{{ ssh_public_keys }}"]
      data_collection_options {
        is_diagnostics_events_enabled = {{ is_diagnostics_events_enabled }}
        is_incident_logs_enabled = {{ is_incident_logs_enabled }}
      }
      db_home {
        db_version = "{{ db_version }}"
        display_name = "{{ display_name }}"
        is_unified_auditing_enabled = {{ is_unified_auditing_enabled }}
        database {
          admin_password = "{{ admin_password }}"
          character_set = "{{ character_set }}"
          database_id = "{{ database_id }}"
          db_home_name = "{{ db_home_name }}"
          db_name = "{{ db_name }}"
          db_unique_name = "{{ db_unique_name }}"
          gcp_oracle_zone = "{{ gcp_oracle_zone }}"
          ncharacter_set = "{{ ncharacter_set }}"
          tde_wallet_password = "{{ tde_wallet_password }}"
          properties {
            db_version = "{{ db_version }}"
            database_management_config {
            }
            db_backup_config {
              auto_backup_enabled = {{ auto_backup_enabled }}
              auto_full_backup_day = "{{ auto_full_backup_day }}"
              auto_full_backup_window = "{{ auto_full_backup_window }}"
              auto_incremental_backup_window = "{{ auto_incremental_backup_window }}"
              backup_deletion_policy = "{{ backup_deletion_policy }}"
              retention_period_days = {{ retention_period_days }}
              backup_destination_details {
                type = "{{ type }}"
              }
            }
          }
        }
      }
      db_system_options {
        storage_management = "{{ storage_management }}"
      }
      time_zone {
        id = "{{ id }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
