resource "google_vertex_ai_feature_online_store_iam_binding" "example" {
    feature_online_store = "{{ feature_online_store }}"
    id = "{{ id }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    region = "{{ region }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
