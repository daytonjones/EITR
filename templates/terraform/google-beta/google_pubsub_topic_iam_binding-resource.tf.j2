resource "google_pubsub_topic_iam_binding" "example" {
    id = "{{ id }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    topic = "{{ topic }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
