resource "google_bigtable_instance_iam_binding" "example" {
    id = "{{ id }}"
    instance = "{{ instance }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
