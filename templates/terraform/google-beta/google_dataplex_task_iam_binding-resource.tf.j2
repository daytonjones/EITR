resource "google_dataplex_task_iam_binding" "example" {
    id = "{{ id }}"
    lake = "{{ lake }}"
    location = "{{ location }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    task_id = "{{ task_id }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
