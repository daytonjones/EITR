resource "google_network_security_mirroring_endpoint_group_association" "example" {
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    mirroring_endpoint_group = "{{ mirroring_endpoint_group }}"
    mirroring_endpoint_group_association_id = "{{ mirroring_endpoint_group_association_id }}"
    network = "{{ network }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
