resource "google_compute_target_instance" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    instance = "{{ instance }}"
    name = "{{ name }}"
    nat_policy = "{{ nat_policy }}"
    network = "{{ network }}"
    project = "{{ project }}"
    security_policy = "{{ security_policy }}"
    zone = "{{ zone }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
