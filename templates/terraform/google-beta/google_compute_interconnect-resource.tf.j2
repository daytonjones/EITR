resource "google_compute_interconnect" "example" {
    aai_enabled = {{ aai_enabled }}
    admin_enabled = {{ admin_enabled }}
    customer_name = "{{ customer_name }}"
    description = "{{ description }}"
    id = "{{ id }}"
    interconnect_type = "{{ interconnect_type }}"
    labels = {
        key = "{{ labels_value }}"
      }
    link_type = "{{ link_type }}"
    location = "{{ location }}"
    macsec_enabled = {{ macsec_enabled }}
    name = "{{ name }}"
    noc_contact_email = "{{ noc_contact_email }}"
    project = "{{ project }}"
    remote_location = "{{ remote_location }}"
    requested_features = ["{{ requested_features }}"]
    requested_link_count = {{ requested_link_count }}
    application_aware_interconnect {
      profile_description = "{{ profile_description }}"
      bandwidth_percentage_policy {
        bandwidth_percentage {
          percentage = {{ percentage }}
          traffic_class = "{{ traffic_class }}"
        }
      }
      shape_average_percentage {
        percentage = {{ percentage }}
        traffic_class = "{{ traffic_class }}"
      }
      strict_priority_policy {
      }
    }
    macsec {
      fail_open = {{ fail_open }}
      pre_shared_keys {
        fail_open = {{ fail_open }}
        name = "{{ name }}"
        start_time = "{{ start_time }}"
      }
    }
    params {
      resource_manager_tags = {
        key = "{{ resource_manager_tags_value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
