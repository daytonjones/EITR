resource "google_dataproc_gdc_service_instance" "example" {
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    project = "{{ project }}"
    service_account = "{{ service_account }}"
    service_instance_id = "{{ service_instance_id }}"
    gdce_cluster {
      gdce_cluster = "{{ gdce_cluster }}"
    }
    spark_service_instance_config {
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
