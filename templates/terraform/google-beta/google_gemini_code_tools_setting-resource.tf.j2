resource "google_gemini_code_tools_setting" "example" {
    code_tools_setting_id = "{{ code_tools_setting_id }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    project = "{{ project }}"
    enabled_tool {
      account_connector = "{{ account_connector }}"
      handle = "{{ handle }}"
      tool = "{{ tool }}"
      uri_override = "{{ uri_override }}"
      config {
        key = "{{ key }}"
        value = "{{ value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
