resource "google_api_gateway_api_config_iam_binding" "example" {
    api = "{{ api }}"
    api_config = "{{ api_config }}"
    id = "{{ id }}"
    members = ["{{ members }}"]
    project = "{{ project }}"
    role = "{{ role }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
