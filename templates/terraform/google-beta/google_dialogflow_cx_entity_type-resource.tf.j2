resource "google_dialogflow_cx_entity_type" "example" {
    auto_expansion_mode = "{{ auto_expansion_mode }}"
    display_name = "{{ display_name }}"
    enable_fuzzy_extraction = {{ enable_fuzzy_extraction }}
    id = "{{ id }}"
    kind = "{{ kind }}"
    language_code = "{{ language_code }}"
    parent = "{{ parent }}"
    redact = {{ redact }}
    entities {
      synonyms = ["{{ synonyms }}"]
      value = "{{ value }}"
    }
    excluded_phrases {
      value = "{{ value }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
