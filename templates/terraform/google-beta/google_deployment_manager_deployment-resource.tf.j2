resource "google_deployment_manager_deployment" "example" {
    create_policy = "{{ create_policy }}"
    delete_policy = "{{ delete_policy }}"
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    preview = {{ preview }}
    project = "{{ project }}"
    labels {
      key = "{{ key }}"
      value = "{{ value }}"
    }
    target {
      config {
        content = "{{ content }}"
      }
      imports {
        content = "{{ content }}"
        name = "{{ name }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
