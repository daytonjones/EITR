resource "google_network_services_multicast_group_consumer_activation" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    multicast_consumer_association = "{{ multicast_consumer_association }}"
    multicast_group_consumer_activation_id = "{{ multicast_group_consumer_activation_id }}"
    multicast_group_range_activation = "{{ multicast_group_range_activation }}"
    project = "{{ project }}"
    log_config {
      enabled = {{ enabled }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
