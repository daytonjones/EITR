resource "google_service_networking_peered_dns_domain" "example" {
    dns_suffix = "{{ dns_suffix }}"
    id = "{{ id }}"
    name = "{{ name }}"
    network = "{{ network }}"
    project = "{{ project }}"
    service = "{{ service }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
    }
}
