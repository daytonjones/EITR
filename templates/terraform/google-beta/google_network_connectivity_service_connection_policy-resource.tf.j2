resource "google_network_connectivity_service_connection_policy" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    network = "{{ network }}"
    project = "{{ project }}"
    service_class = "{{ service_class }}"
    psc_config {
      allowed_google_producers_resource_hierarchy_level = ["{{ allowed_google_producers_resource_hierarchy_level }}"]
      limit = "{{ limit }}"
      producer_instance_location = "{{ producer_instance_location }}"
      subnetworks = ["{{ subnetworks }}"]
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
