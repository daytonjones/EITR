resource "google_discovery_engine_serving_config" "example" {
    boost_control_ids = ["{{ boost_control_ids }}"]
    collection_id = "{{ collection_id }}"
    engine_id = "{{ engine_id }}"
    filter_control_ids = ["{{ filter_control_ids }}"]
    id = "{{ id }}"
    location = "{{ location }}"
    project = "{{ project }}"
    promote_control_ids = ["{{ promote_control_ids }}"]
    redirect_control_ids = ["{{ redirect_control_ids }}"]
    serving_config_id = "{{ serving_config_id }}"
    synonyms_control_ids = ["{{ synonyms_control_ids }}"]
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
