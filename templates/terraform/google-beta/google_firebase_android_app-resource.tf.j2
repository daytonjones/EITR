resource "google_firebase_android_app" "example" {
    api_key_id = "{{ api_key_id }}"
    deletion_policy = "{{ deletion_policy }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    package_name = "{{ package_name }}"
    project = "{{ project }}"
    sha1_hashes = ["{{ sha1_hashes }}"]
    sha256_hashes = ["{{ sha256_hashes }}"]
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
