resource "google_secret_manager_regional_secret_version" "example" {
    deletion_policy = "{{ deletion_policy }}"
    enabled = {{ enabled }}
    id = "{{ id }}"
    is_secret_data_base64 = {{ is_secret_data_base64 }}
    secret = "{{ secret }}"
    secret_data = "{{ secret_data }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
