resource "google_ml_engine_model" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    online_prediction_console_logging = {{ online_prediction_console_logging }}
    online_prediction_logging = {{ online_prediction_logging }}
    project = "{{ project }}"
    regions = ["{{ regions }}"]
    default_version {
      name = "{{ name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
