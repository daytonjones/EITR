resource "google_pubsub_lite_subscription" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    project = "{{ project }}"
    region = "{{ region }}"
    topic = "{{ topic }}"
    zone = "{{ zone }}"
    delivery_config {
      delivery_requirement = "{{ delivery_requirement }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
