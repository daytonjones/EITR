resource "google_logging_organization_bucket_config" "example" {
    bucket_id = "{{ bucket_id }}"
    description = "{{ description }}"
    id = "{{ id }}"
    location = "{{ location }}"
    organization = "{{ organization }}"
    retention_days = {{ retention_days }}
    cmek_settings {
      kms_key_name = "{{ kms_key_name }}"
    }
    index_configs {
      field_path = "{{ field_path }}"
      type = "{{ type }}"
    }
}
