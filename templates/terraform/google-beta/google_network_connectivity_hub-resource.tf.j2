resource "google_network_connectivity_hub" "example" {
    description = "{{ description }}"
    export_psc = {{ export_psc }}
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    policy_mode = "{{ policy_mode }}"
    preset_topology = "{{ preset_topology }}"
    project = "{{ project }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
