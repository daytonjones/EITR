resource "google_network_security_authorization_policy" "example" {
    action = "{{ action }}"
    description = "{{ description }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    name = "{{ name }}"
    project = "{{ project }}"
    rules {
      destinations {
        hosts = ["{{ hosts }}"]
        methods = ["{{ methods }}"]
        ports = ["{{ ports }}"]
        http_header_match {
          header_name = "{{ header_name }}"
          regex_match = "{{ regex_match }}"
        }
      }
      sources {
        ip_blocks = ["{{ ip_blocks }}"]
        principals = ["{{ principals }}"]
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
