resource "google_iap_tunnel_dest_group" "example" {
    cidrs = ["{{ cidrs }}"]
    fqdns = ["{{ fqdns }}"]
    group_name = "{{ group_name }}"
    id = "{{ id }}"
    project = "{{ project }}"
    region = "{{ region }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
