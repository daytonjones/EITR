resource "google_network_security_ull_mirroring_collector" "example" {
    engine = "{{ engine }}"
    forwarding_rule = "{{ forwarding_rule }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    location = "{{ location }}"
    project = "{{ project }}"
    ull_mirroring_collector_id = "{{ ull_mirroring_collector_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
