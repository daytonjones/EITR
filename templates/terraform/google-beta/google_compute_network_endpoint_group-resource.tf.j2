resource "google_compute_network_endpoint_group" "example" {
    default_port = {{ default_port }}
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    network = "{{ network }}"
    network_endpoint_type = "{{ network_endpoint_type }}"
    project = "{{ project }}"
    subnetwork = "{{ subnetwork }}"
    zone = "{{ zone }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
