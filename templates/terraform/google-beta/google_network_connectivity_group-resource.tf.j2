resource "google_network_connectivity_group" "example" {
    description = "{{ description }}"
    hub = "{{ hub }}"
    id = "{{ id }}"
    labels = {
        key = "{{ labels_value }}"
      }
    name = "{{ name }}"
    project = "{{ project }}"
    auto_accept {
      auto_accept_projects = ["{{ auto_accept_projects }}"]
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
