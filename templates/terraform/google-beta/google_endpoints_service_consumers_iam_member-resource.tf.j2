resource "google_endpoints_service_consumers_iam_member" "example" {
    consumer_project = "{{ consumer_project }}"
    id = "{{ id }}"
    member = "{{ member }}"
    role = "{{ role }}"
    service_name = "{{ service_name }}"
    condition {
      description = "{{ description }}"
      expression = "{{ expression }}"
      title = "{{ title }}"
    }
}
