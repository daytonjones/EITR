resource "vsphere_content_library" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    storage_backing = ["{{ storage_backing }}"]
    publication {
      authentication_method = "{{ authentication_method }}"
      password = "{{ password }}"
      published = {{ published }}
      username = "{{ username }}"
    }
    subscription {
      authentication_method = "{{ authentication_method }}"
      automatic_sync = {{ automatic_sync }}
      on_demand = {{ on_demand }}
      password = "{{ password }}"
      subscription_url = "{{ subscription_url }}"
      username = "{{ username }}"
    }
}
