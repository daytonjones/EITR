resource "vsphere_entity_permissions" "example" {
    entity_id = "{{ entity_id }}"
    entity_type = "{{ entity_type }}"
    id = "{{ id }}"
    permissions {
      is_group = {{ is_group }}
      propagate = {{ propagate }}
      role_id = "{{ role_id }}"
      user_or_group = "{{ user_or_group }}"
    }
}
