resource "vsphere_host" "example" {
    cluster = "{{ cluster }}"
    cluster_managed = {{ cluster_managed }}
    connected = {{ connected }}
    custom_attributes = {
        key = "{{ custom_attributes_value }}"
      }
    datacenter = "{{ datacenter }}"
    force = {{ force }}
    hostname = "{{ hostname }}"
    id = "{{ id }}"
    license = "{{ license }}"
    lockdown = "{{ lockdown }}"
    maintenance = {{ maintenance }}
    password = "{{ password }}"
    tags = ["{{ tags }}"]
    thumbprint = "{{ thumbprint }}"
    username = "{{ username }}"
    services {
      ntpd {
        enabled = {{ enabled }}
        ntp_servers = ["{{ ntp_servers }}"]
        policy = "{{ policy }}"
      }
    }
}
