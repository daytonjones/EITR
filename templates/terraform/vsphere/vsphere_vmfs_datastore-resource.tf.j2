resource "vsphere_vmfs_datastore" "example" {
    custom_attributes = {
        key = "{{ custom_attributes_value }}"
      }
    datastore_cluster_id = "{{ datastore_cluster_id }}"
    disks = ["{{ disks }}"]
    folder = "{{ folder }}"
    host_system_id = "{{ host_system_id }}"
    id = "{{ id }}"
    name = "{{ name }}"
    tags = ["{{ tags }}"]
}
