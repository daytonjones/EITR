resource "azurestack_availability_set" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    managed = {{ managed }}
    name = "{{ name }}"
    platform_fault_domain_count = {{ platform_fault_domain_count }}
    platform_update_domain_count = {{ platform_update_domain_count }}
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
