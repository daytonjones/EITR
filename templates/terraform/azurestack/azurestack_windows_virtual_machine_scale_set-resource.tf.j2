resource "azurestack_windows_virtual_machine_scale_set" "example" {
    admin_password = "{{ admin_password }}"
    admin_username = "{{ admin_username }}"
    computer_name_prefix = "{{ computer_name_prefix }}"
    custom_data = "{{ custom_data }}"
    do_not_run_extensions_on_overprovisioned_machines = {{ do_not_run_extensions_on_overprovisioned_machines }}
    enable_automatic_updates = {{ enable_automatic_updates }}
    encryption_at_host_enabled = {{ encryption_at_host_enabled }}
    health_probe_id = "{{ health_probe_id }}"
    id = "{{ id }}"
    instances = {{ instances }}
    license_type = "{{ license_type }}"
    location = "{{ location }}"
    name = "{{ name }}"
    overprovision = {{ overprovision }}
    platform_fault_domain_count = {{ platform_fault_domain_count }}
    provision_vm_agent = {{ provision_vm_agent }}
    resource_group_name = "{{ resource_group_name }}"
    scale_in_policy = "{{ scale_in_policy }}"
    single_placement_group = {{ single_placement_group }}
    sku = "{{ sku }}"
    source_image_id = "{{ source_image_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timezone = "{{ timezone }}"
    upgrade_mode = "{{ upgrade_mode }}"
    additional_capabilities {
      ultra_ssd_enabled = {{ ultra_ssd_enabled }}
    }
    additional_unattend_content {
      content = "{{ content }}"
      setting = "{{ setting }}"
    }
    automatic_instance_repair {
      enabled = {{ enabled }}
      grace_period = "{{ grace_period }}"
    }
    automatic_os_upgrade_policy {
      disable_automatic_rollback = {{ disable_automatic_rollback }}
      enable_automatic_os_upgrade = {{ enable_automatic_os_upgrade }}
    }
    boot_diagnostics {
      storage_account_uri = "{{ storage_account_uri }}"
    }
    data_disk {
      caching = "{{ caching }}"
      create_option = "{{ create_option }}"
      disk_encryption_set_id = "{{ disk_encryption_set_id }}"
      disk_size_gb = {{ disk_size_gb }}
      lun = {{ lun }}
      storage_account_type = "{{ storage_account_type }}"
      write_accelerator_enabled = {{ write_accelerator_enabled }}
    }
    extension {
      auto_upgrade_minor_version = {{ auto_upgrade_minor_version }}
      automatic_upgrade_enabled = {{ automatic_upgrade_enabled }}
      force_update_tag = "{{ force_update_tag }}"
      name = "{{ name }}"
      protected_settings = "{{ protected_settings }}"
      provision_after_extensions = ["{{ provision_after_extensions }}"]
      publisher = "{{ publisher }}"
      settings = "{{ settings }}"
      type = "{{ type }}"
      type_handler_version = "{{ type_handler_version }}"
    }
    network_interface {
      dns_servers = ["{{ dns_servers }}"]
      enable_ip_forwarding = {{ enable_ip_forwarding }}
      name = "{{ name }}"
      network_security_group_id = "{{ network_security_group_id }}"
      primary = {{ primary }}
      ip_configuration {
        load_balancer_backend_address_pool_ids = ["{{ load_balancer_backend_address_pool_ids }}"]
        load_balancer_inbound_nat_rules_ids = ["{{ load_balancer_inbound_nat_rules_ids }}"]
        name = "{{ name }}"
        primary = {{ primary }}
        subnet_id = "{{ subnet_id }}"
        version = "{{ version }}"
      }
    }
    os_disk {
      caching = "{{ caching }}"
      disk_encryption_set_id = "{{ disk_encryption_set_id }}"
      disk_size_gb = {{ disk_size_gb }}
      storage_account_type = "{{ storage_account_type }}"
      write_accelerator_enabled = {{ write_accelerator_enabled }}
      diff_disk_settings {
        option = "{{ option }}"
      }
    }
    plan {
      name = "{{ name }}"
      product = "{{ product }}"
      publisher = "{{ publisher }}"
    }
    secret {
      key_vault_id = "{{ key_vault_id }}"
      certificate {
        store = "{{ store }}"
      }
    }
    source_image_reference {
      offer = "{{ offer }}"
      publisher = "{{ publisher }}"
      sku = "{{ sku }}"
      version = "{{ version }}"
    }
    terminate_notification {
      enabled = {{ enabled }}
      timeout = "{{ timeout }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
    winrm_listener {
      protocol = "{{ protocol }}"
    }
}
