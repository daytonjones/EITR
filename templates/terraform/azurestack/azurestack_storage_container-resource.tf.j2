resource "azurestack_storage_container" "example" {
    container_access_type = "{{ container_access_type }}"
    id = "{{ id }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    name = "{{ name }}"
    storage_account_name = "{{ storage_account_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
