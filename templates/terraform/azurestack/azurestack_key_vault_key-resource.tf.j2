resource "azurestack_key_vault_key" "example" {
    curve = "{{ curve }}"
    expiration_date = "{{ expiration_date }}"
    id = "{{ id }}"
    key_opts = ["{{ key_opts }}"]
    key_size = {{ key_size }}
    key_type = "{{ key_type }}"
    key_vault_id = "{{ key_vault_id }}"
    name = "{{ name }}"
    not_before_date = "{{ not_before_date }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
