resource "azurestack_template_deployment" "example" {
    deployment_mode = "{{ deployment_mode }}"
    id = "{{ id }}"
    name = "{{ name }}"
    parameters = {
        key = "{{ parameters_value }}"
      }
    parameters_body = "{{ parameters_body }}"
    resource_group_name = "{{ resource_group_name }}"
    template_body = "{{ template_body }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
