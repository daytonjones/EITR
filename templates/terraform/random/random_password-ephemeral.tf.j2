ephemeral "random_password" "example" {
    length = {{ length }}
    lower = {{ lower }}
    min_lower = {{ min_lower }}
    min_numeric = {{ min_numeric }}
    min_special = {{ min_special }}
    min_upper = {{ min_upper }}
    numeric = {{ numeric }}
    override_special = "{{ override_special }}"
    special = {{ special }}
    upper = {{ upper }}
}
