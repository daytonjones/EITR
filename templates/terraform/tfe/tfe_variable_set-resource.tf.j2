resource "tfe_variable_set" "example" {
    description = "{{ description }}"
    global = {{ global }}
    id = "{{ id }}"
    name = "{{ name }}"
    organization = "{{ organization }}"
    parent_project_id = "{{ parent_project_id }}"
    priority = {{ priority }}
    stack_ids = ["{{ stack_ids }}"]
    workspace_ids = ["{{ workspace_ids }}"]
}
