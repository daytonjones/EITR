data "tfe_workspace_ids" "example" {
    exclude_tags = ["{{ exclude_tags }}"]
    id = "{{ id }}"
    names = ["{{ names }}"]
    organization = "{{ organization }}"
    tag_names = ["{{ tag_names }}"]
    tag_filters {
      exclude = {
        key = "{{ exclude_value }}"
      }
      include = {
        key = "{{ include_value }}"
      }
    }
}
