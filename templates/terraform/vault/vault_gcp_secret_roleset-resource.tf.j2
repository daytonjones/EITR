resource "vault_gcp_secret_roleset" "example" {
    backend = "{{ backend }}"
    id = "{{ id }}"
    namespace = "{{ namespace }}"
    project = "{{ project }}"
    roleset = "{{ roleset }}"
    secret_type = "{{ secret_type }}"
    token_scopes = ["{{ token_scopes }}"]
    binding {
      resource = "{{ resource }}"
      roles = ["{{ roles }}"]
    }
}
