data "vault_ssh_secret_backend_sign" "example" {
    cert_type = "{{ cert_type }}"
    critical_options = {
        key = "{{ critical_options_value }}"
      }
    extensions = {
        key = "{{ extensions_value }}"
      }
    id = "{{ id }}"
    key_id = "{{ key_id }}"
    name = "{{ name }}"
    namespace = "{{ namespace }}"
    path = "{{ path }}"
    public_key = "{{ public_key }}"
    ttl = "{{ ttl }}"
    valid_principals = "{{ valid_principals }}"
}
