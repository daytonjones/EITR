resource "vault_rabbitmq_secret_backend_role" "example" {
    backend = "{{ backend }}"
    id = "{{ id }}"
    name = "{{ name }}"
    namespace = "{{ namespace }}"
    tags = "{{ tags }}"
    vhost {
      configure = "{{ configure }}"
      host = "{{ host }}"
      read = "{{ read }}"
      write = "{{ write }}"
    }
    vhost_topic {
      host = "{{ host }}"
      vhost {
        read = "{{ read }}"
        topic = "{{ topic }}"
        write = "{{ write }}"
      }
    }
}
