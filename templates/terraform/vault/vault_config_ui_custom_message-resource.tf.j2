resource "vault_config_ui_custom_message" "example" {
    authenticated = {{ authenticated }}
    end_time = "{{ end_time }}"
    message_base64 = "{{ message_base64 }}"
    namespace = "{{ namespace }}"
    options = {
        key = "{{ options_value }}"
      }
    start_time = "{{ start_time }}"
    title = "{{ title }}"
    type = "{{ type }}"
    link {
      href = "{{ href }}"
      title = "{{ title }}"
    }
}
