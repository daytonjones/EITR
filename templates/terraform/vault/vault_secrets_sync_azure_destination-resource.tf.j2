resource "vault_secrets_sync_azure_destination" "example" {
    allowed_ipv4_addresses = ["{{ allowed_ipv4_addresses }}"]
    allowed_ipv6_addresses = ["{{ allowed_ipv6_addresses }}"]
    allowed_ports = ["{{ allowed_ports }}"]
    client_id = "{{ client_id }}"
    client_secret = "{{ client_secret }}"
    cloud = "{{ cloud }}"
    custom_tags = {
        key = "{{ custom_tags_value }}"
      }
    disable_strict_networking = {{ disable_strict_networking }}
    granularity = "{{ granularity }}"
    id = "{{ id }}"
    identity_token_audience_wo = "{{ identity_token_audience_wo }}"
    identity_token_audience_wo_version = {{ identity_token_audience_wo_version }}
    identity_token_key_wo = "{{ identity_token_key_wo }}"
    identity_token_key_wo_version = {{ identity_token_key_wo_version }}
    identity_token_ttl = {{ identity_token_ttl }}
    key_vault_uri = "{{ key_vault_uri }}"
    name = "{{ name }}"
    namespace = "{{ namespace }}"
    secret_name_template = "{{ secret_name_template }}"
    tenant_id = "{{ tenant_id }}"
}
