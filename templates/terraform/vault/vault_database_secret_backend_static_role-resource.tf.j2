resource "vault_database_secret_backend_static_role" "example" {
    backend = "{{ backend }}"
    credential_config = {
        key = "{{ credential_config_value }}"
      }
    credential_type = "{{ credential_type }}"
    db_name = "{{ db_name }}"
    id = "{{ id }}"
    name = "{{ name }}"
    namespace = "{{ namespace }}"
    password_wo = "{{ password_wo }}"
    password_wo_version = {{ password_wo_version }}
    rotation_period = {{ rotation_period }}
    rotation_schedule = "{{ rotation_schedule }}"
    rotation_statements = ["{{ rotation_statements }}"]
    rotation_window = {{ rotation_window }}
    self_managed_password = "{{ self_managed_password }}"
    skip_import_rotation = {{ skip_import_rotation }}
    username = "{{ username }}"
}
