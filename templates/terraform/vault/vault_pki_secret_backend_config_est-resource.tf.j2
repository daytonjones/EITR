resource "vault_pki_secret_backend_config_est" "example" {
    audit_fields = ["{{ audit_fields }}"]
    backend = "{{ backend }}"
    default_mount = {{ default_mount }}
    default_path_policy = "{{ default_path_policy }}"
    enable_sentinel_parsing = {{ enable_sentinel_parsing }}
    enabled = {{ enabled }}
    id = "{{ id }}"
    label_to_path_policy = {
        key = "{{ label_to_path_policy_value }}"
      }
    namespace = "{{ namespace }}"
    authenticators {
      cert = {
        key = "{{ cert_value }}"
      }
      userpass = {
        key = "{{ userpass_value }}"
      }
    }
}
