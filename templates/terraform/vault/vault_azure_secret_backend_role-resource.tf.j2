resource "vault_azure_secret_backend_role" "example" {
    application_object_id = "{{ application_object_id }}"
    backend = "{{ backend }}"
    description = "{{ description }}"
    explicit_max_ttl = "{{ explicit_max_ttl }}"
    id = "{{ id }}"
    max_ttl = "{{ max_ttl }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    namespace = "{{ namespace }}"
    permanently_delete = {{ permanently_delete }}
    persist_app = {{ persist_app }}
    role = "{{ role }}"
    sign_in_audience = "{{ sign_in_audience }}"
    tags = ["{{ tags }}"]
    ttl = "{{ ttl }}"
    azure_groups {
      group_name = "{{ group_name }}"
    }
    azure_roles {
      role_id = "{{ role_id }}"
      role_name = "{{ role_name }}"
      scope = "{{ scope }}"
    }
}
