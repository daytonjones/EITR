resource "vault_approle_auth_backend_role_secret_id" "example" {
    backend = "{{ backend }}"
    cidr_list = ["{{ cidr_list }}"]
    id = "{{ id }}"
    metadata = "{{ metadata }}"
    namespace = "{{ namespace }}"
    num_uses = {{ num_uses }}
    role_name = "{{ role_name }}"
    secret_id = "{{ secret_id }}"
    token_bound_cidrs = ["{{ token_bound_cidrs }}"]
    ttl = {{ ttl }}
    with_wrapped_accessor = {{ with_wrapped_accessor }}
    wrapping_ttl = "{{ wrapping_ttl }}"
}
