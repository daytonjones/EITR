resource "vault_pki_secret_backend_config_scep" "example" {
    allowed_digest_algorithms = ["{{ allowed_digest_algorithms }}"]
    allowed_encryption_algorithms = ["{{ allowed_encryption_algorithms }}"]
    backend = "{{ backend }}"
    default_path_policy = "{{ default_path_policy }}"
    enabled = {{ enabled }}
    id = "{{ id }}"
    log_level = "{{ log_level }}"
    namespace = "{{ namespace }}"
    restrict_ca_chain_to_issuer = {{ restrict_ca_chain_to_issuer }}
    authenticators {
      cert = {
        key = "{{ cert_value }}"
      }
      scep = {
        key = "{{ scep_value }}"
      }
    }
    external_validation {
      intune = {
        key = "{{ intune_value }}"
      }
    }
}
