resource "vault_kmip_secret_ca_imported" "example" {
    ca_pem = "{{ ca_pem }}"
    name = "{{ name }}"
    namespace = "{{ namespace }}"
    path = "{{ path }}"
    role_field = "{{ role_field }}"
    role_name = "{{ role_name }}"
    scope_field = "{{ scope_field }}"
    scope_name = "{{ scope_name }}"
}
