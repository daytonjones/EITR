resource "vault_aws_secret_backend_static_role" "example" {
    assume_role_arn = "{{ assume_role_arn }}"
    assume_role_session_name = "{{ assume_role_session_name }}"
    backend = "{{ backend }}"
    external_id = "{{ external_id }}"
    id = "{{ id }}"
    name = "{{ name }}"
    namespace = "{{ namespace }}"
    rotation_period = {{ rotation_period }}
    username = "{{ username }}"
}
