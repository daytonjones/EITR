resource "vault_ldap_secret_backend_static_role" "example" {
    disable_automated_rotation = {{ disable_automated_rotation }}
    dn = "{{ dn }}"
    id = "{{ id }}"
    mount = "{{ mount }}"
    namespace = "{{ namespace }}"
    password_wo = "{{ password_wo }}"
    password_wo_version = {{ password_wo_version }}
    role_name = "{{ role_name }}"
    rotation_period = {{ rotation_period }}
    rotation_policy = "{{ rotation_policy }}"
    rotation_schedule = "{{ rotation_schedule }}"
    rotation_window = {{ rotation_window }}
    skip_import_rotation = {{ skip_import_rotation }}
    username = "{{ username }}"
}
