resource "vault_auth_backend" "example" {
    description = "{{ description }}"
    disable_remount = {{ disable_remount }}
    id = "{{ id }}"
    identity_token_key = "{{ identity_token_key }}"
    local = {{ local }}
    namespace = "{{ namespace }}"
    path = "{{ path }}"
    tune = ["{{ tune }}"]
    type = "{{ type }}"
}
