resource "kubernetes_limit_range_v1" "example" {
    id = "{{ id }}"
    metadata {
      annotations = {
        key = "{{ annotations_value }}"
      }
      generate_name = "{{ generate_name }}"
      labels = {
        key = "{{ labels_value }}"
      }
      name = "{{ name }}"
      namespace = "{{ namespace }}"
    }
    spec {
      limit {
        default = {
        key = "{{ default_value }}"
      }
        default_request = {
        key = "{{ default_request_value }}"
      }
        max = {
        key = "{{ max_value }}"
      }
        max_limit_request_ratio = {
        key = "{{ max_limit_request_ratio_value }}"
      }
        min = {
        key = "{{ min_value }}"
      }
        type = "{{ type }}"
      }
    }
}
