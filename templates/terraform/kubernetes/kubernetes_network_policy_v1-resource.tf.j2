resource "kubernetes_network_policy_v1" "example" {
    id = "{{ id }}"
    metadata {
      annotations = {
        key = "{{ annotations_value }}"
      }
      generate_name = "{{ generate_name }}"
      labels = {
        key = "{{ labels_value }}"
      }
      name = "{{ name }}"
      namespace = "{{ namespace }}"
    }
    spec {
      policy_types = ["{{ policy_types }}"]
      egress {
        ports {
          end_port = {{ end_port }}
          port = "{{ port }}"
          protocol = "{{ protocol }}"
        }
        to {
          ip_block {
            cidr = "{{ cidr }}"
            except = ["{{ except }}"]
          }
          namespace_selector {
            match_labels = {
        key = "{{ match_labels_value }}"
      }
            match_expressions {
              key = "{{ key }}"
              operator = "{{ operator }}"
              values = ["{{ values }}"]
            }
          }
          pod_selector {
            match_labels = {
        key = "{{ match_labels_value }}"
      }
            match_expressions {
              key = "{{ key }}"
              operator = "{{ operator }}"
              values = ["{{ values }}"]
            }
          }
        }
      }
      ingress {
        from {
          ip_block {
            cidr = "{{ cidr }}"
            except = ["{{ except }}"]
          }
          namespace_selector {
            match_labels = {
        key = "{{ match_labels_value }}"
      }
            match_expressions {
              key = "{{ key }}"
              operator = "{{ operator }}"
              values = ["{{ values }}"]
            }
          }
          pod_selector {
            match_labels = {
        key = "{{ match_labels_value }}"
      }
            match_expressions {
              key = "{{ key }}"
              operator = "{{ operator }}"
              values = ["{{ values }}"]
            }
          }
        }
        ports {
          end_port = {{ end_port }}
          port = "{{ port }}"
          protocol = "{{ protocol }}"
        }
      }
      pod_selector {
        match_labels = {
        key = "{{ match_labels_value }}"
      }
        match_expressions {
          key = "{{ key }}"
          operator = "{{ operator }}"
          values = ["{{ values }}"]
        }
      }
    }
}
