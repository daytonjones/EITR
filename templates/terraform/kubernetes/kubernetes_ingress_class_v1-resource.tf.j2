resource "kubernetes_ingress_class_v1" "example" {
    id = "{{ id }}"
    metadata {
      annotations = {
        key = "{{ annotations_value }}"
      }
      generate_name = "{{ generate_name }}"
      labels = {
        key = "{{ labels_value }}"
      }
      name = "{{ name }}"
    }
    spec {
      controller = "{{ controller }}"
      parameters {
        api_group = "{{ api_group }}"
        kind = "{{ kind }}"
        name = "{{ name }}"
        namespace = "{{ namespace }}"
        scope = "{{ scope }}"
      }
    }
}
