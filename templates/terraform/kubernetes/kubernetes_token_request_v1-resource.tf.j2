resource "kubernetes_token_request_v1" "example" {
    id = "{{ id }}"
    metadata {
      annotations = {
        key = "{{ annotations_value }}"
      }
      generate_name = "{{ generate_name }}"
      labels = {
        key = "{{ labels_value }}"
      }
      name = "{{ name }}"
      namespace = "{{ namespace }}"
    }
    spec {
      audiences = ["{{ audiences }}"]
      expiration_seconds = {{ expiration_seconds }}
      bound_object_ref {
        api_version = "{{ api_version }}"
        kind = "{{ kind }}"
        name = "{{ name }}"
        uid = "{{ uid }}"
      }
    }
}
