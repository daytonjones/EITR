resource "kubernetes_pod_disruption_budget_v1" "example" {
    id = "{{ id }}"
    metadata {
      annotations = {
        key = "{{ annotations_value }}"
      }
      generate_name = "{{ generate_name }}"
      labels = {
        key = "{{ labels_value }}"
      }
      name = "{{ name }}"
      namespace = "{{ namespace }}"
    }
    spec {
      max_unavailable = "{{ max_unavailable }}"
      min_available = "{{ min_available }}"
      selector {
        match_labels = {
        key = "{{ match_labels_value }}"
      }
        match_expressions {
          key = "{{ key }}"
          operator = "{{ operator }}"
          values = ["{{ values }}"]
        }
      }
    }
}
