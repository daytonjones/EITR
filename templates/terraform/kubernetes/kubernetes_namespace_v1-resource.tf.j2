resource "kubernetes_namespace_v1" "example" {
    id = "{{ id }}"
    wait_for_default_service_account = {{ wait_for_default_service_account }}
    metadata {
      annotations = {
        key = "{{ annotations_value }}"
      }
      generate_name = "{{ generate_name }}"
      labels = {
        key = "{{ labels_value }}"
      }
      name = "{{ name }}"
    }
    timeouts {
      delete = "{{ delete }}"
    }
}
