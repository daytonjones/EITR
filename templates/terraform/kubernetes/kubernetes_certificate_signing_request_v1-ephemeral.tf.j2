ephemeral "kubernetes_certificate_signing_request_v1" "example" {
    auto_approve = {{ auto_approve }}
    certificate = "{{ certificate }}"
    metadata {
      name = "{{ name }}"
    }
    spec {
      expiration_seconds = {{ expiration_seconds }}
      request = "{{ request }}"
      signer_name = "{{ signer_name }}"
      usages = ["{{ usages }}"]
    }
}
