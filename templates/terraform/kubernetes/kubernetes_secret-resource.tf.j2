resource "kubernetes_secret" "example" {
    binary_data = {
        key = "{{ binary_data_value }}"
      }
    binary_data_wo = {
        key = "{{ binary_data_wo_value }}"
      }
    binary_data_wo_revision = {{ binary_data_wo_revision }}
    data = {
        key = "{{ data_value }}"
      }
    data_wo = {
        key = "{{ data_wo_value }}"
      }
    data_wo_revision = {{ data_wo_revision }}
    id = "{{ id }}"
    immutable = {{ immutable }}
    type = "{{ type }}"
    wait_for_service_account_token = {{ wait_for_service_account_token }}
    metadata {
      annotations = {
        key = "{{ annotations_value }}"
      }
      generate_name = "{{ generate_name }}"
      labels = {
        key = "{{ labels_value }}"
      }
      name = "{{ name }}"
      namespace = "{{ namespace }}"
    }
    timeouts {
      create = "{{ create }}"
    }
}
