resource "hcp_aws_network_peering" "example" {
    hvn_id = "{{ hvn_id }}"
    id = "{{ id }}"
    peer_account_id = "{{ peer_account_id }}"
    peer_vpc_id = "{{ peer_vpc_id }}"
    peer_vpc_region = "{{ peer_vpc_region }}"
    peering_id = "{{ peering_id }}"
    project_id = "{{ project_id }}"
    timeouts {
      create = "{{ create }}"
      default = "{{ default }}"
      delete = "{{ delete }}"
    }
}
