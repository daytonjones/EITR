resource "hcp_packer_channel_assignment" "example" {
    bucket_name = "{{ bucket_name }}"
    channel_name = "{{ channel_name }}"
    id = "{{ id }}"
    project_id = "{{ project_id }}"
    version_fingerprint = "{{ version_fingerprint }}"
    timeouts {
      create = "{{ create }}"
      default = "{{ default }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
