resource "hcp_hvn" "example" {
    cidr_block = "{{ cidr_block }}"
    cloud_provider = "{{ cloud_provider }}"
    hvn_id = "{{ hvn_id }}"
    id = "{{ id }}"
    project_id = "{{ project_id }}"
    region = "{{ region }}"
