resource "hcp_packer_channel" "example" {
    bucket_name = "{{ bucket_name }}"
    id = "{{ id }}"
    name = "{{ name }}"
    project_id = "{{ project_id }}"
    restricted = {{ restricted }}
    timeouts {
      create = "{{ create }}"
      default = "{{ default }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
