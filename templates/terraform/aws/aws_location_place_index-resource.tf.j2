resource "aws_location_place_index" "example" {
    data_source = "{{ data_source }}"
    description = "{{ description }}"
    id = "{{ id }}"
    index_name = "{{ index_name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    data_source_configuration {
      intended_use = "{{ intended_use }}"
    }
}
