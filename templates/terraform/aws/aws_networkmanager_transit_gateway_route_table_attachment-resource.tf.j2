resource "aws_networkmanager_transit_gateway_route_table_attachment" "example" {
    id = "{{ id }}"
    peering_id = "{{ peering_id }}"
    routing_policy_label = "{{ routing_policy_label }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    transit_gateway_route_table_arn = "{{ transit_gateway_route_table_arn }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
