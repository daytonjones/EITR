resource "aws_emr_block_public_access_configuration" "example" {
    block_public_security_group_rules = {{ block_public_security_group_rules }}
    id = "{{ id }}"
    region = "{{ region }}"
    permitted_public_security_group_rule_range {
      max_range = {{ max_range }}
      min_range = {{ min_range }}
    }
}
