resource "aws_lightsail_disk" "example" {
    availability_zone = "{{ availability_zone }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    size_in_gb = {{ size_in_gb }}
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
