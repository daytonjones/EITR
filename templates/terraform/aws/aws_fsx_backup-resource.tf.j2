resource "aws_fsx_backup" "example" {
    file_system_id = "{{ file_system_id }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    volume_id = "{{ volume_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
