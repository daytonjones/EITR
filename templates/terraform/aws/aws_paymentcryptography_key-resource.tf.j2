resource "aws_paymentcryptography_key" "example" {
    deletion_window_in_days = {{ deletion_window_in_days }}
    enabled = {{ enabled }}
    exportable = {{ exportable }}
    key_check_value_algorithm = "{{ key_check_value_algorithm }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    key_attributes {
      key_algorithm = "{{ key_algorithm }}"
      key_class = "{{ key_class }}"
      key_usage = "{{ key_usage }}"
      key_modes_of_use {
        decrypt = {{ decrypt }}
        derive_key = {{ derive_key }}
        encrypt = {{ encrypt }}
        generate = {{ generate }}
        no_restrictions = {{ no_restrictions }}
        sign = {{ sign }}
        unwrap = {{ unwrap }}
        verify = {{ verify }}
        wrap = {{ wrap }}
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
