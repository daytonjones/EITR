resource "aws_appconfig_environment" "example" {
    application_id = "{{ application_id }}"
    description = "{{ description }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    monitor {
      alarm_arn = "{{ alarm_arn }}"
      alarm_role_arn = "{{ alarm_role_arn }}"
    }
}
