resource "aws_location_map" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    map_name = "{{ map_name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    configuration {
      style = "{{ style }}"
    }
}
