resource "aws_wafregional_byte_match_set" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    byte_match_tuples {
      positional_constraint = "{{ positional_constraint }}"
      target_string = "{{ target_string }}"
      text_transformation = "{{ text_transformation }}"
      field_to_match {
        data = "{{ data }}"
        type = "{{ type }}"
      }
    }
}
