resource "aws_vpc_ipam_pool_cidr_allocation" "example" {
    cidr = "{{ cidr }}"
    description = "{{ description }}"
    disallowed_cidrs = ["{{ disallowed_cidrs }}"]
    id = "{{ id }}"
    ipam_pool_id = "{{ ipam_pool_id }}"
    netmask_length = {{ netmask_length }}
    region = "{{ region }}"
}
