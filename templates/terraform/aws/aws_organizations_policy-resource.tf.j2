resource "aws_organizations_policy" "example" {
    content = "{{ content }}"
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    skip_destroy = {{ skip_destroy }}
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    type = "{{ type }}"
}
