resource "aws_backup_plan" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    advanced_backup_setting {
      backup_options = {
        key = "{{ backup_options_value }}"
      }
      resource_type = "{{ resource_type }}"
    }
    rule {
      completion_window = {{ completion_window }}
      enable_continuous_backup = {{ enable_continuous_backup }}
      recovery_point_tags = {
        key = "{{ recovery_point_tags_value }}"
      }
      rule_name = "{{ rule_name }}"
      schedule = "{{ schedule }}"
      schedule_expression_timezone = "{{ schedule_expression_timezone }}"
      start_window = {{ start_window }}
      target_logically_air_gapped_backup_vault_arn = "{{ target_logically_air_gapped_backup_vault_arn }}"
      target_vault_name = "{{ target_vault_name }}"
      copy_action {
        destination_vault_arn = "{{ destination_vault_arn }}"
        lifecycle {
          cold_storage_after = {{ cold_storage_after }}
          delete_after = {{ delete_after }}
          opt_in_to_archive_for_supported_resources = {{ opt_in_to_archive_for_supported_resources }}
        }
      }
      lifecycle {
        cold_storage_after = {{ cold_storage_after }}
        delete_after = {{ delete_after }}
        opt_in_to_archive_for_supported_resources = {{ opt_in_to_archive_for_supported_resources }}
      }
      scan_action {
        malware_scanner = "{{ malware_scanner }}"
        scan_mode = "{{ scan_mode }}"
      }
    }
    scan_setting {
      malware_scanner = "{{ malware_scanner }}"
      resource_types = ["{{ resource_types }}"]
      scanner_role_arn = "{{ scanner_role_arn }}"
    }
}
