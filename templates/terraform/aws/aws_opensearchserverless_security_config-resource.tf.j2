resource "aws_opensearchserverless_security_config" "example" {
    description = "{{ description }}"
    name = "{{ name }}"
    region = "{{ region }}"
    type = "{{ type }}"
    saml_options {
      group_attribute = "{{ group_attribute }}"
      metadata = "{{ metadata }}"
      session_timeout = {{ session_timeout }}
      user_attribute = "{{ user_attribute }}"
    }
}
