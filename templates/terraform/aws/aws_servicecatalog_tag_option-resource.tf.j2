resource "aws_servicecatalog_tag_option" "example" {
    active = {{ active }}
    id = "{{ id }}"
    key = "{{ key }}"
    region = "{{ region }}"
    value = "{{ value }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
