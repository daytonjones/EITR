        comparison = "{{ comparison }}"
        value = "{{ value }}"
      }
      confidence {
        eq = {{ eq }}
        gt = {{ gt }}
        gte = {{ gte }}
        lt = {{ lt }}
        lte = {{ lte }}
      }
      created_at {
        end = "{{ end }}"
        start = "{{ start }}"
        date_range {
          unit = "{{ unit }}"
          value = {{ value }}
        }
      }
      criticality {
        eq = {{ eq }}
        gt = {{ gt }}
        gte = {{ gte }}
        lt = {{ lt }}
