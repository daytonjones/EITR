resource "aws_wafv2_ip_set" "example" {
    addresses = ["{{ addresses }}"]
    description = "{{ description }}"
    id = "{{ id }}"
    ip_address_version = "{{ ip_address_version }}"
    name = "{{ name }}"
    name_prefix = "{{ name_prefix }}"
    region = "{{ region }}"
    scope = "{{ scope }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
