resource "aws_rds_reserved_instance" "example" {
    id = "{{ id }}"
    instance_count = {{ instance_count }}
    offering_id = "{{ offering_id }}"
    region = "{{ region }}"
    reservation_id = "{{ reservation_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
