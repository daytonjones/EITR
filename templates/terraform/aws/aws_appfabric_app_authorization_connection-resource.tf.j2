resource "aws_appfabric_app_authorization_connection" "example" {
    app_authorization_arn = "{{ app_authorization_arn }}"
    app_bundle_arn = "{{ app_bundle_arn }}"
    region = "{{ region }}"
    auth_request {
      code = "{{ code }}"
      redirect_uri = "{{ redirect_uri }}"
    }
    timeouts {
      create = "{{ create }}"
    }
}
