resource "aws_codeconnections_connection" "example" {
    host_arn = "{{ host_arn }}"
    name = "{{ name }}"
    provider_type = "{{ provider_type }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
