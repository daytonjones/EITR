resource "aws_apprunner_auto_scaling_configuration_version" "example" {
    auto_scaling_configuration_name = "{{ auto_scaling_configuration_name }}"
    id = "{{ id }}"
    max_concurrency = {{ max_concurrency }}
    max_size = {{ max_size }}
    min_size = {{ min_size }}
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
