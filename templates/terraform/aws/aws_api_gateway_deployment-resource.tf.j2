resource "aws_api_gateway_deployment" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    region = "{{ region }}"
    rest_api_id = "{{ rest_api_id }}"
    triggers = {
        key = "{{ triggers_value }}"
      }
    variables = {
        key = "{{ variables_value }}"
      }
}
