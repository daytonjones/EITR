resource "aws_datasync_location_smb" "example" {
    agent_arns = ["{{ agent_arns }}"]
    domain = "{{ domain }}"
    id = "{{ id }}"
    password = "{{ password }}"
    region = "{{ region }}"
    server_hostname = "{{ server_hostname }}"
    subdirectory = "{{ subdirectory }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    user = "{{ user }}"
    mount_options {
      version = "{{ version }}"
    }
}
