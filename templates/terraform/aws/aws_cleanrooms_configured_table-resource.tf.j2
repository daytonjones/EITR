resource "aws_cleanrooms_configured_table" "example" {
    allowed_columns = ["{{ allowed_columns }}"]
    analysis_method = "{{ analysis_method }}"
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    table_reference {
      database_name = "{{ database_name }}"
      table_name = "{{ table_name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
