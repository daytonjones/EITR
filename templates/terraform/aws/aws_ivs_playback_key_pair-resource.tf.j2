resource "aws_ivs_playback_key_pair" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    public_key = "{{ public_key }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
