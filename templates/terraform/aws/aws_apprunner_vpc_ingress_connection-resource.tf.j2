resource "aws_apprunner_vpc_ingress_connection" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    service_arn = "{{ service_arn }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    ingress_vpc_configuration {
      vpc_endpoint_id = "{{ vpc_endpoint_id }}"
      vpc_id = "{{ vpc_id }}"
    }
}
