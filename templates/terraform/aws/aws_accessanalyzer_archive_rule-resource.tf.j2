resource "aws_accessanalyzer_archive_rule" "example" {
    analyzer_name = "{{ analyzer_name }}"
    id = "{{ id }}"
    region = "{{ region }}"
    rule_name = "{{ rule_name }}"
    filter {
      contains = ["{{ contains }}"]
      criteria = "{{ criteria }}"
      eq = ["{{ eq }}"]
      exists = "{{ exists }}"
      neq = ["{{ neq }}"]
    }
}
