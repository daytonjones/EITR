resource "aws_guardduty_detector" "example" {
    enable = {{ enable }}
    finding_publishing_frequency = "{{ finding_publishing_frequency }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    datasources {
      kubernetes {
        audit_logs {
          enable = {{ enable }}
        }
      }
      malware_protection {
        scan_ec2_instance_with_findings {
          ebs_volumes {
            enable = {{ enable }}
          }
        }
      }
      s3_logs {
        enable = {{ enable }}
      }
    }
}
