resource "aws_vpc_ipam_pool_cidr" "example" {
    cidr = "{{ cidr }}"
    id = "{{ id }}"
    ipam_pool_id = "{{ ipam_pool_id }}"
    netmask_length = {{ netmask_length }}
    region = "{{ region }}"
    cidr_authorization_context {
      message = "{{ message }}"
      signature = "{{ signature }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
