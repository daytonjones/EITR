resource "aws_lakeformation_resource_lf_tag" "example" {
    catalog_id = "{{ catalog_id }}"
    region = "{{ region }}"
    database {
      catalog_id = "{{ catalog_id }}"
      name = "{{ name }}"
    }
    lf_tag {
      catalog_id = "{{ catalog_id }}"
      key = "{{ key }}"
      value = "{{ value }}"
    }
    table {
      catalog_id = "{{ catalog_id }}"
      database_name = "{{ database_name }}"
      name = "{{ name }}"
      wildcard = {{ wildcard }}
    }
    table_with_columns {
      catalog_id = "{{ catalog_id }}"
      column_names = ["{{ column_names }}"]
      database_name = "{{ database_name }}"
      name = "{{ name }}"
      column_wildcard {
        excluded_column_names = ["{{ excluded_column_names }}"]
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
