resource "aws_redshift_hsm_client_certificate" "example" {
    hsm_client_certificate_identifier = "{{ hsm_client_certificate_identifier }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
