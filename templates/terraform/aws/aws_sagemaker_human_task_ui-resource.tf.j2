resource "aws_sagemaker_human_task_ui" "example" {
    human_task_ui_name = "{{ human_task_ui_name }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    ui_template {
      content = "{{ content }}"
    }
}
