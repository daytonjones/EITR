resource "aws_networkmanager_site" "example" {
    description = "{{ description }}"
    global_network_id = "{{ global_network_id }}"
    id = "{{ id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    location {
      address = "{{ address }}"
      latitude = "{{ latitude }}"
      longitude = "{{ longitude }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
