resource "aws_sagemaker_endpoint" "example" {
    endpoint_config_name = "{{ endpoint_config_name }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    deployment_config {
      auto_rollback_configuration {
        alarms {
          alarm_name = "{{ alarm_name }}"
        }
      }
      blue_green_update_policy {
        maximum_execution_timeout_in_seconds = {{ maximum_execution_timeout_in_seconds }}
        termination_wait_in_seconds = {{ termination_wait_in_seconds }}
        traffic_routing_configuration {
          type = "{{ type }}"
          wait_interval_in_seconds = {{ wait_interval_in_seconds }}
          canary_size {
            type = "{{ type }}"
            value = {{ value }}
          }
          linear_step_size {
            type = "{{ type }}"
            value = {{ value }}
          }
        }
      }
      rolling_update_policy {
        maximum_execution_timeout_in_seconds = {{ maximum_execution_timeout_in_seconds }}
        wait_interval_in_seconds = {{ wait_interval_in_seconds }}
        maximum_batch_size {
          type = "{{ type }}"
          value = {{ value }}
        }
        rollback_maximum_batch_size {
          type = "{{ type }}"
          value = {{ value }}
        }
      }
    }
}
