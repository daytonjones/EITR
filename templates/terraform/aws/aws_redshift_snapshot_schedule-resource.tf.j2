resource "aws_redshift_snapshot_schedule" "example" {
    definitions = ["{{ definitions }}"]
    description = "{{ description }}"
    force_destroy = {{ force_destroy }}
    id = "{{ id }}"
    identifier = "{{ identifier }}"
    identifier_prefix = "{{ identifier_prefix }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
