resource "aws_xray_group" "example" {
    filter_expression = "{{ filter_expression }}"
    group_name = "{{ group_name }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    insights_configuration {
      insights_enabled = {{ insights_enabled }}
      notifications_enabled = {{ notifications_enabled }}
    }
}
