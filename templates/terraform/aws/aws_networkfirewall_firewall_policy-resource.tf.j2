resource "aws_networkfirewall_firewall_policy" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    encryption_configuration {
      key_id = "{{ key_id }}"
      type = "{{ type }}"
    }
    firewall_policy {
      enable_tls_session_holding = {{ enable_tls_session_holding }}
      stateful_default_actions = ["{{ stateful_default_actions }}"]
      stateless_default_actions = ["{{ stateless_default_actions }}"]
      stateless_fragment_default_actions = ["{{ stateless_fragment_default_actions }}"]
      tls_inspection_configuration_arn = "{{ tls_inspection_configuration_arn }}"
      policy_variables {
        rule_variables {
          key = "{{ key }}"
          ip_set {
            definition = ["{{ definition }}"]
          }
        }
      }
      stateful_engine_options {
        rule_order = "{{ rule_order }}"
        stream_exception_policy = "{{ stream_exception_policy }}"
        flow_timeouts {
          tcp_idle_timeout_seconds = {{ tcp_idle_timeout_seconds }}
        }
      }
      stateful_rule_group_reference {
        deep_threat_inspection = "{{ deep_threat_inspection }}"
        priority = {{ priority }}
        resource_arn = "{{ resource_arn }}"
        override {
          action = "{{ action }}"
        }
      }
      stateless_custom_action {
        action_name = "{{ action_name }}"
        action_definition {
          publish_metric_action {
            dimension {
              value = "{{ value }}"
            }
          }
        }
      }
      stateless_rule_group_reference {
        priority = {{ priority }}
        resource_arn = "{{ resource_arn }}"
      }
    }
}
