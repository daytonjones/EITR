resource "aws_codestarnotifications_notification_rule" "example" {
    detail_type = "{{ detail_type }}"
    event_type_ids = ["{{ event_type_ids }}"]
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    resource = "{{ resource }}"
    status = "{{ status }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    target {
      address = "{{ address }}"
      type = "{{ type }}"
    }
}
