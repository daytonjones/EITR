resource "aws_elasticache_reserved_cache_node" "example" {
    cache_node_count = {{ cache_node_count }}
    id = "{{ id }}"
    region = "{{ region }}"
    reserved_cache_nodes_offering_id = "{{ reserved_cache_nodes_offering_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
