        role_arn = "{{ role_arn }}"
        put_item {
          table_name = "{{ table_name }}"
        }
      }
      elasticsearch {
        endpoint = "{{ endpoint }}"
        id = "{{ id }}"
        index = "{{ index }}"
        role_arn = "{{ role_arn }}"
        type = "{{ type }}"
      }
      firehose {
        batch_mode = {{ batch_mode }}
        delivery_stream_name = "{{ delivery_stream_name }}"
        role_arn = "{{ role_arn }}"
        separator = "{{ separator }}"
      }
      http {
        confirmation_url = "{{ confirmation_url }}"
        url = "{{ url }}"
        http_header {
          key = "{{ key }}"
          value = "{{ value }}"
        }
      }
      iot_analytics {
        batch_mode = {{ batch_mode }}
        channel_name = "{{ channel_name }}"
        role_arn = "{{ role_arn }}"
      }
      iot_events {
        batch_mode = {{ batch_mode }}
