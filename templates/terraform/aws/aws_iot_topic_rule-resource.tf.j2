    }
    dynamodbv2 {
      role_arn = "{{ role_arn }}"
      put_item {
        table_name = "{{ table_name }}"
      }
    }
    elasticsearch {
      endpoint = "{{ endpoint }}"
      id = "{{ id }}"
      index = "{{ index }}"
      role_arn = "{{ role_arn }}"
      type = "{{ type }}"
    }
