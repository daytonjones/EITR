resource "aws_route53_resolver_rule" "example" {
    domain_name = "{{ domain_name }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    resolver_endpoint_id = "{{ resolver_endpoint_id }}"
    rule_type = "{{ rule_type }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    target_ip {
      ip = "{{ ip }}"
      ipv6 = "{{ ipv6 }}"
      port = {{ port }}
      protocol = "{{ protocol }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
