resource "aws_datazone_form_type" "example" {
    description = "{{ description }}"
    domain_identifier = "{{ domain_identifier }}"
    name = "{{ name }}"
    owning_project_identifier = "{{ owning_project_identifier }}"
    region = "{{ region }}"
    status = "{{ status }}"
    model {
      smithy = "{{ smithy }}"
    }
    timeouts {
      create = "{{ create }}"
    }
}
