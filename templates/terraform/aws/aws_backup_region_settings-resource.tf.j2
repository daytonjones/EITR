resource "aws_backup_region_settings" "example" {
    id = "{{ id }}"
    region = "{{ region }}"
    resource_type_management_preference = {
        key = "{{ resource_type_management_preference_value }}"
      }
    resource_type_opt_in_preference = {
        key = "{{ resource_type_opt_in_preference_value }}"
      }
}
