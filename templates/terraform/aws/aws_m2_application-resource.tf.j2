resource "aws_m2_application" "example" {
    description = "{{ description }}"
    engine_type = "{{ engine_type }}"
    kms_key_id = "{{ kms_key_id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    role_arn = "{{ role_arn }}"
    tags = {
        key = "{{ tags_value }}"
      }
    definition {
      content = "{{ content }}"
      s3_location = "{{ s3_location }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
