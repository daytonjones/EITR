resource "aws_glacier_vault" "example" {
    access_policy = "{{ access_policy }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    notification {
      events = ["{{ events }}"]
      sns_topic = "{{ sns_topic }}"
    }
}
