resource "aws_directory_service_directory" "example" {
    alias = "{{ alias }}"
    description = "{{ description }}"
    desired_number_of_domain_controllers = {{ desired_number_of_domain_controllers }}
    edition = "{{ edition }}"
    enable_directory_data_access = {{ enable_directory_data_access }}
    enable_sso = {{ enable_sso }}
    id = "{{ id }}"
    name = "{{ name }}"
    password = "{{ password }}"
    region = "{{ region }}"
    short_name = "{{ short_name }}"
    size = "{{ size }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    type = "{{ type }}"
    connect_settings {
      customer_dns_ips = ["{{ customer_dns_ips }}"]
      customer_username = "{{ customer_username }}"
      subnet_ids = ["{{ subnet_ids }}"]
      vpc_id = "{{ vpc_id }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    vpc_settings {
      subnet_ids = ["{{ subnet_ids }}"]
      vpc_id = "{{ vpc_id }}"
    }
}
