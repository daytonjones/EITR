resource "aws_vpn_gateway" "example" {
    amazon_side_asn = "{{ amazon_side_asn }}"
    availability_zone = "{{ availability_zone }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    vpc_id = "{{ vpc_id }}"
}
