resource "aws_pipes_pipe" "example" {
    description = "{{ description }}"
    desired_state = "{{ desired_state }}"
    enrichment = "{{ enrichment }}"
    id = "{{ id }}"
    kms_key_identifier = "{{ kms_key_identifier }}"
    name = "{{ name }}"
    name_prefix = "{{ name_prefix }}"
    region = "{{ region }}"
    role_arn = "{{ role_arn }}"
    source = "{{ source }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    target = "{{ target }}"
    enrichment_parameters {
      input_template = "{{ input_template }}"
      http_parameters {
        header_parameters = {
        key = "{{ header_parameters_value }}"
      }
        path_parameter_values = ["{{ path_parameter_values }}"]
        query_string_parameters = {
        key = "{{ query_string_parameters_value }}"
      }
      }
    }
    log_configuration {
      include_execution_data = ["{{ include_execution_data }}"]
      level = "{{ level }}"
      cloudwatch_logs_log_destination {
        log_group_arn = "{{ log_group_arn }}"
      }
      firehose_log_destination {
        delivery_stream_arn = "{{ delivery_stream_arn }}"
      }
      s3_log_destination {
        bucket_name = "{{ bucket_name }}"
        bucket_owner = "{{ bucket_owner }}"
        output_format = "{{ output_format }}"
        prefix = "{{ prefix }}"
      }
    }
    source_parameters {
      activemq_broker_parameters {
        batch_size = {{ batch_size }}
        maximum_batching_window_in_seconds = {{ maximum_batching_window_in_seconds }}
        queue_name = "{{ queue_name }}"
        credentials {
          basic_auth = "{{ basic_auth }}"
        }
      }
      dynamodb_stream_parameters {
        batch_size = {{ batch_size }}
        maximum_batching_window_in_seconds = {{ maximum_batching_window_in_seconds }}
        maximum_record_age_in_seconds = {{ maximum_record_age_in_seconds }}
        maximum_retry_attempts = {{ maximum_retry_attempts }}
        on_partial_batch_item_failure = "{{ on_partial_batch_item_failure }}"
        parallelization_factor = {{ parallelization_factor }}
        starting_position = "{{ starting_position }}"
        dead_letter_config {
          arn = "{{ arn }}"
        }
      }
      filter_criteria {
        filter {
          pattern = "{{ pattern }}"
        }
      }
      kinesis_stream_parameters {
        batch_size = {{ batch_size }}
        maximum_batching_window_in_seconds = {{ maximum_batching_window_in_seconds }}
        maximum_record_age_in_seconds = {{ maximum_record_age_in_seconds }}
        maximum_retry_attempts = {{ maximum_retry_attempts }}
        on_partial_batch_item_failure = "{{ on_partial_batch_item_failure }}"
        parallelization_factor = {{ parallelization_factor }}
        starting_position = "{{ starting_position }}"
        starting_position_timestamp = "{{ starting_position_timestamp }}"
        dead_letter_config {
          arn = "{{ arn }}"
        }
      }
      managed_streaming_kafka_parameters {
        batch_size = {{ batch_size }}
        consumer_group_id = "{{ consumer_group_id }}"
        maximum_batching_window_in_seconds = {{ maximum_batching_window_in_seconds }}
        starting_position = "{{ starting_position }}"
        topic_name = "{{ topic_name }}"
        credentials {
          client_certificate_tls_auth = "{{ client_certificate_tls_auth }}"
          sasl_scram_512_auth = "{{ sasl_scram_512_auth }}"
        }
      }
      rabbitmq_broker_parameters {
        batch_size = {{ batch_size }}
        maximum_batching_window_in_seconds = {{ maximum_batching_window_in_seconds }}
        queue_name = "{{ queue_name }}"
        virtual_host = "{{ virtual_host }}"
        credentials {
          basic_auth = "{{ basic_auth }}"
        }
      }
      self_managed_kafka_parameters {
        additional_bootstrap_servers = ["{{ additional_bootstrap_servers }}"]
        batch_size = {{ batch_size }}
        consumer_group_id = "{{ consumer_group_id }}"
        maximum_batching_window_in_seconds = {{ maximum_batching_window_in_seconds }}
        server_root_ca_certificate = "{{ server_root_ca_certificate }}"
        starting_position = "{{ starting_position }}"
        topic_name = "{{ topic_name }}"
        credentials {
          basic_auth = "{{ basic_auth }}"
          client_certificate_tls_auth = "{{ client_certificate_tls_auth }}"
          sasl_scram_256_auth = "{{ sasl_scram_256_auth }}"
          sasl_scram_512_auth = "{{ sasl_scram_512_auth }}"
        }
        vpc {
          security_groups = ["{{ security_groups }}"]
          subnets = ["{{ subnets }}"]
        }
      }
      sqs_queue_parameters {
        batch_size = {{ batch_size }}
        maximum_batching_window_in_seconds = {{ maximum_batching_window_in_seconds }}
      }
    }
    target_parameters {
      input_template = "{{ input_template }}"
      batch_job_parameters {
        job_definition = "{{ job_definition }}"
        job_name = "{{ job_name }}"
        parameters = {
        key = "{{ parameters_value }}"
      }
        array_properties {
          size = {{ size }}
        }
        container_overrides {
          command = ["{{ command }}"]
          instance_type = "{{ instance_type }}"
          environment {
            name = "{{ name }}"
            value = "{{ value }}"
          }
          resource_requirement {
            type = "{{ type }}"
            value = "{{ value }}"
          }
        }
        depends_on {
          job_id = "{{ job_id }}"
          type = "{{ type }}"
        }
        retry_strategy {
          attempts = {{ attempts }}
        }
      }
      cloudwatch_logs_parameters {
        log_stream_name = "{{ log_stream_name }}"
        timestamp = "{{ timestamp }}"
      }
      ecs_task_parameters {
        enable_ecs_managed_tags = {{ enable_ecs_managed_tags }}
        enable_execute_command = {{ enable_execute_command }}
        group = "{{ group }}"
        launch_type = "{{ launch_type }}"
        platform_version = "{{ platform_version }}"
        propagate_tags = "{{ propagate_tags }}"
        reference_id = "{{ reference_id }}"
        tags = {
        key = "{{ tags_value }}"
      }
        task_count = {{ task_count }}
        task_definition_arn = "{{ task_definition_arn }}"
        capacity_provider_strategy {
          base = {{ base }}
          capacity_provider = "{{ capacity_provider }}"
          weight = {{ weight }}
        }
        network_configuration {
          aws_vpc_configuration {
            assign_public_ip = "{{ assign_public_ip }}"
            security_groups = ["{{ security_groups }}"]
            subnets = ["{{ subnets }}"]
          }
        }
        overrides {
          cpu = "{{ cpu }}"
          execution_role_arn = "{{ execution_role_arn }}"
          memory = "{{ memory }}"
          task_role_arn = "{{ task_role_arn }}"
          container_override {
            command = ["{{ command }}"]
            cpu = {{ cpu }}
            memory = {{ memory }}
            memory_reservation = {{ memory_reservation }}
            name = "{{ name }}"
            environment {
              name = "{{ name }}"
              value = "{{ value }}"
            }
            environment_file {
              type = "{{ type }}"
              value = "{{ value }}"
            }
            resource_requirement {
              type = "{{ type }}"
              value = "{{ value }}"
            }
          }
          ephemeral_storage {
            size_in_gib = {{ size_in_gib }}
          }
          inference_accelerator_override {
            device_name = "{{ device_name }}"
            device_type = "{{ device_type }}"
          }
        }
        placement_constraint {
          expression = "{{ expression }}"
          type = "{{ type }}"
        }
        placement_strategy {
          field = "{{ field }}"
          type = "{{ type }}"
        }
      }
      eventbridge_event_bus_parameters {
        detail_type = "{{ detail_type }}"
        endpoint_id = "{{ endpoint_id }}"
        resources = ["{{ resources }}"]
        source = "{{ source }}"
        time = "{{ time }}"
      }
      http_parameters {
        header_parameters = {
        key = "{{ header_parameters_value }}"
      }
        path_parameter_values = ["{{ path_parameter_values }}"]
        query_string_parameters = {
        key = "{{ query_string_parameters_value }}"
      }
      }
      kinesis_stream_parameters {
        partition_key = "{{ partition_key }}"
      }
      lambda_function_parameters {
        invocation_type = "{{ invocation_type }}"
      }
      redshift_data_parameters {
        database = "{{ database }}"
        db_user = "{{ db_user }}"
        secret_manager_arn = "{{ secret_manager_arn }}"
        sqls = ["{{ sqls }}"]
        statement_name = "{{ statement_name }}"
        with_event = {{ with_event }}
      }
      sagemaker_pipeline_parameters {
        pipeline_parameter {
          name = "{{ name }}"
          value = "{{ value }}"
        }
      }
      sqs_queue_parameters {
        message_deduplication_id = "{{ message_deduplication_id }}"
        message_group_id = "{{ message_group_id }}"
      }
      step_function_state_machine_parameters {
        invocation_type = "{{ invocation_type }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
