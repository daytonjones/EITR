resource "aws_glue_user_defined_function" "example" {
    catalog_id = "{{ catalog_id }}"
    class_name = "{{ class_name }}"
    database_name = "{{ database_name }}"
    id = "{{ id }}"
    name = "{{ name }}"
    owner_name = "{{ owner_name }}"
    owner_type = "{{ owner_type }}"
    region = "{{ region }}"
    resource_uris {
      resource_type = "{{ resource_type }}"
      uri = "{{ uri }}"
    }
}
