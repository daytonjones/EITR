data "aws_s3_object" "example" {
    bucket = "{{ bucket }}"
    checksum_mode = "{{ checksum_mode }}"
    download_body = "{{ download_body }}"
    id = "{{ id }}"
    key = "{{ key }}"
    range = "{{ range }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    version_id = "{{ version_id }}"
}
