resource "aws_directory_service_region" "example" {
    desired_number_of_domain_controllers = {{ desired_number_of_domain_controllers }}
    directory_id = "{{ directory_id }}"
    id = "{{ id }}"
    region = "{{ region }}"
    region_name = "{{ region_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    vpc_settings {
      subnet_ids = ["{{ subnet_ids }}"]
      vpc_id = "{{ vpc_id }}"
    }
}
