resource "aws_dx_lag" "example" {
    connection_id = "{{ connection_id }}"
    connections_bandwidth = "{{ connections_bandwidth }}"
    force_destroy = {{ force_destroy }}
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    provider_name = "{{ provider_name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
