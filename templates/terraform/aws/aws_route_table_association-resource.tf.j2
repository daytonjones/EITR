resource "aws_route_table_association" "example" {
    gateway_id = "{{ gateway_id }}"
    id = "{{ id }}"
    region = "{{ region }}"
    route_table_id = "{{ route_table_id }}"
    subnet_id = "{{ subnet_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
