resource "aws_lambda_invocation" "example" {
    function_name = "{{ function_name }}"
    id = "{{ id }}"
    input = "{{ input }}"
    lifecycle_scope = "{{ lifecycle_scope }}"
    qualifier = "{{ qualifier }}"
    region = "{{ region }}"
    tenant_id = "{{ tenant_id }}"
    terraform_key = "{{ terraform_key }}"
    triggers = {
        key = "{{ triggers_value }}"
      }
}
