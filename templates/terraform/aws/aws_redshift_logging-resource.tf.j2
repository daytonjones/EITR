resource "aws_redshift_logging" "example" {
    bucket_name = "{{ bucket_name }}"
    cluster_identifier = "{{ cluster_identifier }}"
    log_destination_type = "{{ log_destination_type }}"
    log_exports = ["{{ log_exports }}"]
    region = "{{ region }}"
    s3_key_prefix = "{{ s3_key_prefix }}"
}
