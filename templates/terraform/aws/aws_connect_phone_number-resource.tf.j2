resource "aws_connect_phone_number" "example" {
    country_code = "{{ country_code }}"
    description = "{{ description }}"
    id = "{{ id }}"
    prefix = "{{ prefix }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    target_arn = "{{ target_arn }}"
    type = "{{ type }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
