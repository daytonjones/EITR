resource "aws_prometheus_query_logging_configuration" "example" {
    region = "{{ region }}"
    workspace_id = "{{ workspace_id }}"
    destination {
      cloudwatch_logs {
        log_group_arn = "{{ log_group_arn }}"
      }
      filters {
        qsp_threshold = {{ qsp_threshold }}
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
