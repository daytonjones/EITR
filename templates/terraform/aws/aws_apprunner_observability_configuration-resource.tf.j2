resource "aws_apprunner_observability_configuration" "example" {
    id = "{{ id }}"
    observability_configuration_name = "{{ observability_configuration_name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    trace_configuration {
      vendor = "{{ vendor }}"
    }
}
