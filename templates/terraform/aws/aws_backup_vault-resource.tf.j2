resource "aws_backup_vault" "example" {
    force_destroy = {{ force_destroy }}
    id = "{{ id }}"
    kms_key_arn = "{{ kms_key_arn }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      delete = "{{ delete }}"
    }
}
