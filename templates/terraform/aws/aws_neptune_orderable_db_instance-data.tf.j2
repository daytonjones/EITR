data "aws_neptune_orderable_db_instance" "example" {
    engine = "{{ engine }}"
    engine_version = "{{ engine_version }}"
    id = "{{ id }}"
    instance_class = "{{ instance_class }}"
    license_model = "{{ license_model }}"
    preferred_instance_classes = ["{{ preferred_instance_classes }}"]
    region = "{{ region }}"
    vpc = {{ vpc }}
}
