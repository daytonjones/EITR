data "aws_key_pair" "example" {
    id = "{{ id }}"
    include_public_key = {{ include_public_key }}
    key_name = "{{ key_name }}"
    key_pair_id = "{{ key_pair_id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
