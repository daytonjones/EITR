resource "aws_efs_replication_configuration" "example" {
    id = "{{ id }}"
    region = "{{ region }}"
    source_file_system_id = "{{ source_file_system_id }}"
    destination {
      availability_zone_name = "{{ availability_zone_name }}"
      file_system_id = "{{ file_system_id }}"
      kms_key_id = "{{ kms_key_id }}"
      region = "{{ region }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
