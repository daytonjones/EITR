data "aws_availability_zones" "example" {
    all_availability_zones = {{ all_availability_zones }}
    exclude_names = ["{{ exclude_names }}"]
    exclude_zone_ids = ["{{ exclude_zone_ids }}"]
    id = "{{ id }}"
    region = "{{ region }}"
    state = "{{ state }}"
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
