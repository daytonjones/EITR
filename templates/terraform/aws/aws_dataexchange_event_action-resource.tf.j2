resource "aws_dataexchange_event_action" "example" {
    region = "{{ region }}"
    action {
      export_revision_to_s3 {
        encryption {
          kms_key_arn = "{{ kms_key_arn }}"
          type = "{{ type }}"
        }
        revision_destination {
          bucket = "{{ bucket }}"
          key_pattern = "{{ key_pattern }}"
        }
      }
    }
    event {
      revision_published {
        data_set_id = "{{ data_set_id }}"
      }
    }
}
