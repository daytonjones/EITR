data "aws_s3_objects" "example" {
    bucket = "{{ bucket }}"
    delimiter = "{{ delimiter }}"
    encoding_type = "{{ encoding_type }}"
    fetch_owner = {{ fetch_owner }}
    id = "{{ id }}"
    max_keys = {{ max_keys }}
    prefix = "{{ prefix }}"
    region = "{{ region }}"
    request_payer = "{{ request_payer }}"
    start_after = "{{ start_after }}"
}
