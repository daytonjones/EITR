resource "aws_m2_deployment" "example" {
    application_id = "{{ application_id }}"
    application_version = {{ application_version }}
    environment_id = "{{ environment_id }}"
    force_stop = {{ force_stop }}
    region = "{{ region }}"
    start = {{ start }}
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
