data "aws_ec2_local_gateway_virtual_interface_group" "example" {
    id = "{{ id }}"
    local_gateway_id = "{{ local_gateway_id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
