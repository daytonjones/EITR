resource "aws_quicksight_vpc_connection" "example" {
    aws_account_id = "{{ aws_account_id }}"
    dns_resolvers = ["{{ dns_resolvers }}"]
    name = "{{ name }}"
    region = "{{ region }}"
    role_arn = "{{ role_arn }}"
    security_group_ids = ["{{ security_group_ids }}"]
    subnet_ids = ["{{ subnet_ids }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    vpc_connection_id = "{{ vpc_connection_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
