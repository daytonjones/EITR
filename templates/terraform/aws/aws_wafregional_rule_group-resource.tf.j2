resource "aws_wafregional_rule_group" "example" {
    id = "{{ id }}"
    metric_name = "{{ metric_name }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    activated_rule {
      priority = {{ priority }}
      rule_id = "{{ rule_id }}"
      type = "{{ type }}"
      action {
        type = "{{ type }}"
      }
    }
}
