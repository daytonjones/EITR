resource "aws_finspace_kx_scaling_group" "example" {
    availability_zone_id = "{{ availability_zone_id }}"
    environment_id = "{{ environment_id }}"
    host_type = "{{ host_type }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
