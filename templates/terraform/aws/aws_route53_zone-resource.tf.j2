resource "aws_route53_zone" "example" {
    comment = "{{ comment }}"
    delegation_set_id = "{{ delegation_set_id }}"
    enable_accelerated_recovery = {{ enable_accelerated_recovery }}
    force_destroy = {{ force_destroy }}
    id = "{{ id }}"
    name = "{{ name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    vpc {
      vpc_id = "{{ vpc_id }}"
      vpc_region = "{{ vpc_region }}"
    }
}
