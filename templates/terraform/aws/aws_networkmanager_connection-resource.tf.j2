resource "aws_networkmanager_connection" "example" {
    connected_device_id = "{{ connected_device_id }}"
    connected_link_id = "{{ connected_link_id }}"
    description = "{{ description }}"
    device_id = "{{ device_id }}"
    global_network_id = "{{ global_network_id }}"
    id = "{{ id }}"
    link_id = "{{ link_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
