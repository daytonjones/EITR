resource "aws_waf_rate_based_rule" "example" {
    id = "{{ id }}"
    metric_name = "{{ metric_name }}"
    name = "{{ name }}"
    rate_key = "{{ rate_key }}"
    rate_limit = {{ rate_limit }}
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    predicates {
      data_id = "{{ data_id }}"
      negated = {{ negated }}
      type = "{{ type }}"
    }
}
