resource "aws_transcribe_vocabulary" "example" {
    id = "{{ id }}"
    language_code = "{{ language_code }}"
    phrases = ["{{ phrases }}"]
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    vocabulary_file_uri = "{{ vocabulary_file_uri }}"
    vocabulary_name = "{{ vocabulary_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
