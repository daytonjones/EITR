resource "aws_lightsail_instance" "example" {
    availability_zone = "{{ availability_zone }}"
    blueprint_id = "{{ blueprint_id }}"
    bundle_id = "{{ bundle_id }}"
    id = "{{ id }}"
    ip_address_type = "{{ ip_address_type }}"
    key_pair_name = "{{ key_pair_name }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    user_data = "{{ user_data }}"
    add_on {
      snapshot_time = "{{ snapshot_time }}"
      status = "{{ status }}"
      type = "{{ type }}"
    }
}
