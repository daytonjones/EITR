resource "aws_datasync_location_nfs" "example" {
    id = "{{ id }}"
    region = "{{ region }}"
    server_hostname = "{{ server_hostname }}"
    subdirectory = "{{ subdirectory }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    mount_options {
      version = "{{ version }}"
    }
    on_prem_config {
      agent_arns = ["{{ agent_arns }}"]
    }
}
