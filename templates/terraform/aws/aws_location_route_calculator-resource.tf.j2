resource "aws_location_route_calculator" "example" {
    calculator_name = "{{ calculator_name }}"
    data_source = "{{ data_source }}"
    description = "{{ description }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
