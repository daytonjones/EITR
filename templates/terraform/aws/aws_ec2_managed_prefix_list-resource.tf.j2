resource "aws_ec2_managed_prefix_list" "example" {
    address_family = "{{ address_family }}"
    id = "{{ id }}"
    max_entries = {{ max_entries }}
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    entry {
      cidr = "{{ cidr }}"
      description = "{{ description }}"
    }
}
