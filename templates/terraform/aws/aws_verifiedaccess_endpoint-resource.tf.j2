resource "aws_verifiedaccess_endpoint" "example" {
    application_domain = "{{ application_domain }}"
    attachment_type = "{{ attachment_type }}"
    description = "{{ description }}"
    domain_certificate_arn = "{{ domain_certificate_arn }}"
    endpoint_domain_prefix = "{{ endpoint_domain_prefix }}"
    endpoint_type = "{{ endpoint_type }}"
    id = "{{ id }}"
    policy_document = "{{ policy_document }}"
    region = "{{ region }}"
    security_group_ids = ["{{ security_group_ids }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    verified_access_group_id = "{{ verified_access_group_id }}"
    cidr_options {
      cidr = "{{ cidr }}"
      protocol = "{{ protocol }}"
      subnet_ids = ["{{ subnet_ids }}"]
      port_range {
        from_port = {{ from_port }}
        to_port = {{ to_port }}
      }
    }
    load_balancer_options {
      load_balancer_arn = "{{ load_balancer_arn }}"
      port = {{ port }}
      protocol = "{{ protocol }}"
      subnet_ids = ["{{ subnet_ids }}"]
      port_range {
        from_port = {{ from_port }}
        to_port = {{ to_port }}
      }
    }
    network_interface_options {
      network_interface_id = "{{ network_interface_id }}"
      port = {{ port }}
      protocol = "{{ protocol }}"
      port_range {
        from_port = {{ from_port }}
        to_port = {{ to_port }}
      }
    }
    rds_options {
      port = {{ port }}
      protocol = "{{ protocol }}"
      rds_db_cluster_arn = "{{ rds_db_cluster_arn }}"
      rds_db_instance_arn = "{{ rds_db_instance_arn }}"
      rds_db_proxy_arn = "{{ rds_db_proxy_arn }}"
      rds_endpoint = "{{ rds_endpoint }}"
      subnet_ids = ["{{ subnet_ids }}"]
    }
    sse_specification {
      customer_managed_key_enabled = {{ customer_managed_key_enabled }}
      kms_key_arn = "{{ kms_key_arn }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
