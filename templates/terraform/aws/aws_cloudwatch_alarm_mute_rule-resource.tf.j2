resource "aws_cloudwatch_alarm_mute_rule" "example" {
    description = "{{ description }}"
    expire_date = "{{ expire_date }}"
    name = "{{ name }}"
    region = "{{ region }}"
    start_date = "{{ start_date }}"
    tags = {
        key = "{{ tags_value }}"
      }
    mute_targets {
      alarm_names = ["{{ alarm_names }}"]
    }
    rule {
      schedule {
        duration = "{{ duration }}"
        expression = "{{ expression }}"
        timezone = "{{ timezone }}"
      }
    }
}
