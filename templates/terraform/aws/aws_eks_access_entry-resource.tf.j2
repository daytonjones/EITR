resource "aws_eks_access_entry" "example" {
    cluster_name = "{{ cluster_name }}"
    id = "{{ id }}"
    kubernetes_groups = ["{{ kubernetes_groups }}"]
    principal_arn = "{{ principal_arn }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    type = "{{ type }}"
    user_name = "{{ user_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
