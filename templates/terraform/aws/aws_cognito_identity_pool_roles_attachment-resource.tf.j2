resource "aws_cognito_identity_pool_roles_attachment" "example" {
    id = "{{ id }}"
    identity_pool_id = "{{ identity_pool_id }}"
    region = "{{ region }}"
    roles = {
        key = "{{ roles_value }}"
      }
    role_mapping {
      ambiguous_role_resolution = "{{ ambiguous_role_resolution }}"
      identity_provider = "{{ identity_provider }}"
      type = "{{ type }}"
      mapping_rule {
        claim = "{{ claim }}"
        match_type = "{{ match_type }}"
        role_arn = "{{ role_arn }}"
        value = "{{ value }}"
      }
    }
}
