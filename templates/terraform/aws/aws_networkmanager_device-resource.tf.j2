resource "aws_networkmanager_device" "example" {
    description = "{{ description }}"
    global_network_id = "{{ global_network_id }}"
    id = "{{ id }}"
    model = "{{ model }}"
    serial_number = "{{ serial_number }}"
    site_id = "{{ site_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    type = "{{ type }}"
    vendor = "{{ vendor }}"
    aws_location {
      subnet_arn = "{{ subnet_arn }}"
      zone = "{{ zone }}"
    }
    location {
      address = "{{ address }}"
      latitude = "{{ latitude }}"
      longitude = "{{ longitude }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
