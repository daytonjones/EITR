resource "aws_prometheus_scraper" "example" {
    alias = "{{ alias }}"
    region = "{{ region }}"
    scrape_configuration = "{{ scrape_configuration }}"
    tags = {
        key = "{{ tags_value }}"
      }
    destination {
      amp {
        workspace_arn = "{{ workspace_arn }}"
      }
    }
    role_configuration {
      source_role_arn = "{{ source_role_arn }}"
      target_role_arn = "{{ target_role_arn }}"
    }
    source {
      eks {
        cluster_arn = "{{ cluster_arn }}"
        security_group_ids = ["{{ security_group_ids }}"]
        subnet_ids = ["{{ subnet_ids }}"]
      }
      vpc {
        security_group_ids = ["{{ security_group_ids }}"]
        subnet_ids = ["{{ subnet_ids }}"]
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
