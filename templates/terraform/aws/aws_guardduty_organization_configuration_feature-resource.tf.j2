resource "aws_guardduty_organization_configuration_feature" "example" {
    auto_enable = "{{ auto_enable }}"
    detector_id = "{{ detector_id }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    additional_configuration {
      auto_enable = "{{ auto_enable }}"
      name = "{{ name }}"
    }
}
