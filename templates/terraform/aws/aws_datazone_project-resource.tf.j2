resource "aws_datazone_project" "example" {
    description = "{{ description }}"
    domain_identifier = "{{ domain_identifier }}"
    glossary_terms = ["{{ glossary_terms }}"]
    name = "{{ name }}"
    region = "{{ region }}"
    skip_deletion_check = {{ skip_deletion_check }}
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
