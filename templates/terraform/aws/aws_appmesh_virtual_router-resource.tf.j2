resource "aws_appmesh_virtual_router" "example" {
    id = "{{ id }}"
    mesh_name = "{{ mesh_name }}"
    mesh_owner = "{{ mesh_owner }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    spec {
      listener {
        port_mapping {
          port = {{ port }}
          protocol = "{{ protocol }}"
        }
      }
    }
}
