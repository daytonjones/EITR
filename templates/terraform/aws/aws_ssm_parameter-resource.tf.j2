resource "aws_ssm_parameter" "example" {
    allowed_pattern = "{{ allowed_pattern }}"
    arn = "{{ arn }}"
    data_type = "{{ data_type }}"
    description = "{{ description }}"
    id = "{{ id }}"
    insecure_value = "{{ insecure_value }}"
    key_id = "{{ key_id }}"
    name = "{{ name }}"
    overwrite = {{ overwrite }}
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    tier = "{{ tier }}"
    type = "{{ type }}"
    value = "{{ value }}"
    value_wo = "{{ value_wo }}"
    value_wo_version = {{ value_wo_version }}
}
