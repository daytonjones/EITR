resource "aws_db_parameter_group" "example" {
    description = "{{ description }}"
    family = "{{ family }}"
    id = "{{ id }}"
    name = "{{ name }}"
    name_prefix = "{{ name_prefix }}"
    region = "{{ region }}"
    skip_destroy = {{ skip_destroy }}
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    parameter {
      apply_method = "{{ apply_method }}"
      name = "{{ name }}"
      value = "{{ value }}"
    }
}
