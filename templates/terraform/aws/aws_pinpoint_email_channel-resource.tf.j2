resource "aws_pinpoint_email_channel" "example" {
    application_id = "{{ application_id }}"
    configuration_set = "{{ configuration_set }}"
    enabled = {{ enabled }}
    from_address = "{{ from_address }}"
    id = "{{ id }}"
    identity = "{{ identity }}"
    orchestration_sending_role_arn = "{{ orchestration_sending_role_arn }}"
    region = "{{ region }}"
    role_arn = "{{ role_arn }}"
}
