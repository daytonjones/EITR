resource "aws_ec2_network_insights_analysis" "example" {
    filter_in_arns = ["{{ filter_in_arns }}"]
    id = "{{ id }}"
    network_insights_path_id = "{{ network_insights_path_id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    wait_for_completion = {{ wait_for_completion }}
}
