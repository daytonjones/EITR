resource "aws_ssoadmin_permission_set_inline_policy" "example" {
    id = "{{ id }}"
    inline_policy = "{{ inline_policy }}"
    instance_arn = "{{ instance_arn }}"
    permission_set_arn = "{{ permission_set_arn }}"
    region = "{{ region }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
