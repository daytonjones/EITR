resource "aws_vpc_ipv4_cidr_block_association" "example" {
    cidr_block = "{{ cidr_block }}"
    id = "{{ id }}"
    ipv4_ipam_pool_id = "{{ ipv4_ipam_pool_id }}"
    ipv4_netmask_length = {{ ipv4_netmask_length }}
    region = "{{ region }}"
    vpc_id = "{{ vpc_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
