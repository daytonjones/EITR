resource "aws_verifiedaccess_instance" "example" {
    cidr_endpoints_custom_subdomain = "{{ cidr_endpoints_custom_subdomain }}"
    description = "{{ description }}"
    fips_enabled = {{ fips_enabled }}
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
