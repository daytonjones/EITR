resource "aws_elasticache_user_group" "example" {
    engine = "{{ engine }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    user_group_id = "{{ user_group_id }}"
    user_ids = ["{{ user_ids }}"]
}
