resource "aws_devopsguru_service_integration" "example" {
    region = "{{ region }}"
    kms_server_side_encryption {
      kms_key_id = "{{ kms_key_id }}"
      opt_in_status = "{{ opt_in_status }}"
      type = "{{ type }}"
    }
