resource "aws_vpc_ipam" "example" {
    cascade = {{ cascade }}
    description = "{{ description }}"
    enable_private_gua = {{ enable_private_gua }}
    id = "{{ id }}"
    metered_account = "{{ metered_account }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    tier = "{{ tier }}"
    operating_regions {
      region_name = "{{ region_name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
