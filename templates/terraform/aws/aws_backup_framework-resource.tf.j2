resource "aws_backup_framework" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    control {
      name = "{{ name }}"
      input_parameter {
        name = "{{ name }}"
        value = "{{ value }}"
      }
      scope {
        compliance_resource_ids = ["{{ compliance_resource_ids }}"]
        compliance_resource_types = ["{{ compliance_resource_types }}"]
        tags = {
        key = "{{ tags_value }}"
      }
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
