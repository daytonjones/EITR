resource "aws_evidently_segment" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    pattern = "{{ pattern }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
