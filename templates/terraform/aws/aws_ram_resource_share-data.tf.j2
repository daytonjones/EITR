data "aws_ram_resource_share" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    resource_owner = "{{ resource_owner }}"
    resource_share_status = "{{ resource_share_status }}"
    tags = {
        key = "{{ tags_value }}"
      }
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
}
