resource "aws_appintegrations_event_integration" "example" {
    description = "{{ description }}"
    eventbridge_bus = "{{ eventbridge_bus }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    event_filter {
      source = "{{ source }}"
    }
}
