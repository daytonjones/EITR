resource "aws_sagemaker_training_job" "example" {
    delete_model_packages_on_destroy = {{ delete_model_packages_on_destroy }}
    delete_vpc_enis_on_destroy = {{ delete_vpc_enis_on_destroy }}
    enable_inter_container_traffic_encryption = {{ enable_inter_container_traffic_encryption }}
    enable_managed_spot_training = {{ enable_managed_spot_training }}
    enable_network_isolation = {{ enable_network_isolation }}
    environment = {
        key = "{{ environment_value }}"
      }
    hyper_parameters = {
        key = "{{ hyper_parameters_value }}"
      }
    region = "{{ region }}"
    role_arn = "{{ role_arn }}"
    tags = {
        key = "{{ tags_value }}"
      }
    training_job_name = "{{ training_job_name }}"
    algorithm_specification {
      algorithm_name = "{{ algorithm_name }}"
      container_arguments = ["{{ container_arguments }}"]
      container_entrypoint = ["{{ container_entrypoint }}"]
      enable_sagemaker_metrics_time_series = {{ enable_sagemaker_metrics_time_series }}
      training_image = "{{ training_image }}"
      training_input_mode = "{{ training_input_mode }}"
      metric_definitions {
        name = "{{ name }}"
        regex = "{{ regex }}"
      }
      training_image_config {
        training_repository_access_mode = "{{ training_repository_access_mode }}"
        training_repository_auth_config {
          training_repository_credentials_provider_arn = "{{ training_repository_credentials_provider_arn }}"
        }
      }
    }
    checkpoint_config {
      local_path = "{{ local_path }}"
      s3_uri = "{{ s3_uri }}"
    }
    debug_hook_config {
      hook_parameters = {
        key = "{{ hook_parameters_value }}"
      }
      local_path = "{{ local_path }}"
      s3_output_path = "{{ s3_output_path }}"
      collection_configurations {
        collection_name = "{{ collection_name }}"
        collection_parameters = {
        key = "{{ collection_parameters_value }}"
      }
      }
    }
    debug_rule_configurations {
      instance_type = "{{ instance_type }}"
      local_path = "{{ local_path }}"
      rule_configuration_name = "{{ rule_configuration_name }}"
      rule_evaluator_image = "{{ rule_evaluator_image }}"
      rule_parameters = {
        key = "{{ rule_parameters_value }}"
      }
      s3_output_path = "{{ s3_output_path }}"
      volume_size_in_gb = {{ volume_size_in_gb }}
    }
    experiment_config {
      experiment_name = "{{ experiment_name }}"
      run_name = "{{ run_name }}"
      trial_component_display_name = "{{ trial_component_display_name }}"
      trial_name = "{{ trial_name }}"
    }
    infra_check_config {
      enable_infra_check = {{ enable_infra_check }}
    }
    input_data_config {
      channel_name = "{{ channel_name }}"
      compression_type = "{{ compression_type }}"
      content_type = "{{ content_type }}"
      input_mode = "{{ input_mode }}"
      record_wrapper_type = "{{ record_wrapper_type }}"
      data_source {
        file_system_data_source {
          directory_path = "{{ directory_path }}"
          file_system_access_mode = "{{ file_system_access_mode }}"
          file_system_id = "{{ file_system_id }}"
          file_system_type = "{{ file_system_type }}"
        }
        s3_data_source {
          attribute_names = ["{{ attribute_names }}"]
          instance_group_names = ["{{ instance_group_names }}"]
          s3_data_distribution_type = "{{ s3_data_distribution_type }}"
          s3_data_type = "{{ s3_data_type }}"
          s3_uri = "{{ s3_uri }}"
          hub_access_config {
            hub_content_arn = "{{ hub_content_arn }}"
          }
          model_access_config {
            accept_eula = {{ accept_eula }}
          }
        }
      }
      shuffle_config {
        seed = {{ seed }}
      }
    }
    mlflow_config {
      mlflow_experiment_name = "{{ mlflow_experiment_name }}"
      mlflow_resource_arn = "{{ mlflow_resource_arn }}"
      mlflow_run_name = "{{ mlflow_run_name }}"
    }
    model_package_config {
      model_package_group_arn = "{{ model_package_group_arn }}"
      source_model_package_arn = "{{ source_model_package_arn }}"
    }
    output_data_config {
      compression_type = "{{ compression_type }}"
      kms_key_id = "{{ kms_key_id }}"
      s3_output_path = "{{ s3_output_path }}"
    }
    profiler_config {
      disable_profiler = {{ disable_profiler }}
      profiling_interval_in_milliseconds = {{ profiling_interval_in_milliseconds }}
      profiling_parameters = {
        key = "{{ profiling_parameters_value }}"
      }
      s3_output_path = "{{ s3_output_path }}"
    }
    profiler_rule_configurations {
      instance_type = "{{ instance_type }}"
      local_path = "{{ local_path }}"
      rule_configuration_name = "{{ rule_configuration_name }}"
      rule_evaluator_image = "{{ rule_evaluator_image }}"
      rule_parameters = {
        key = "{{ rule_parameters_value }}"
      }
      s3_output_path = "{{ s3_output_path }}"
      volume_size_in_gb = {{ volume_size_in_gb }}
    }
    remote_debug_config {
      enable_remote_debug = {{ enable_remote_debug }}
    }
    resource_config {
      instance_count = {{ instance_count }}
      instance_type = "{{ instance_type }}"
      keep_alive_period_in_seconds = {{ keep_alive_period_in_seconds }}
      training_plan_arn = "{{ training_plan_arn }}"
      volume_kms_key_id = "{{ volume_kms_key_id }}"
      volume_size_in_gb = {{ volume_size_in_gb }}
      instance_groups {
        instance_count = {{ instance_count }}
        instance_group_name = "{{ instance_group_name }}"
        instance_type = "{{ instance_type }}"
      }
      instance_placement_config {
        enable_multiple_jobs = {{ enable_multiple_jobs }}
        placement_specifications {
          instance_count = {{ instance_count }}
          ultra_server_id = "{{ ultra_server_id }}"
        }
      }
    }
    retry_strategy {
      maximum_retry_attempts = {{ maximum_retry_attempts }}
    }
    serverless_job_config {
      accept_eula = {{ accept_eula }}
      base_model_arn = "{{ base_model_arn }}"
      customization_technique = "{{ customization_technique }}"
      evaluation_type = "{{ evaluation_type }}"
      evaluator_arn = "{{ evaluator_arn }}"
      job_type = "{{ job_type }}"
      peft = "{{ peft }}"
    }
    session_chaining_config {
      enable_session_tag_chaining = {{ enable_session_tag_chaining }}
    }
    stopping_condition {
      max_pending_time_in_seconds = {{ max_pending_time_in_seconds }}
      max_runtime_in_seconds = {{ max_runtime_in_seconds }}
      max_wait_time_in_seconds = {{ max_wait_time_in_seconds }}
    }
    tensor_board_output_config {
      local_path = "{{ local_path }}"
      s3_output_path = "{{ s3_output_path }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    vpc_config {
      security_group_ids = ["{{ security_group_ids }}"]
      subnets = ["{{ subnets }}"]
    }
}
