resource "aws_route_table" "example" {
    id = "{{ id }}"
    propagating_vgws = ["{{ propagating_vgws }}"]
    region = "{{ region }}"
    route = ["{{ route }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    vpc_id = "{{ vpc_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
