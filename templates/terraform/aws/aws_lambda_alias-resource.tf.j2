resource "aws_lambda_alias" "example" {
    description = "{{ description }}"
    function_name = "{{ function_name }}"
    function_version = "{{ function_version }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    routing_config {
      additional_version_weights = {
        key = "{{ additional_version_weights_value }}"
      }
    }
}
