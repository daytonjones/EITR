resource "aws_codebuild_report_group" "example" {
    delete_reports = {{ delete_reports }}
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    type = "{{ type }}"
    export_config {
      type = "{{ type }}"
      s3_destination {
        bucket = "{{ bucket }}"
        encryption_disabled = {{ encryption_disabled }}
        encryption_key = "{{ encryption_key }}"
        packaging = "{{ packaging }}"
        path = "{{ path }}"
      }
    }
}
