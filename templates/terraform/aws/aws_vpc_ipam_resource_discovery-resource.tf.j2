resource "aws_vpc_ipam_resource_discovery" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    operating_regions {
      region_name = "{{ region_name }}"
    }
    organizational_unit_exclusion {
      organizations_entity_path = "{{ organizations_entity_path }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
