resource "aws_signer_signing_job" "example" {
    id = "{{ id }}"
    ignore_signing_job_failure = {{ ignore_signing_job_failure }}
    profile_name = "{{ profile_name }}"
    region = "{{ region }}"
    destination {
      s3 {
        bucket = "{{ bucket }}"
        prefix = "{{ prefix }}"
      }
    }
    source {
      s3 {
        bucket = "{{ bucket }}"
        key = "{{ key }}"
        version = "{{ version }}"
      }
    }
}
