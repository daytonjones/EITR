resource "aws_apigatewayv2_route_response" "example" {
    api_id = "{{ api_id }}"
    id = "{{ id }}"
    model_selection_expression = "{{ model_selection_expression }}"
    region = "{{ region }}"
    response_models = {
        key = "{{ response_models_value }}"
      }
    route_id = "{{ route_id }}"
    route_response_key = "{{ route_response_key }}"
}
