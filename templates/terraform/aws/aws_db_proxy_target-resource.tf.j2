resource "aws_db_proxy_target" "example" {
    db_cluster_identifier = "{{ db_cluster_identifier }}"
    db_instance_identifier = "{{ db_instance_identifier }}"
    db_proxy_name = "{{ db_proxy_name }}"
    id = "{{ id }}"
    region = "{{ region }}"
    target_group_name = "{{ target_group_name }}"
}
