resource "aws_datasync_location_fsx_openzfs_file_system" "example" {
    fsx_filesystem_arn = "{{ fsx_filesystem_arn }}"
    id = "{{ id }}"
    region = "{{ region }}"
    security_group_arns = ["{{ security_group_arns }}"]
    subdirectory = "{{ subdirectory }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    protocol {
      nfs {
        mount_options {
          version = "{{ version }}"
        }
      }
    }
}
