resource "aws_codegurureviewer_repository_association" "example" {
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    kms_key_details {
      encryption_option = "{{ encryption_option }}"
      kms_key_id = "{{ kms_key_id }}"
    }
    repository {
      bitbucket {
        connection_arn = "{{ connection_arn }}"
        name = "{{ name }}"
        owner = "{{ owner }}"
      }
      codecommit {
        name = "{{ name }}"
      }
      github_enterprise_server {
        connection_arn = "{{ connection_arn }}"
        name = "{{ name }}"
        owner = "{{ owner }}"
      }
      s3_bucket {
        bucket_name = "{{ bucket_name }}"
        name = "{{ name }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
