resource "aws_wafregional_sql_injection_match_set" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    sql_injection_match_tuple {
      text_transformation = "{{ text_transformation }}"
      field_to_match {
        data = "{{ data }}"
        type = "{{ type }}"
      }
    }
}
