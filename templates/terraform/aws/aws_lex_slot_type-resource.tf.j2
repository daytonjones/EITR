resource "aws_lex_slot_type" "example" {
    create_version = {{ create_version }}
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    value_selection_strategy = "{{ value_selection_strategy }}"
    enumeration_value {
      synonyms = ["{{ synonyms }}"]
      value = "{{ value }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
