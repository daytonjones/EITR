resource "aws_s3_bucket_inventory" "example" {
    bucket = "{{ bucket }}"
    enabled = {{ enabled }}
    id = "{{ id }}"
    included_object_versions = "{{ included_object_versions }}"
    name = "{{ name }}"
    optional_fields = ["{{ optional_fields }}"]
    region = "{{ region }}"
    destination {
      bucket {
        account_id = "{{ account_id }}"
        bucket_arn = "{{ bucket_arn }}"
        format = "{{ format }}"
        prefix = "{{ prefix }}"
        encryption {
          sse_kms {
            key_id = "{{ key_id }}"
          }
          sse_s3 {
          }
        }
      }
    }
    filter {
      prefix = "{{ prefix }}"
    }
    schedule {
      frequency = "{{ frequency }}"
    }
}
