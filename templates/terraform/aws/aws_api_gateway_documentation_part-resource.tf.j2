resource "aws_api_gateway_documentation_part" "example" {
    id = "{{ id }}"
    properties = "{{ properties }}"
    region = "{{ region }}"
    rest_api_id = "{{ rest_api_id }}"
    location {
      method = "{{ method }}"
      name = "{{ name }}"
      path = "{{ path }}"
      status_code = "{{ status_code }}"
      type = "{{ type }}"
    }
}
