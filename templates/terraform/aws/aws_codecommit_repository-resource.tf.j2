resource "aws_codecommit_repository" "example" {
    default_branch = "{{ default_branch }}"
    description = "{{ description }}"
    id = "{{ id }}"
    kms_key_id = "{{ kms_key_id }}"
    region = "{{ region }}"
    repository_name = "{{ repository_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
