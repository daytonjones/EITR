resource "aws_cognito_resource_server" "example" {
    id = "{{ id }}"
    identifier = "{{ identifier }}"
    name = "{{ name }}"
    region = "{{ region }}"
    user_pool_id = "{{ user_pool_id }}"
    scope {
      scope_description = "{{ scope_description }}"
      scope_name = "{{ scope_name }}"
    }
}
