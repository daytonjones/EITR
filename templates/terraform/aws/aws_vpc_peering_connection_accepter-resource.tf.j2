resource "aws_vpc_peering_connection_accepter" "example" {
    auto_accept = {{ auto_accept }}
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    vpc_peering_connection_id = "{{ vpc_peering_connection_id }}"
    accepter {
      allow_remote_vpc_dns_resolution = {{ allow_remote_vpc_dns_resolution }}
    }
    requester {
      allow_remote_vpc_dns_resolution = {{ allow_remote_vpc_dns_resolution }}
    }
    timeouts {
      create = "{{ create }}"
      update = "{{ update }}"
    }
}
