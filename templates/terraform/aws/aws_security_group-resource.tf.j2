resource "aws_security_group" "example" {
    description = "{{ description }}"
    egress = ["{{ egress }}"]
    id = "{{ id }}"
    ingress = ["{{ ingress }}"]
    name = "{{ name }}"
    name_prefix = "{{ name_prefix }}"
    region = "{{ region }}"
    revoke_rules_on_delete = {{ revoke_rules_on_delete }}
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    vpc_id = "{{ vpc_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
