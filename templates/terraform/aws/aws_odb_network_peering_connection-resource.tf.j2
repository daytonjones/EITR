resource "aws_odb_network_peering_connection" "example" {
    display_name = "{{ display_name }}"
    odb_network_arn = "{{ odb_network_arn }}"
    odb_network_id = "{{ odb_network_id }}"
    peer_network_cidrs = ["{{ peer_network_cidrs }}"]
    peer_network_id = "{{ peer_network_id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
