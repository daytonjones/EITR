resource "aws_msk_serverless_cluster" "example" {
    cluster_name = "{{ cluster_name }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    client_authentication {
      sasl {
        iam {
          enabled = {{ enabled }}
        }
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
    vpc_config {
      security_group_ids = ["{{ security_group_ids }}"]
      subnet_ids = ["{{ subnet_ids }}"]
    }
}
