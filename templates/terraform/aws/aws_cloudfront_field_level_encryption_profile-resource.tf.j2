resource "aws_cloudfront_field_level_encryption_profile" "example" {
    comment = "{{ comment }}"
    id = "{{ id }}"
    name = "{{ name }}"
    encryption_entities {
      items {
        provider_id = "{{ provider_id }}"
        public_key_id = "{{ public_key_id }}"
        field_patterns {
          items = ["{{ items }}"]
        }
      }
    }
}
