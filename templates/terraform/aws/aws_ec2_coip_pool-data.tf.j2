data "aws_ec2_coip_pool" "example" {
    id = "{{ id }}"
    local_gateway_route_table_id = "{{ local_gateway_route_table_id }}"
    pool_id = "{{ pool_id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
