resource "aws_route53profiles_association" "example" {
    name = "{{ name }}"
    profile_id = "{{ profile_id }}"
    region = "{{ region }}"
    resource_id = "{{ resource_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
