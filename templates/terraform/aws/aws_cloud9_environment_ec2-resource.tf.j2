resource "aws_cloud9_environment_ec2" "example" {
    automatic_stop_time_minutes = {{ automatic_stop_time_minutes }}
    connection_type = "{{ connection_type }}"
    description = "{{ description }}"
    id = "{{ id }}"
    image_id = "{{ image_id }}"
    instance_type = "{{ instance_type }}"
    name = "{{ name }}"
    owner_arn = "{{ owner_arn }}"
    region = "{{ region }}"
    subnet_id = "{{ subnet_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
