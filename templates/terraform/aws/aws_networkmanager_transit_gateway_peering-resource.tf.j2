resource "aws_networkmanager_transit_gateway_peering" "example" {
    core_network_id = "{{ core_network_id }}"
    id = "{{ id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    transit_gateway_arn = "{{ transit_gateway_arn }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
