resource "aws_iam_user" "example" {
    force_destroy = {{ force_destroy }}
    id = "{{ id }}"
    name = "{{ name }}"
    path = "{{ path }}"
    permissions_boundary = "{{ permissions_boundary }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
