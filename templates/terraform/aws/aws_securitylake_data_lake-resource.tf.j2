resource "aws_securitylake_data_lake" "example" {
    meta_store_manager_role_arn = "{{ meta_store_manager_role_arn }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    configuration {
      encryption_configuration = ["{{ encryption_configuration }}"]
      region = "{{ region }}"
      lifecycle_configuration {
        expiration {
          days = {{ days }}
        }
        transition {
          days = {{ days }}
          storage_class = "{{ storage_class }}"
        }
      }
      replication_configuration {
        regions = ["{{ regions }}"]
        role_arn = "{{ role_arn }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
