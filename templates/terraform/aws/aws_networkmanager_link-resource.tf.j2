resource "aws_networkmanager_link" "example" {
    description = "{{ description }}"
    global_network_id = "{{ global_network_id }}"
    id = "{{ id }}"
    provider_name = "{{ provider_name }}"
    site_id = "{{ site_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    type = "{{ type }}"
    bandwidth {
      download_speed = {{ download_speed }}
      upload_speed = {{ upload_speed }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
