resource "aws_emrcontainers_virtual_cluster" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    container_provider {
      id = "{{ id }}"
      type = "{{ type }}"
      info {
        eks_info {
          namespace = "{{ namespace }}"
        }
      }
    }
    timeouts {
      delete = "{{ delete }}"
    }
}
