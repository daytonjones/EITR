resource "aws_glue_partition_index" "example" {
    catalog_id = "{{ catalog_id }}"
    database_name = "{{ database_name }}"
    id = "{{ id }}"
    region = "{{ region }}"
    table_name = "{{ table_name }}"
    partition_index {
      index_name = "{{ index_name }}"
      keys = ["{{ keys }}"]
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
