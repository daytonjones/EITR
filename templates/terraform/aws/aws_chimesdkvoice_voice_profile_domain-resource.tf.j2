resource "aws_chimesdkvoice_voice_profile_domain" "example" {
    description = "{{ description }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    server_side_encryption_configuration {
      kms_key_arn = "{{ kms_key_arn }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
