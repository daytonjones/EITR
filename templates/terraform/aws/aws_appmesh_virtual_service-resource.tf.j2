resource "aws_appmesh_virtual_service" "example" {
    id = "{{ id }}"
    mesh_name = "{{ mesh_name }}"
    mesh_owner = "{{ mesh_owner }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    spec {
      provider {
        virtual_node {
          virtual_node_name = "{{ virtual_node_name }}"
        }
        virtual_router {
          virtual_router_name = "{{ virtual_router_name }}"
        }
      }
    }
}
