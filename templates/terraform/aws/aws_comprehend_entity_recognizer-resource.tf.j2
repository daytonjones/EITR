resource "aws_comprehend_entity_recognizer" "example" {
    data_access_role_arn = "{{ data_access_role_arn }}"
    id = "{{ id }}"
    language_code = "{{ language_code }}"
    model_kms_key_id = "{{ model_kms_key_id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    version_name = "{{ version_name }}"
    version_name_prefix = "{{ version_name_prefix }}"
    volume_kms_key_id = "{{ volume_kms_key_id }}"
    input_data_config {
      data_format = "{{ data_format }}"
      annotations {
        s3_uri = "{{ s3_uri }}"
        test_s3_uri = "{{ test_s3_uri }}"
      }
      augmented_manifests {
        annotation_data_s3_uri = "{{ annotation_data_s3_uri }}"
        attribute_names = ["{{ attribute_names }}"]
        document_type = "{{ document_type }}"
        s3_uri = "{{ s3_uri }}"
        source_documents_s3_uri = "{{ source_documents_s3_uri }}"
        split = "{{ split }}"
      }
      documents {
        input_format = "{{ input_format }}"
        s3_uri = "{{ s3_uri }}"
        test_s3_uri = "{{ test_s3_uri }}"
      }
      entity_list {
        s3_uri = "{{ s3_uri }}"
      }
      entity_types {
        type = "{{ type }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    vpc_config {
      security_group_ids = ["{{ security_group_ids }}"]
      subnets = ["{{ subnets }}"]
    }
}
