resource "aws_elastic_beanstalk_application" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    appversion_lifecycle {
      delete_source_from_s3 = {{ delete_source_from_s3 }}
      max_age_in_days = {{ max_age_in_days }}
      max_count = {{ max_count }}
      service_role = "{{ service_role }}"
    }
}
