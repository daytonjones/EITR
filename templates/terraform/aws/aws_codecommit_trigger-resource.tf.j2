resource "aws_codecommit_trigger" "example" {
    id = "{{ id }}"
    region = "{{ region }}"
    repository_name = "{{ repository_name }}"
    trigger {
      branches = ["{{ branches }}"]
      custom_data = "{{ custom_data }}"
      destination_arn = "{{ destination_arn }}"
      events = ["{{ events }}"]
      name = "{{ name }}"
    }
}
