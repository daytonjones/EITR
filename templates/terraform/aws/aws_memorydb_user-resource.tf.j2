resource "aws_memorydb_user" "example" {
    access_string = "{{ access_string }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    user_name = "{{ user_name }}"
    authentication_mode {
      passwords = ["{{ passwords }}"]
      type = "{{ type }}"
    }
}
