resource "aws_ses_configuration_set" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    reputation_metrics_enabled = {{ reputation_metrics_enabled }}
    sending_enabled = {{ sending_enabled }}
    delivery_options {
      tls_policy = "{{ tls_policy }}"
    }
    tracking_options {
      custom_redirect_domain = "{{ custom_redirect_domain }}"
    }
}
