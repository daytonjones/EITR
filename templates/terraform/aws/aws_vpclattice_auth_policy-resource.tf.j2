resource "aws_vpclattice_auth_policy" "example" {
    id = "{{ id }}"
    policy = "{{ policy }}"
    region = "{{ region }}"
    resource_identifier = "{{ resource_identifier }}"
    state = "{{ state }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
