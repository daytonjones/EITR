resource "aws_route53_resolver_firewall_rule_group_association" "example" {
    firewall_rule_group_id = "{{ firewall_rule_group_id }}"
    id = "{{ id }}"
    mutation_protection = "{{ mutation_protection }}"
    name = "{{ name }}"
    priority = {{ priority }}
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    vpc_id = "{{ vpc_id }}"
}
