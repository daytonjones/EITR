resource "aws_network_interface_sg_attachment" "example" {
    id = "{{ id }}"
    network_interface_id = "{{ network_interface_id }}"
    region = "{{ region }}"
    security_group_id = "{{ security_group_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
    }
}
