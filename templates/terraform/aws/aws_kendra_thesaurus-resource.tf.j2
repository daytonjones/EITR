resource "aws_kendra_thesaurus" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    index_id = "{{ index_id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    role_arn = "{{ role_arn }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    source_s3_path {
      bucket = "{{ bucket }}"
      key = "{{ key }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
