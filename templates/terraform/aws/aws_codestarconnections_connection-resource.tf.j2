resource "aws_codestarconnections_connection" "example" {
    host_arn = "{{ host_arn }}"
    id = "{{ id }}"
    name = "{{ name }}"
    provider_type = "{{ provider_type }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
