resource "aws_connect_hours_of_operation" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    instance_id = "{{ instance_id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    time_zone = "{{ time_zone }}"
    config {
      day = "{{ day }}"
      end_time {
        hours = {{ hours }}
        minutes = {{ minutes }}
      }
      start_time {
        hours = {{ hours }}
        minutes = {{ minutes }}
      }
    }
}
