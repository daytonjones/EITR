resource "aws_lambda_code_signing_config" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    allowed_publishers {
      signing_profile_version_arns = ["{{ signing_profile_version_arns }}"]
    }
    policies {
      untrusted_artifact_on_deployment = "{{ untrusted_artifact_on_deployment }}"
    }
}
