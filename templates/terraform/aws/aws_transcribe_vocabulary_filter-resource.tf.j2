resource "aws_transcribe_vocabulary_filter" "example" {
    id = "{{ id }}"
    language_code = "{{ language_code }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    vocabulary_filter_file_uri = "{{ vocabulary_filter_file_uri }}"
    vocabulary_filter_name = "{{ vocabulary_filter_name }}"
    words = ["{{ words }}"]
}
