ephemeral "aws_kms_secrets" "example" {
    region = "{{ region }}"
    secret {
      context = {
        key = "{{ context_value }}"
      }
      encryption_algorithm = "{{ encryption_algorithm }}"
      grant_tokens = ["{{ grant_tokens }}"]
      key_id = "{{ key_id }}"
      name = "{{ name }}"
      payload = "{{ payload }}"
    }
}
