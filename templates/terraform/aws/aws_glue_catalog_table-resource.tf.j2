resource "aws_glue_catalog_table" "example" {
    catalog_id = "{{ catalog_id }}"
    database_name = "{{ database_name }}"
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    owner = "{{ owner }}"
    parameters = {
        key = "{{ parameters_value }}"
      }
    region = "{{ region }}"
    retention = {{ retention }}
    table_type = "{{ table_type }}"
    view_expanded_text = "{{ view_expanded_text }}"
    view_original_text = "{{ view_original_text }}"
    open_table_format_input {
      iceberg_input {
        metadata_operation = "{{ metadata_operation }}"
        version = "{{ version }}"
        iceberg_table_input {
          location = "{{ location }}"
          properties = {
        key = "{{ properties_value }}"
      }
          partition_spec {
            spec_id = {{ spec_id }}
            fields {
              field_id = {{ field_id }}
              name = "{{ name }}"
              source_id = {{ source_id }}
              transform = "{{ transform }}"
            }
          }
          schema {
            identifier_field_ids = ["{{ identifier_field_ids }}"]
            schema_id = {{ schema_id }}
            type = "{{ type }}"
            fields {
              doc = "{{ doc }}"
              id = {{ id }}
              initial_default = "{{ initial_default }}"
              name = "{{ name }}"
              required = {{ required }}
              type = "{{ type }}"
              write_default = "{{ write_default }}"
            }
          }
          sort_order {
            order_id = {{ order_id }}
            fields {
              direction = "{{ direction }}"
              null_order = "{{ null_order }}"
              source_id = {{ source_id }}
              transform = "{{ transform }}"
            }
          }
        }
      }
    }
    partition_index {
      index_name = "{{ index_name }}"
      keys = ["{{ keys }}"]
    }
    partition_keys {
      comment = "{{ comment }}"
      name = "{{ name }}"
      parameters = {
        key = "{{ parameters_value }}"
      }
      type = "{{ type }}"
    }
    storage_descriptor {
      additional_locations = ["{{ additional_locations }}"]
      bucket_columns = ["{{ bucket_columns }}"]
      compressed = {{ compressed }}
      input_format = "{{ input_format }}"
      location = "{{ location }}"
      number_of_buckets = {{ number_of_buckets }}
      output_format = "{{ output_format }}"
      parameters = {
        key = "{{ parameters_value }}"
      }
      stored_as_sub_directories = {{ stored_as_sub_directories }}
      columns {
        comment = "{{ comment }}"
        name = "{{ name }}"
        parameters = {
        key = "{{ parameters_value }}"
      }
        type = "{{ type }}"
      }
      schema_reference {
        schema_version_id = "{{ schema_version_id }}"
        schema_version_number = {{ schema_version_number }}
        schema_id {
          registry_name = "{{ registry_name }}"
          schema_arn = "{{ schema_arn }}"
          schema_name = "{{ schema_name }}"
        }
      }
      ser_de_info {
        name = "{{ name }}"
        parameters = {
        key = "{{ parameters_value }}"
      }
        serialization_library = "{{ serialization_library }}"
      }
      skewed_info {
        skewed_column_names = ["{{ skewed_column_names }}"]
        skewed_column_value_location_maps = {
        key = "{{ skewed_column_value_location_maps_value }}"
      }
        skewed_column_values = ["{{ skewed_column_values }}"]
      }
      sort_columns {
        column = "{{ column }}"
        sort_order = {{ sort_order }}
      }
    }
    target_table {
      catalog_id = "{{ catalog_id }}"
      database_name = "{{ database_name }}"
      name = "{{ name }}"
      region = "{{ region }}"
    }
    view_definition {
      definer = "{{ definer }}"
      is_protected = {{ is_protected }}
      last_refresh_type = "{{ last_refresh_type }}"
      refresh_seconds = {{ refresh_seconds }}
      sub_object_version_ids = ["{{ sub_object_version_ids }}"]
      sub_objects = ["{{ sub_objects }}"]
      view_version_id = {{ view_version_id }}
      view_version_token = "{{ view_version_token }}"
      representations {
        dialect = "{{ dialect }}"
        dialect_version = "{{ dialect_version }}"
        validation_connection = "{{ validation_connection }}"
        view_expanded_text = "{{ view_expanded_text }}"
        view_original_text = "{{ view_original_text }}"
      }
    }
}
