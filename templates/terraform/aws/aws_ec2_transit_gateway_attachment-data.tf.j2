data "aws_ec2_transit_gateway_attachment" "example" {
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    transit_gateway_attachment_id = "{{ transit_gateway_attachment_id }}"
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
}
