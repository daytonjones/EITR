data "aws_route_table" "example" {
    gateway_id = "{{ gateway_id }}"
    id = "{{ id }}"
    region = "{{ region }}"
    route_table_id = "{{ route_table_id }}"
    subnet_id = "{{ subnet_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    vpc_id = "{{ vpc_id }}"
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
