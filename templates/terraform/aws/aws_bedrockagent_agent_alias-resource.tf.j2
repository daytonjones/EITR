resource "aws_bedrockagent_agent_alias" "example" {
    agent_alias_name = "{{ agent_alias_name }}"
    agent_id = "{{ agent_id }}"
    description = "{{ description }}"
    region = "{{ region }}"
    routing_configuration = ["{{ routing_configuration }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
