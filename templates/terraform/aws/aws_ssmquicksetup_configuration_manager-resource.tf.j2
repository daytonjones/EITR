resource "aws_ssmquicksetup_configuration_manager" "example" {
    description = "{{ description }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    configuration_definition {
      local_deployment_administration_role_arn = "{{ local_deployment_administration_role_arn }}"
      local_deployment_execution_role_name = "{{ local_deployment_execution_role_name }}"
      parameters = {
        key = "{{ parameters_value }}"
      }
      type = "{{ type }}"
      type_version = "{{ type_version }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
