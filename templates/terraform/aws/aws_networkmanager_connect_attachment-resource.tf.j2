resource "aws_networkmanager_connect_attachment" "example" {
    core_network_id = "{{ core_network_id }}"
    edge_location = "{{ edge_location }}"
    id = "{{ id }}"
    routing_policy_label = "{{ routing_policy_label }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    transport_attachment_id = "{{ transport_attachment_id }}"
    options {
      protocol = "{{ protocol }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
