resource "aws_codepipeline" "example" {
    execution_mode = "{{ execution_mode }}"
    id = "{{ id }}"
    name = "{{ name }}"
    pipeline_type = "{{ pipeline_type }}"
    region = "{{ region }}"
    role_arn = "{{ role_arn }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    artifact_store {
      location = "{{ location }}"
      region = "{{ region }}"
      type = "{{ type }}"
      encryption_key {
        id = "{{ id }}"
        type = "{{ type }}"
      }
    }
    stage {
      name = "{{ name }}"
      action {
        category = "{{ category }}"
        configuration = {
        key = "{{ configuration_value }}"
      }
        input_artifacts = ["{{ input_artifacts }}"]
        name = "{{ name }}"
        namespace = "{{ namespace }}"
        output_artifacts = ["{{ output_artifacts }}"]
        owner = "{{ owner }}"
        provider = "{{ provider }}"
        region = "{{ region }}"
        role_arn = "{{ role_arn }}"
        run_order = {{ run_order }}
        timeout_in_minutes = {{ timeout_in_minutes }}
        version = "{{ version }}"
      }
      before_entry {
        condition {
          result = "{{ result }}"
          rule {
            commands = ["{{ commands }}"]
            configuration = {
        key = "{{ configuration_value }}"
      }
            input_artifacts = ["{{ input_artifacts }}"]
            name = "{{ name }}"
            region = "{{ region }}"
            role_arn = "{{ role_arn }}"
            timeout_in_minutes = {{ timeout_in_minutes }}
            rule_type_id {
              category = "{{ category }}"
              owner = "{{ owner }}"
              provider = "{{ provider }}"
              version = "{{ version }}"
            }
          }
        }
      }
      on_failure {
        result = "{{ result }}"
        condition {
          result = "{{ result }}"
          rule {
            commands = ["{{ commands }}"]
            configuration = {
        key = "{{ configuration_value }}"
      }
            input_artifacts = ["{{ input_artifacts }}"]
            name = "{{ name }}"
            region = "{{ region }}"
            role_arn = "{{ role_arn }}"
            timeout_in_minutes = {{ timeout_in_minutes }}
            rule_type_id {
              category = "{{ category }}"
              owner = "{{ owner }}"
              provider = "{{ provider }}"
              version = "{{ version }}"
            }
          }
        }
        retry_configuration {
          retry_mode = "{{ retry_mode }}"
        }
      }
      on_success {
        condition {
          result = "{{ result }}"
          rule {
            commands = ["{{ commands }}"]
            configuration = {
        key = "{{ configuration_value }}"
      }
            input_artifacts = ["{{ input_artifacts }}"]
            name = "{{ name }}"
            region = "{{ region }}"
            role_arn = "{{ role_arn }}"
            timeout_in_minutes = {{ timeout_in_minutes }}
            rule_type_id {
              category = "{{ category }}"
              owner = "{{ owner }}"
              provider = "{{ provider }}"
              version = "{{ version }}"
            }
          }
        }
      }
    }
    trigger {
      provider_type = "{{ provider_type }}"
      git_configuration {
        source_action_name = "{{ source_action_name }}"
        pull_request {
          events = ["{{ events }}"]
          branches {
            excludes = ["{{ excludes }}"]
            includes = ["{{ includes }}"]
          }
          file_paths {
            excludes = ["{{ excludes }}"]
            includes = ["{{ includes }}"]
          }
        }
        push {
          branches {
            excludes = ["{{ excludes }}"]
            includes = ["{{ includes }}"]
          }
          file_paths {
            excludes = ["{{ excludes }}"]
            includes = ["{{ includes }}"]
          }
          tags {
            excludes = ["{{ excludes }}"]
            includes = ["{{ includes }}"]
          }
        }
      }
    }
    variable {
      default_value = "{{ default_value }}"
      description = "{{ description }}"
      name = "{{ name }}"
    }
}
