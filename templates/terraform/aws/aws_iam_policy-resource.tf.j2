resource "aws_iam_policy" "example" {
    delay_after_policy_creation_in_ms = {{ delay_after_policy_creation_in_ms }}
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    name_prefix = "{{ name_prefix }}"
    path = "{{ path }}"
    policy = "{{ policy }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
