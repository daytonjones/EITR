resource "aws_s3_bucket_acl" "example" {
    acl = "{{ acl }}"
    bucket = "{{ bucket }}"
    expected_bucket_owner = "{{ expected_bucket_owner }}"
    id = "{{ id }}"
    region = "{{ region }}"
    access_control_policy {
      grant {
        permission = "{{ permission }}"
        grantee {
          email_address = "{{ email_address }}"
          id = "{{ id }}"
          type = "{{ type }}"
          uri = "{{ uri }}"
        }
      }
      owner {
        display_name = "{{ display_name }}"
        id = "{{ id }}"
      }
    }
}
