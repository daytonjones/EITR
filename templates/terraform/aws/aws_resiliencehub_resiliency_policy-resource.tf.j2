resource "aws_resiliencehub_resiliency_policy" "example" {
    data_location_constraint = "{{ data_location_constraint }}"
    description = "{{ description }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tier = "{{ tier }}"
    policy {
      az {
        rpo = "{{ rpo }}"
        rto = "{{ rto }}"
      }
      hardware {
        rpo = "{{ rpo }}"
        rto = "{{ rto }}"
      }
      region {
        rpo = "{{ rpo }}"
        rto = "{{ rto }}"
      }
      software {
        rpo = "{{ rpo }}"
        rto = "{{ rto }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
