resource "aws_ssmcontacts_contact" "example" {
    alias = "{{ alias }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    type = "{{ type }}"
}
