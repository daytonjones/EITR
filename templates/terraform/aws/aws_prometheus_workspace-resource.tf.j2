resource "aws_prometheus_workspace" "example" {
    alias = "{{ alias }}"
    id = "{{ id }}"
    kms_key_arn = "{{ kms_key_arn }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    logging_configuration {
      log_group_arn = "{{ log_group_arn }}"
    }
}
