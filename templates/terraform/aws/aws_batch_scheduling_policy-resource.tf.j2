resource "aws_batch_scheduling_policy" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    fair_share_policy {
      compute_reservation = {{ compute_reservation }}
      share_decay_seconds = {{ share_decay_seconds }}
      share_distribution {
        share_identifier = "{{ share_identifier }}"
        weight_factor = {{ weight_factor }}
      }
    }
}
