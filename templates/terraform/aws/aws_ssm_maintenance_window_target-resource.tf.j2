resource "aws_ssm_maintenance_window_target" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    owner_information = "{{ owner_information }}"
    region = "{{ region }}"
    resource_type = "{{ resource_type }}"
    window_id = "{{ window_id }}"
    targets {
      key = "{{ key }}"
      values = ["{{ values }}"]
    }
}
