resource "aws_apprunner_vpc_connector" "example" {
    id = "{{ id }}"
    region = "{{ region }}"
    security_groups = ["{{ security_groups }}"]
    subnets = ["{{ subnets }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    vpc_connector_name = "{{ vpc_connector_name }}"
}
