resource "aws_autoscaling_traffic_source_attachment" "example" {
    autoscaling_group_name = "{{ autoscaling_group_name }}"
    id = "{{ id }}"
    region = "{{ region }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
    traffic_source {
      identifier = "{{ identifier }}"
      type = "{{ type }}"
    }
}
