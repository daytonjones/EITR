resource "aws_sagemaker_algorithm" "example" {
    algorithm_description = "{{ algorithm_description }}"
    algorithm_name = "{{ algorithm_name }}"
    certify_for_marketplace = {{ certify_for_marketplace }}
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    inference_specification {
      supported_content_types = ["{{ supported_content_types }}"]
      supported_realtime_inference_instance_types = ["{{ supported_realtime_inference_instance_types }}"]
      supported_response_mime_types = ["{{ supported_response_mime_types }}"]
      supported_transform_instance_types = ["{{ supported_transform_instance_types }}"]
      containers {
        container_hostname = "{{ container_hostname }}"
        environment = {
        key = "{{ environment_value }}"
      }
        framework = "{{ framework }}"
        framework_version = "{{ framework_version }}"
        image = "{{ image }}"
        image_digest = "{{ image_digest }}"
        is_checkpoint = {{ is_checkpoint }}
        model_data_etag = "{{ model_data_etag }}"
        model_data_url = "{{ model_data_url }}"
        nearest_model_name = "{{ nearest_model_name }}"
        product_id = "{{ product_id }}"
        additional_s3_data_source {
          compression_type = "{{ compression_type }}"
          etag = "{{ etag }}"
          s3_data_type = "{{ s3_data_type }}"
          s3_uri = "{{ s3_uri }}"
        }
        base_model {
          hub_content_name = "{{ hub_content_name }}"
          hub_content_version = "{{ hub_content_version }}"
          recipe_name = "{{ recipe_name }}"
        }
        model_data_source {
          s3_data_source {
            compression_type = "{{ compression_type }}"
            etag = "{{ etag }}"
            manifest_etag = "{{ manifest_etag }}"
            manifest_s3_uri = "{{ manifest_s3_uri }}"
            s3_data_type = "{{ s3_data_type }}"
            s3_uri = "{{ s3_uri }}"
            hub_access_config {
              hub_content_arn = "{{ hub_content_arn }}"
            }
            model_access_config {
              accept_eula = {{ accept_eula }}
            }
          }
        }
        model_input {
          data_input_config = "{{ data_input_config }}"
        }
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
    training_specification {
      supported_training_instance_types = ["{{ supported_training_instance_types }}"]
      supports_distributed_training = {{ supports_distributed_training }}
      training_image = "{{ training_image }}"
      training_image_digest = "{{ training_image_digest }}"
      additional_s3_data_source {
        compression_type = "{{ compression_type }}"
        etag = "{{ etag }}"
        s3_data_type = "{{ s3_data_type }}"
        s3_uri = "{{ s3_uri }}"
      }
      metric_definitions {
        name = "{{ name }}"
        regex = "{{ regex }}"
      }
      supported_hyper_parameters {
        default_value = "{{ default_value }}"
        description = "{{ description }}"
        is_required = {{ is_required }}
        is_tunable = {{ is_tunable }}
        name = "{{ name }}"
        type = "{{ type }}"
        range {
          categorical_parameter_range_specification {
            values = ["{{ values }}"]
          }
          continuous_parameter_range_specification {
            max_value = "{{ max_value }}"
            min_value = "{{ min_value }}"
          }
          integer_parameter_range_specification {
            max_value = "{{ max_value }}"
            min_value = "{{ min_value }}"
          }
        }
      }
      supported_tuning_job_objective_metrics {
        metric_name = "{{ metric_name }}"
        type = "{{ type }}"
      }
      training_channels {
        description = "{{ description }}"
        is_required = {{ is_required }}
        name = "{{ name }}"
        supported_compression_types = ["{{ supported_compression_types }}"]
        supported_content_types = ["{{ supported_content_types }}"]
        supported_input_modes = ["{{ supported_input_modes }}"]
      }
    }
    validation_specification {
      validation_role = "{{ validation_role }}"
      validation_profiles {
        profile_name = "{{ profile_name }}"
        training_job_definition {
          hyper_parameters = {
        key = "{{ hyper_parameters_value }}"
      }
          training_input_mode = "{{ training_input_mode }}"
          input_data_config {
            channel_name = "{{ channel_name }}"
            compression_type = "{{ compression_type }}"
            content_type = "{{ content_type }}"
            input_mode = "{{ input_mode }}"
            record_wrapper_type = "{{ record_wrapper_type }}"
            data_source {
              file_system_data_source {
                directory_path = "{{ directory_path }}"
                file_system_access_mode = "{{ file_system_access_mode }}"
                file_system_id = "{{ file_system_id }}"
                file_system_type = "{{ file_system_type }}"
              }
              s3_data_source {
                attribute_names = ["{{ attribute_names }}"]
                instance_group_names = ["{{ instance_group_names }}"]
                s3_data_distribution_type = "{{ s3_data_distribution_type }}"
                s3_data_type = "{{ s3_data_type }}"
                s3_uri = "{{ s3_uri }}"
                hub_access_config {
                  hub_content_arn = "{{ hub_content_arn }}"
                }
                model_access_config {
                  accept_eula = {{ accept_eula }}
                }
              }
            }
            shuffle_config {
              seed = {{ seed }}
            }
          }
          output_data_config {
            compression_type = "{{ compression_type }}"
            kms_key_id = "{{ kms_key_id }}"
            s3_output_path = "{{ s3_output_path }}"
          }
          resource_config {
            instance_count = {{ instance_count }}
            instance_type = "{{ instance_type }}"
            keep_alive_period_in_seconds = {{ keep_alive_period_in_seconds }}
            training_plan_arn = "{{ training_plan_arn }}"
            volume_kms_key_id = "{{ volume_kms_key_id }}"
            volume_size_in_gb = {{ volume_size_in_gb }}
            instance_groups {
              instance_count = {{ instance_count }}
              instance_group_name = "{{ instance_group_name }}"
              instance_type = "{{ instance_type }}"
            }
            instance_placement_config {
              enable_multiple_jobs = {{ enable_multiple_jobs }}
              placement_specifications {
                instance_count = {{ instance_count }}
                ultra_server_id = "{{ ultra_server_id }}"
              }
            }
          }
          stopping_condition {
            max_pending_time_in_seconds = {{ max_pending_time_in_seconds }}
            max_runtime_in_seconds = {{ max_runtime_in_seconds }}
            max_wait_time_in_seconds = {{ max_wait_time_in_seconds }}
          }
        }
        transform_job_definition {
          batch_strategy = "{{ batch_strategy }}"
          environment = {
        key = "{{ environment_value }}"
      }
          max_concurrent_transforms = {{ max_concurrent_transforms }}
          max_payload_in_mb = {{ max_payload_in_mb }}
          transform_input {
            compression_type = "{{ compression_type }}"
            content_type = "{{ content_type }}"
            split_type = "{{ split_type }}"
            data_source {
              s3_data_source {
                s3_data_type = "{{ s3_data_type }}"
                s3_uri = "{{ s3_uri }}"
              }
            }
          }
          transform_output {
            accept = "{{ accept }}"
            assemble_with = "{{ assemble_with }}"
            kms_key_id = "{{ kms_key_id }}"
            s3_output_path = "{{ s3_output_path }}"
          }
          transform_resources {
            instance_count = {{ instance_count }}
            instance_type = "{{ instance_type }}"
            transform_ami_version = "{{ transform_ami_version }}"
            volume_kms_key_id = "{{ volume_kms_key_id }}"
          }
        }
      }
    }
}
