resource "aws_lightsail_container_service" "example" {
    id = "{{ id }}"
    is_disabled = {{ is_disabled }}
    name = "{{ name }}"
    power = "{{ power }}"
    region = "{{ region }}"
    scale = {{ scale }}
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    private_registry_access {
      ecr_image_puller_role {
        is_active = {{ is_active }}
      }
    }
    public_domain_names {
      certificate {
        certificate_name = "{{ certificate_name }}"
        domain_names = ["{{ domain_names }}"]
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
