resource "aws_cloudwatch_event_archive" "example" {
    description = "{{ description }}"
    event_pattern = "{{ event_pattern }}"
    event_source_arn = "{{ event_source_arn }}"
    id = "{{ id }}"
    kms_key_identifier = "{{ kms_key_identifier }}"
    name = "{{ name }}"
    region = "{{ region }}"
    retention_days = {{ retention_days }}
}
