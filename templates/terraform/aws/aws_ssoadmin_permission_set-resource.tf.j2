resource "aws_ssoadmin_permission_set" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    instance_arn = "{{ instance_arn }}"
    name = "{{ name }}"
    region = "{{ region }}"
    relay_state = "{{ relay_state }}"
    session_duration = "{{ session_duration }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      update = "{{ update }}"
    }
}
