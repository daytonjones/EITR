resource "aws_cloudformation_type" "example" {
    execution_role_arn = "{{ execution_role_arn }}"
    id = "{{ id }}"
    region = "{{ region }}"
    schema_handler_package = "{{ schema_handler_package }}"
    type = "{{ type }}"
    type_name = "{{ type_name }}"
    logging_config {
      log_group_name = "{{ log_group_name }}"
      log_role_arn = "{{ log_role_arn }}"
    }
}
