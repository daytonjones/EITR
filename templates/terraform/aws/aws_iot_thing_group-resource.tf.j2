resource "aws_iot_thing_group" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    parent_group_name = "{{ parent_group_name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    properties {
      description = "{{ description }}"
      attribute_payload {
        attributes = {
        key = "{{ attributes_value }}"
      }
      }
    }
}
