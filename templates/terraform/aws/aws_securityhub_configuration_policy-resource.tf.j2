resource "aws_securityhub_configuration_policy" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    configuration_policy {
      enabled_standard_arns = ["{{ enabled_standard_arns }}"]
      service_enabled = {{ service_enabled }}
      security_controls_configuration {
        disabled_control_identifiers = ["{{ disabled_control_identifiers }}"]
        enabled_control_identifiers = ["{{ enabled_control_identifiers }}"]
        security_control_custom_parameter {
          security_control_id = "{{ security_control_id }}"
          parameter {
            name = "{{ name }}"
            value_type = "{{ value_type }}"
            bool {
              value = {{ value }}
            }
            double {
              value = {{ value }}
            }
            enum {
              value = "{{ value }}"
            }
            enum_list {
              value = ["{{ value }}"]
            }
            int {
              value = {{ value }}
            }
            int_list {
              value = ["{{ value }}"]
            }
            string {
              value = "{{ value }}"
            }
            string_list {
              value = ["{{ value }}"]
            }
          }
        }
      }
    }
}
