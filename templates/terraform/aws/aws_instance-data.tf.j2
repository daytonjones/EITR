data "aws_instance" "example" {
    get_password_data = {{ get_password_data }}
    get_user_data = {{ get_user_data }}
    id = "{{ id }}"
    instance_id = "{{ instance_id }}"
    instance_tags = {
        key = "{{ instance_tags_value }}"
      }
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
