resource "aws_quicksight_namespace" "example" {
    aws_account_id = "{{ aws_account_id }}"
    identity_store = "{{ identity_store }}"
    namespace = "{{ namespace }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
