resource "aws_inspector_assessment_template" "example" {
    duration = {{ duration }}
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    rules_package_arns = ["{{ rules_package_arns }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    target_arn = "{{ target_arn }}"
    event_subscription {
      event = "{{ event }}"
      topic_arn = "{{ topic_arn }}"
    }
}
