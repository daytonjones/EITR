resource "aws_auditmanager_framework" "example" {
    compliance_type = "{{ compliance_type }}"
    description = "{{ description }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    control_sets {
      name = "{{ name }}"
      controls {
        id = "{{ id }}"
      }
    }
}
