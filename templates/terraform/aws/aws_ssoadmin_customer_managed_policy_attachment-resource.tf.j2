resource "aws_ssoadmin_customer_managed_policy_attachment" "example" {
    id = "{{ id }}"
    instance_arn = "{{ instance_arn }}"
    permission_set_arn = "{{ permission_set_arn }}"
    region = "{{ region }}"
    customer_managed_policy_reference {
      name = "{{ name }}"
      path = "{{ path }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
