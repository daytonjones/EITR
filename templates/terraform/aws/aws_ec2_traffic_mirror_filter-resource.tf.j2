resource "aws_ec2_traffic_mirror_filter" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    network_services = ["{{ network_services }}"]
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
