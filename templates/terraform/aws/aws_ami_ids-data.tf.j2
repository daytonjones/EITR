data "aws_ami_ids" "example" {
    executable_users = ["{{ executable_users }}"]
    id = "{{ id }}"
    include_deprecated = {{ include_deprecated }}
    name_regex = "{{ name_regex }}"
    owners = ["{{ owners }}"]
    region = "{{ region }}"
    sort_ascending = {{ sort_ascending }}
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
