resource "aws_lex_intent" "example" {
    create_version = {{ create_version }}
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    parent_intent_signature = "{{ parent_intent_signature }}"
    region = "{{ region }}"
    sample_utterances = ["{{ sample_utterances }}"]
    conclusion_statement {
      response_card = "{{ response_card }}"
      message {
        content = "{{ content }}"
        content_type = "{{ content_type }}"
        group_number = {{ group_number }}
      }
    }
    confirmation_prompt {
      max_attempts = {{ max_attempts }}
      response_card = "{{ response_card }}"
      message {
        content = "{{ content }}"
        content_type = "{{ content_type }}"
        group_number = {{ group_number }}
      }
    }
    dialog_code_hook {
      message_version = "{{ message_version }}"
      uri = "{{ uri }}"
    }
    follow_up_prompt {
      prompt {
        max_attempts = {{ max_attempts }}
        response_card = "{{ response_card }}"
        message {
          content = "{{ content }}"
          content_type = "{{ content_type }}"
          group_number = {{ group_number }}
        }
      }
      rejection_statement {
        response_card = "{{ response_card }}"
        message {
          content = "{{ content }}"
          content_type = "{{ content_type }}"
          group_number = {{ group_number }}
        }
      }
    }
    fulfillment_activity {
      type = "{{ type }}"
      code_hook {
        message_version = "{{ message_version }}"
        uri = "{{ uri }}"
      }
    }
    rejection_statement {
      response_card = "{{ response_card }}"
      message {
        content = "{{ content }}"
        content_type = "{{ content_type }}"
        group_number = {{ group_number }}
      }
    }
    slot {
      description = "{{ description }}"
      name = "{{ name }}"
      priority = {{ priority }}
      response_card = "{{ response_card }}"
      sample_utterances = ["{{ sample_utterances }}"]
      slot_constraint = "{{ slot_constraint }}"
      slot_type = "{{ slot_type }}"
      slot_type_version = "{{ slot_type_version }}"
      value_elicitation_prompt {
        max_attempts = {{ max_attempts }}
        response_card = "{{ response_card }}"
        message {
          content = "{{ content }}"
          content_type = "{{ content_type }}"
          group_number = {{ group_number }}
        }
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
