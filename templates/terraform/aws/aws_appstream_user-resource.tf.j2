resource "aws_appstream_user" "example" {
    authentication_type = "{{ authentication_type }}"
    enabled = {{ enabled }}
    first_name = "{{ first_name }}"
    id = "{{ id }}"
    last_name = "{{ last_name }}"
    region = "{{ region }}"
    send_email_notification = {{ send_email_notification }}
    user_name = "{{ user_name }}"
}
