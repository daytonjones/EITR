resource "aws_wafregional_web_acl" "example" {
    id = "{{ id }}"
    metric_name = "{{ metric_name }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    default_action {
      type = "{{ type }}"
    }
    logging_configuration {
      log_destination = "{{ log_destination }}"
      redacted_fields {
        field_to_match {
          data = "{{ data }}"
          type = "{{ type }}"
        }
      }
    }
    rule {
      priority = {{ priority }}
      rule_id = "{{ rule_id }}"
      type = "{{ type }}"
      action {
        type = "{{ type }}"
      }
      override_action {
        type = "{{ type }}"
      }
    }
}
