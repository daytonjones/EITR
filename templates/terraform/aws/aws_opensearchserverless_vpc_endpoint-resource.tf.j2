resource "aws_opensearchserverless_vpc_endpoint" "example" {
    name = "{{ name }}"
    region = "{{ region }}"
    security_group_ids = ["{{ security_group_ids }}"]
    subnet_ids = ["{{ subnet_ids }}"]
    vpc_id = "{{ vpc_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
