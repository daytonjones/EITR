resource "aws_network_acl" "example" {
    egress = ["{{ egress }}"]
    id = "{{ id }}"
    ingress = ["{{ ingress }}"]
    region = "{{ region }}"
    subnet_ids = ["{{ subnet_ids }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    vpc_id = "{{ vpc_id }}"
}
