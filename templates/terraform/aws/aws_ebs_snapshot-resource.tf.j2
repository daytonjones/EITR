resource "aws_ebs_snapshot" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    outpost_arn = "{{ outpost_arn }}"
    permanent_restore = {{ permanent_restore }}
    region = "{{ region }}"
    storage_tier = "{{ storage_tier }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    temporary_restore_days = {{ temporary_restore_days }}
    volume_id = "{{ volume_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
