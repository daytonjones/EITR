data "aws_vpc_ipam_pool" "example" {
    allocation_resource_tags = {
        key = "{{ allocation_resource_tags_value }}"
      }
    id = "{{ id }}"
    ipam_pool_id = "{{ ipam_pool_id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
