resource "aws_codeconnections_host" "example" {
    name = "{{ name }}"
    provider_endpoint = "{{ provider_endpoint }}"
    provider_type = "{{ provider_type }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    vpc_configuration {
      security_group_ids = ["{{ security_group_ids }}"]
      subnet_ids = ["{{ subnet_ids }}"]
      tls_certificate = "{{ tls_certificate }}"
      vpc_id = "{{ vpc_id }}"
    }
}
