resource "aws_lex_bot_alias" "example" {
    bot_name = "{{ bot_name }}"
    bot_version = "{{ bot_version }}"
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    conversation_logs {
      iam_role_arn = "{{ iam_role_arn }}"
      log_settings {
        destination = "{{ destination }}"
        kms_key_arn = "{{ kms_key_arn }}"
        log_type = "{{ log_type }}"
        resource_arn = "{{ resource_arn }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
