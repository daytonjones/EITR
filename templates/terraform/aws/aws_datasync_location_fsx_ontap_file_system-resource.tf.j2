resource "aws_datasync_location_fsx_ontap_file_system" "example" {
    id = "{{ id }}"
    region = "{{ region }}"
    security_group_arns = ["{{ security_group_arns }}"]
    storage_virtual_machine_arn = "{{ storage_virtual_machine_arn }}"
    subdirectory = "{{ subdirectory }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    protocol {
      nfs {
        mount_options {
          version = "{{ version }}"
        }
      }
      smb {
        domain = "{{ domain }}"
        password = "{{ password }}"
        user = "{{ user }}"
        mount_options {
          version = "{{ version }}"
        }
      }
    }
}
