resource "aws_datazone_environment_blueprint_configuration" "example" {
    domain_id = "{{ domain_id }}"
    enabled_regions = ["{{ enabled_regions }}"]
    environment_blueprint_id = "{{ environment_blueprint_id }}"
    manage_access_role_arn = "{{ manage_access_role_arn }}"
    provisioning_role_arn = "{{ provisioning_role_arn }}"
    region = "{{ region }}"
    regional_parameters = {
        key = "{{ regional_parameters_value }}"
      }
}
