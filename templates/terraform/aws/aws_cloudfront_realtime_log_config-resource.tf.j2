resource "aws_cloudfront_realtime_log_config" "example" {
    fields = ["{{ fields }}"]
    id = "{{ id }}"
    name = "{{ name }}"
    sampling_rate = {{ sampling_rate }}
    endpoint {
      stream_type = "{{ stream_type }}"
      kinesis_stream_config {
        role_arn = "{{ role_arn }}"
        stream_arn = "{{ stream_arn }}"
      }
    }
}
