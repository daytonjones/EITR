resource "aws_opensearch_package" "example" {
    engine_version = "{{ engine_version }}"
    id = "{{ id }}"
    package_description = "{{ package_description }}"
    package_name = "{{ package_name }}"
    package_type = "{{ package_type }}"
    region = "{{ region }}"
    package_source {
      s3_bucket_name = "{{ s3_bucket_name }}"
      s3_key = "{{ s3_key }}"
    }
}
