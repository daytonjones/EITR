resource "aws_cloudhsm_v2_hsm" "example" {
    availability_zone = "{{ availability_zone }}"
    cluster_id = "{{ cluster_id }}"
    id = "{{ id }}"
    ip_address = "{{ ip_address }}"
    region = "{{ region }}"
    subnet_id = "{{ subnet_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
