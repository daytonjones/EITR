data "aws_ami" "example" {
    allow_unsafe_filter = {{ allow_unsafe_filter }}
    executable_users = ["{{ executable_users }}"]
    id = "{{ id }}"
    include_deprecated = {{ include_deprecated }}
    most_recent = {{ most_recent }}
    name_regex = "{{ name_regex }}"
    owners = ["{{ owners }}"]
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    uefi_data = "{{ uefi_data }}"
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
