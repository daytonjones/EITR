resource "aws_load_balancer_policy" "example" {
    id = "{{ id }}"
    load_balancer_name = "{{ load_balancer_name }}"
    policy_name = "{{ policy_name }}"
    policy_type_name = "{{ policy_type_name }}"
    region = "{{ region }}"
    policy_attribute {
      name = "{{ name }}"
      value = "{{ value }}"
    }
}
