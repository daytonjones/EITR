resource "aws_datasync_location_fsx_windows_file_system" "example" {
    domain = "{{ domain }}"
    fsx_filesystem_arn = "{{ fsx_filesystem_arn }}"
    id = "{{ id }}"
    password = "{{ password }}"
    region = "{{ region }}"
    security_group_arns = ["{{ security_group_arns }}"]
    subdirectory = "{{ subdirectory }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    user = "{{ user }}"
}
