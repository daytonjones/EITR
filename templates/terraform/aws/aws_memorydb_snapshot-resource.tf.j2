resource "aws_memorydb_snapshot" "example" {
    cluster_name = "{{ cluster_name }}"
    id = "{{ id }}"
    kms_key_arn = "{{ kms_key_arn }}"
    name = "{{ name }}"
    name_prefix = "{{ name_prefix }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
