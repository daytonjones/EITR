data "aws_vpc_peering_connection" "example" {
    cidr_block = "{{ cidr_block }}"
    id = "{{ id }}"
    owner_id = "{{ owner_id }}"
    peer_cidr_block = "{{ peer_cidr_block }}"
    peer_owner_id = "{{ peer_owner_id }}"
    peer_vpc_id = "{{ peer_vpc_id }}"
    status = "{{ status }}"
    tags = {
        key = "{{ tags_value }}"
      }
    vpc_id = "{{ vpc_id }}"
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
