resource "aws_glue_schema" "example" {
    compatibility = "{{ compatibility }}"
    data_format = "{{ data_format }}"
    description = "{{ description }}"
    id = "{{ id }}"
    region = "{{ region }}"
    registry_arn = "{{ registry_arn }}"
    schema_definition = "{{ schema_definition }}"
    schema_name = "{{ schema_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
