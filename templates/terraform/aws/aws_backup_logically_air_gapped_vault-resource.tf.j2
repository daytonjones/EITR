resource "aws_backup_logically_air_gapped_vault" "example" {
    encryption_key_arn = "{{ encryption_key_arn }}"
    max_retention_days = {{ max_retention_days }}
    min_retention_days = {{ min_retention_days }}
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
    }
}
