resource "aws_api_gateway_gateway_response" "example" {
    id = "{{ id }}"
    region = "{{ region }}"
    response_parameters = {
        key = "{{ response_parameters_value }}"
      }
    response_templates = {
        key = "{{ response_templates_value }}"
      }
    response_type = "{{ response_type }}"
    rest_api_id = "{{ rest_api_id }}"
    status_code = "{{ status_code }}"
}
