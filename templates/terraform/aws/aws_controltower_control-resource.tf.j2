resource "aws_controltower_control" "example" {
    control_identifier = "{{ control_identifier }}"
    id = "{{ id }}"
    region = "{{ region }}"
    target_identifier = "{{ target_identifier }}"
    parameters {
      key = "{{ key }}"
      value = "{{ value }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
