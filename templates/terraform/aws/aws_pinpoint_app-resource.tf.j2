resource "aws_pinpoint_app" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    name_prefix = "{{ name_prefix }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    campaign_hook {
      lambda_function_name = "{{ lambda_function_name }}"
      mode = "{{ mode }}"
      web_url = "{{ web_url }}"
    }
    limits {
      daily = {{ daily }}
      maximum_duration = {{ maximum_duration }}
      messages_per_second = {{ messages_per_second }}
      total = {{ total }}
    }
    quiet_time {
      end = "{{ end }}"
      start = "{{ start }}"
    }
}
