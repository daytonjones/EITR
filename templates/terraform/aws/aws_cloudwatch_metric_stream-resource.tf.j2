resource "aws_cloudwatch_metric_stream" "example" {
    firehose_arn = "{{ firehose_arn }}"
    id = "{{ id }}"
    include_linked_accounts_metrics = {{ include_linked_accounts_metrics }}
    name = "{{ name }}"
    name_prefix = "{{ name_prefix }}"
    output_format = "{{ output_format }}"
    region = "{{ region }}"
    role_arn = "{{ role_arn }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    exclude_filter {
      metric_names = ["{{ metric_names }}"]
      namespace = "{{ namespace }}"
    }
    include_filter {
      metric_names = ["{{ metric_names }}"]
      namespace = "{{ namespace }}"
    }
    statistics_configuration {
      additional_statistics = ["{{ additional_statistics }}"]
      include_metric {
        metric_name = "{{ metric_name }}"
        namespace = "{{ namespace }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
