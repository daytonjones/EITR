resource "aws_appfabric_app_authorization" "example" {
    app = "{{ app }}"
    app_bundle_arn = "{{ app_bundle_arn }}"
    auth_type = "{{ auth_type }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    credential {
      api_key_credential {
        api_key = "{{ api_key }}"
      }
      oauth2_credential {
        client_id = "{{ client_id }}"
        client_secret = "{{ client_secret }}"
      }
    }
    tenant {
      tenant_display_name = "{{ tenant_display_name }}"
      tenant_identifier = "{{ tenant_identifier }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
