resource "aws_ec2_instance_connect_endpoint" "example" {
    ip_address_type = "{{ ip_address_type }}"
    preserve_client_ip = {{ preserve_client_ip }}
    region = "{{ region }}"
    security_group_ids = ["{{ security_group_ids }}"]
    subnet_id = "{{ subnet_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
