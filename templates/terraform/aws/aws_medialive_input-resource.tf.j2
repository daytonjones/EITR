resource "aws_medialive_input" "example" {
    id = "{{ id }}"
    input_security_groups = ["{{ input_security_groups }}"]
    name = "{{ name }}"
    region = "{{ region }}"
    role_arn = "{{ role_arn }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    type = "{{ type }}"
    destinations {
      stream_name = "{{ stream_name }}"
    }
    input_devices {
      id = "{{ id }}"
    }
    media_connect_flows {
      flow_arn = "{{ flow_arn }}"
    }
    sources {
      password_param = "{{ password_param }}"
      url = "{{ url }}"
      username = "{{ username }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
    vpc {
      security_group_ids = ["{{ security_group_ids }}"]
      subnet_ids = ["{{ subnet_ids }}"]
    }
}
