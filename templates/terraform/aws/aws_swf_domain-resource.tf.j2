resource "aws_swf_domain" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    name_prefix = "{{ name_prefix }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    workflow_execution_retention_period_in_days = "{{ workflow_execution_retention_period_in_days }}"
}
