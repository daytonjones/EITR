resource "aws_imagebuilder_distribution_configuration" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    distribution {
      license_configuration_arns = ["{{ license_configuration_arns }}"]
      region = "{{ region }}"
      ami_distribution_configuration {
        ami_tags = {
        key = "{{ ami_tags_value }}"
      }
        description = "{{ description }}"
        kms_key_id = "{{ kms_key_id }}"
        name = "{{ name }}"
        target_account_ids = ["{{ target_account_ids }}"]
        launch_permission {
          organization_arns = ["{{ organization_arns }}"]
          organizational_unit_arns = ["{{ organizational_unit_arns }}"]
          user_groups = ["{{ user_groups }}"]
          user_ids = ["{{ user_ids }}"]
        }
      }
      container_distribution_configuration {
        container_tags = ["{{ container_tags }}"]
        description = "{{ description }}"
        target_repository {
          repository_name = "{{ repository_name }}"
          service = "{{ service }}"
        }
      }
      fast_launch_configuration {
        account_id = "{{ account_id }}"
        enabled = {{ enabled }}
        max_parallel_launches = {{ max_parallel_launches }}
        launch_template {
          launch_template_id = "{{ launch_template_id }}"
          launch_template_name = "{{ launch_template_name }}"
          launch_template_version = "{{ launch_template_version }}"
        }
        snapshot_configuration {
          target_resource_count = {{ target_resource_count }}
        }
      }
      launch_template_configuration {
        account_id = "{{ account_id }}"
        default = {{ default }}
        launch_template_id = "{{ launch_template_id }}"
      }
      s3_export_configuration {
        disk_image_format = "{{ disk_image_format }}"
        role_name = "{{ role_name }}"
        s3_bucket = "{{ s3_bucket }}"
        s3_prefix = "{{ s3_prefix }}"
      }
      ssm_parameter_configuration {
        ami_account_id = "{{ ami_account_id }}"
        data_type = "{{ data_type }}"
        parameter_name = "{{ parameter_name }}"
      }
    }
}
