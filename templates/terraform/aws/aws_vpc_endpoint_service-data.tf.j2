data "aws_vpc_endpoint_service" "example" {
    id = "{{ id }}"
    service = "{{ service }}"
    service_name = "{{ service_name }}"
    service_regions = ["{{ service_regions }}"]
    service_type = "{{ service_type }}"
    tags = {
        key = "{{ tags_value }}"
      }
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
