resource "aws_chimesdkvoice_sip_rule" "example" {
    disabled = {{ disabled }}
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    trigger_type = "{{ trigger_type }}"
    trigger_value = "{{ trigger_value }}"
    target_applications {
      aws_region = "{{ aws_region }}"
      priority = {{ priority }}
      sip_media_application_id = "{{ sip_media_application_id }}"
    }
}
