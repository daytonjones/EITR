resource "aws_lexv2models_bot" "example" {
    description = "{{ description }}"
    idle_session_ttl_in_seconds = {{ idle_session_ttl_in_seconds }}
    name = "{{ name }}"
    region = "{{ region }}"
    role_arn = "{{ role_arn }}"
    tags = {
        key = "{{ tags_value }}"
      }
    test_bot_alias_tags = {
        key = "{{ test_bot_alias_tags_value }}"
      }
    type = "{{ type }}"
    data_privacy {
      child_directed = {{ child_directed }}
    }
    members {
      alias_id = "{{ alias_id }}"
      alias_name = "{{ alias_name }}"
      id = "{{ id }}"
      name = "{{ name }}"
      version = "{{ version }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
