resource "aws_wafregional_rule" "example" {
    id = "{{ id }}"
    metric_name = "{{ metric_name }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    predicate {
      data_id = "{{ data_id }}"
      negated = {{ negated }}
      type = "{{ type }}"
    }
}
