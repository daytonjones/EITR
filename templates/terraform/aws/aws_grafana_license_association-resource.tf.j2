resource "aws_grafana_license_association" "example" {
    grafana_token = "{{ grafana_token }}"
    id = "{{ id }}"
    license_type = "{{ license_type }}"
    region = "{{ region }}"
    workspace_id = "{{ workspace_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
