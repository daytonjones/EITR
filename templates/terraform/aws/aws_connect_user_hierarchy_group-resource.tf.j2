resource "aws_connect_user_hierarchy_group" "example" {
    id = "{{ id }}"
    instance_id = "{{ instance_id }}"
    name = "{{ name }}"
    parent_group_id = "{{ parent_group_id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
