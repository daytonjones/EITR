resource "aws_connect_vocabulary" "example" {
    content = "{{ content }}"
    id = "{{ id }}"
    instance_id = "{{ instance_id }}"
    language_code = "{{ language_code }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
