resource "aws_vpclattice_service" "example" {
    auth_type = "{{ auth_type }}"
    certificate_arn = "{{ certificate_arn }}"
    custom_domain_name = "{{ custom_domain_name }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
