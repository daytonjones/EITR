resource "aws_glue_data_quality_ruleset" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    ruleset = "{{ ruleset }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    target_table {
      catalog_id = "{{ catalog_id }}"
      database_name = "{{ database_name }}"
      table_name = "{{ table_name }}"
    }
}
