resource "aws_batch_job_definition" "example" {
    container_properties = "{{ container_properties }}"
    deregister_on_new_revision = {{ deregister_on_new_revision }}
    ecs_properties = "{{ ecs_properties }}"
    id = "{{ id }}"
    name = "{{ name }}"
    node_properties = "{{ node_properties }}"
    parameters = {
        key = "{{ parameters_value }}"
      }
    platform_capabilities = ["{{ platform_capabilities }}"]
    propagate_tags = {{ propagate_tags }}
    region = "{{ region }}"
    scheduling_priority = {{ scheduling_priority }}
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    type = "{{ type }}"
    eks_properties {
      pod_properties {
        dns_policy = "{{ dns_policy }}"
        host_network = {{ host_network }}
        service_account_name = "{{ service_account_name }}"
        share_process_namespace = {{ share_process_namespace }}
        containers {
          args = ["{{ args }}"]
          command = ["{{ command }}"]
          image = "{{ image }}"
          image_pull_policy = "{{ image_pull_policy }}"
          name = "{{ name }}"
          env {
            name = "{{ name }}"
            value = "{{ value }}"
          }
          resources {
            limits = {
        key = "{{ limits_value }}"
      }
            requests = {
        key = "{{ requests_value }}"
      }
          }
          security_context {
            allow_privilege_escalation = {{ allow_privilege_escalation }}
            privileged = {{ privileged }}
            read_only_root_file_system = {{ read_only_root_file_system }}
            run_as_group = {{ run_as_group }}
            run_as_non_root = {{ run_as_non_root }}
            run_as_user = {{ run_as_user }}
          }
          volume_mounts {
            mount_path = "{{ mount_path }}"
            name = "{{ name }}"
            read_only = {{ read_only }}
          }
        }
        image_pull_secret {
          name = "{{ name }}"
        }
        init_containers {
          args = ["{{ args }}"]
          command = ["{{ command }}"]
          image = "{{ image }}"
          image_pull_policy = "{{ image_pull_policy }}"
          name = "{{ name }}"
          env {
            name = "{{ name }}"
            value = "{{ value }}"
          }
          resources {
            limits = {
        key = "{{ limits_value }}"
      }
            requests = {
        key = "{{ requests_value }}"
      }
          }
          security_context {
            allow_privilege_escalation = {{ allow_privilege_escalation }}
            privileged = {{ privileged }}
            read_only_root_file_system = {{ read_only_root_file_system }}
            run_as_group = {{ run_as_group }}
            run_as_non_root = {{ run_as_non_root }}
            run_as_user = {{ run_as_user }}
          }
          volume_mounts {
            mount_path = "{{ mount_path }}"
            name = "{{ name }}"
            read_only = {{ read_only }}
          }
        }
        metadata {
          labels = {
        key = "{{ labels_value }}"
      }
        }
        volumes {
          name = "{{ name }}"
          empty_dir {
            medium = "{{ medium }}"
            size_limit = "{{ size_limit }}"
          }
          host_path {
            path = "{{ path }}"
          }
          secret {
            optional = {{ optional }}
            secret_name = "{{ secret_name }}"
          }
        }
      }
    }
    retry_strategy {
      attempts = {{ attempts }}
      evaluate_on_exit {
        action = "{{ action }}"
        on_exit_code = "{{ on_exit_code }}"
        on_reason = "{{ on_reason }}"
        on_status_reason = "{{ on_status_reason }}"
      }
    }
    timeout {
      attempt_duration_seconds = {{ attempt_duration_seconds }}
    }
}
