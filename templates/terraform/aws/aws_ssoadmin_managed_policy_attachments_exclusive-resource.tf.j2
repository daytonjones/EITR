resource "aws_ssoadmin_managed_policy_attachments_exclusive" "example" {
    instance_arn = "{{ instance_arn }}"
    managed_policy_arns = ["{{ managed_policy_arns }}"]
    permission_set_arn = "{{ permission_set_arn }}"
    region = "{{ region }}"
    timeouts {
      create = "{{ create }}"
      update = "{{ update }}"
    }
}
