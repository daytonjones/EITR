resource "aws_verifiedpermissions_policy" "example" {
    policy_store_id = "{{ policy_store_id }}"
    region = "{{ region }}"
    definition {
      static {
        description = "{{ description }}"
        statement = "{{ statement }}"
      }
      template_linked {
        policy_template_id = "{{ policy_template_id }}"
        principal {
          entity_id = "{{ entity_id }}"
          entity_type = "{{ entity_type }}"
        }
        resource {
          entity_id = "{{ entity_id }}"
          entity_type = "{{ entity_type }}"
        }
      }
    }
}
