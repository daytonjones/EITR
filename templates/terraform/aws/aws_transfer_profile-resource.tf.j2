resource "aws_transfer_profile" "example" {
    as2_id = "{{ as2_id }}"
    certificate_ids = ["{{ certificate_ids }}"]
    id = "{{ id }}"
    profile_type = "{{ profile_type }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
