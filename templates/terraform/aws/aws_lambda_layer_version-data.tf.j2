data "aws_lambda_layer_version" "example" {
    compatible_architecture = "{{ compatible_architecture }}"
    compatible_runtime = "{{ compatible_runtime }}"
    id = "{{ id }}"
    layer_name = "{{ layer_name }}"
    layer_version_arn = "{{ layer_version_arn }}"
    region = "{{ region }}"
    version = {{ version }}
}
