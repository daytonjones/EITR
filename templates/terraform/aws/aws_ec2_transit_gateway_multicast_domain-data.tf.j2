data "aws_ec2_transit_gateway_multicast_domain" "example" {
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    transit_gateway_multicast_domain_id = "{{ transit_gateway_multicast_domain_id }}"
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
