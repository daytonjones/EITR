resource "aws_macie2_custom_data_identifier" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    ignore_words = ["{{ ignore_words }}"]
    keywords = ["{{ keywords }}"]
    maximum_match_distance = {{ maximum_match_distance }}
    name = "{{ name }}"
    name_prefix = "{{ name_prefix }}"
    regex = "{{ regex }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
    }
}
