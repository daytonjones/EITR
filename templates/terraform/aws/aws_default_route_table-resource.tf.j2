resource "aws_default_route_table" "example" {
    default_route_table_id = "{{ default_route_table_id }}"
    id = "{{ id }}"
    propagating_vgws = ["{{ propagating_vgws }}"]
    region = "{{ region }}"
    route = ["{{ route }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      update = "{{ update }}"
    }
}
