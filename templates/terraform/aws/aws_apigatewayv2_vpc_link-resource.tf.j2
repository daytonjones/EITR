resource "aws_apigatewayv2_vpc_link" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    security_group_ids = ["{{ security_group_ids }}"]
    subnet_ids = ["{{ subnet_ids }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
