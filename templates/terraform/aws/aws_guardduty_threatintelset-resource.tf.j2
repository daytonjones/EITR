resource "aws_guardduty_threatintelset" "example" {
    activate = {{ activate }}
    detector_id = "{{ detector_id }}"
    format = "{{ format }}"
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
