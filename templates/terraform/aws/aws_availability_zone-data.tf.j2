data "aws_availability_zone" "example" {
    all_availability_zones = {{ all_availability_zones }}
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    state = "{{ state }}"
    zone_id = "{{ zone_id }}"
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
