resource "aws_macie2_member" "example" {
    account_id = "{{ account_id }}"
    email = "{{ email }}"
    id = "{{ id }}"
    invitation_disable_email_notification = {{ invitation_disable_email_notification }}
    invitation_message = "{{ invitation_message }}"
    invite = {{ invite }}
    region = "{{ region }}"
    status = "{{ status }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      update = "{{ update }}"
    }
}
