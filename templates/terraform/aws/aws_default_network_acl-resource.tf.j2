resource "aws_default_network_acl" "example" {
    default_network_acl_id = "{{ default_network_acl_id }}"
    id = "{{ id }}"
    region = "{{ region }}"
    subnet_ids = ["{{ subnet_ids }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    egress {
      action = "{{ action }}"
      cidr_block = "{{ cidr_block }}"
      from_port = {{ from_port }}
      icmp_code = {{ icmp_code }}
      icmp_type = {{ icmp_type }}
      ipv6_cidr_block = "{{ ipv6_cidr_block }}"
      protocol = "{{ protocol }}"
      rule_no = {{ rule_no }}
      to_port = {{ to_port }}
    }
    ingress {
      action = "{{ action }}"
      cidr_block = "{{ cidr_block }}"
      from_port = {{ from_port }}
      icmp_code = {{ icmp_code }}
      icmp_type = {{ icmp_type }}
      ipv6_cidr_block = "{{ ipv6_cidr_block }}"
      protocol = "{{ protocol }}"
      rule_no = {{ rule_no }}
      to_port = {{ to_port }}
    }
}
