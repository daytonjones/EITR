data "aws_fsx_openzfs_snapshot" "example" {
    id = "{{ id }}"
    most_recent = {{ most_recent }}
    name = "{{ name }}"
    region = "{{ region }}"
    snapshot_ids = ["{{ snapshot_ids }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
}
