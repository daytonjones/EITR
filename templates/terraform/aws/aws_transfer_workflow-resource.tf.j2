resource "aws_transfer_workflow" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    on_exception_steps {
      type = "{{ type }}"
      copy_step_details {
        name = "{{ name }}"
        overwrite_existing = "{{ overwrite_existing }}"
        source_file_location = "{{ source_file_location }}"
        destination_file_location {
          efs_file_location {
            file_system_id = "{{ file_system_id }}"
            path = "{{ path }}"
          }
          s3_file_location {
            bucket = "{{ bucket }}"
            key = "{{ key }}"
          }
        }
      }
      custom_step_details {
        name = "{{ name }}"
        source_file_location = "{{ source_file_location }}"
        target = "{{ target }}"
        timeout_seconds = {{ timeout_seconds }}
      }
      decrypt_step_details {
        name = "{{ name }}"
        overwrite_existing = "{{ overwrite_existing }}"
        source_file_location = "{{ source_file_location }}"
        type = "{{ type }}"
        destination_file_location {
          efs_file_location {
            file_system_id = "{{ file_system_id }}"
            path = "{{ path }}"
          }
          s3_file_location {
            bucket = "{{ bucket }}"
            key = "{{ key }}"
          }
        }
      }
      delete_step_details {
        name = "{{ name }}"
        source_file_location = "{{ source_file_location }}"
      }
      tag_step_details {
        name = "{{ name }}"
        source_file_location = "{{ source_file_location }}"
        tags {
          key = "{{ key }}"
          value = "{{ value }}"
        }
      }
    }
    steps {
      type = "{{ type }}"
      copy_step_details {
        name = "{{ name }}"
        overwrite_existing = "{{ overwrite_existing }}"
        source_file_location = "{{ source_file_location }}"
        destination_file_location {
          efs_file_location {
            file_system_id = "{{ file_system_id }}"
            path = "{{ path }}"
          }
          s3_file_location {
            bucket = "{{ bucket }}"
            key = "{{ key }}"
          }
        }
      }
      custom_step_details {
        name = "{{ name }}"
        source_file_location = "{{ source_file_location }}"
        target = "{{ target }}"
        timeout_seconds = {{ timeout_seconds }}
      }
      decrypt_step_details {
        name = "{{ name }}"
        overwrite_existing = "{{ overwrite_existing }}"
        source_file_location = "{{ source_file_location }}"
        type = "{{ type }}"
        destination_file_location {
          efs_file_location {
            file_system_id = "{{ file_system_id }}"
            path = "{{ path }}"
          }
          s3_file_location {
            bucket = "{{ bucket }}"
            key = "{{ key }}"
          }
        }
      }
      delete_step_details {
        name = "{{ name }}"
        source_file_location = "{{ source_file_location }}"
      }
      tag_step_details {
        name = "{{ name }}"
        source_file_location = "{{ source_file_location }}"
        tags {
          key = "{{ key }}"
          value = "{{ value }}"
        }
      }
    }
}
