resource "aws_sesv2_contact_list" "example" {
    contact_list_name = "{{ contact_list_name }}"
    description = "{{ description }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    topic {
      default_subscription_status = "{{ default_subscription_status }}"
      description = "{{ description }}"
      display_name = "{{ display_name }}"
      topic_name = "{{ topic_name }}"
    }
}
