resource "aws_cloudfront_distribution" "example" {
    aliases = ["{{ aliases }}"]
    anycast_ip_list_id = "{{ anycast_ip_list_id }}"
    comment = "{{ comment }}"
    continuous_deployment_policy_id = "{{ continuous_deployment_policy_id }}"
    default_root_object = "{{ default_root_object }}"
    enabled = {{ enabled }}
    http_version = "{{ http_version }}"
    id = "{{ id }}"
    is_ipv6_enabled = {{ is_ipv6_enabled }}
    price_class = "{{ price_class }}"
    retain_on_delete = {{ retain_on_delete }}
    staging = {{ staging }}
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    wait_for_deployment = {{ wait_for_deployment }}
    web_acl_id = "{{ web_acl_id }}"
    connection_function_association {
      id = "{{ id }}"
    }
    custom_error_response {
      error_caching_min_ttl = {{ error_caching_min_ttl }}
      error_code = {{ error_code }}
      response_code = {{ response_code }}
      response_page_path = "{{ response_page_path }}"
    }
    default_cache_behavior {
      allowed_methods = ["{{ allowed_methods }}"]
      cache_policy_id = "{{ cache_policy_id }}"
      cached_methods = ["{{ cached_methods }}"]
      compress = {{ compress }}
      default_ttl = {{ default_ttl }}
      field_level_encryption_id = "{{ field_level_encryption_id }}"
      max_ttl = {{ max_ttl }}
      min_ttl = {{ min_ttl }}
      origin_request_policy_id = "{{ origin_request_policy_id }}"
      realtime_log_config_arn = "{{ realtime_log_config_arn }}"
      response_headers_policy_id = "{{ response_headers_policy_id }}"
      smooth_streaming = {{ smooth_streaming }}
      target_origin_id = "{{ target_origin_id }}"
      trusted_key_groups = ["{{ trusted_key_groups }}"]
      trusted_signers = ["{{ trusted_signers }}"]
      viewer_protocol_policy = "{{ viewer_protocol_policy }}"
      forwarded_values {
        headers = ["{{ headers }}"]
        query_string = {{ query_string }}
        query_string_cache_keys = ["{{ query_string_cache_keys }}"]
        cookies {
          forward = "{{ forward }}"
          whitelisted_names = ["{{ whitelisted_names }}"]
        }
      }
      function_association {
        event_type = "{{ event_type }}"
        function_arn = "{{ function_arn }}"
      }
      grpc_config {
        enabled = {{ enabled }}
      }
      lambda_function_association {
        event_type = "{{ event_type }}"
        include_body = {{ include_body }}
        lambda_arn = "{{ lambda_arn }}"
      }
    }
    logging_config {
      bucket = "{{ bucket }}"
      include_cookies = {{ include_cookies }}
      prefix = "{{ prefix }}"
    }
    ordered_cache_behavior {
      allowed_methods = ["{{ allowed_methods }}"]
      cache_policy_id = "{{ cache_policy_id }}"
      cached_methods = ["{{ cached_methods }}"]
      compress = {{ compress }}
      default_ttl = {{ default_ttl }}
      field_level_encryption_id = "{{ field_level_encryption_id }}"
      max_ttl = {{ max_ttl }}
      min_ttl = {{ min_ttl }}
      origin_request_policy_id = "{{ origin_request_policy_id }}"
      path_pattern = "{{ path_pattern }}"
      realtime_log_config_arn = "{{ realtime_log_config_arn }}"
      response_headers_policy_id = "{{ response_headers_policy_id }}"
      smooth_streaming = {{ smooth_streaming }}
      target_origin_id = "{{ target_origin_id }}"
      trusted_key_groups = ["{{ trusted_key_groups }}"]
      trusted_signers = ["{{ trusted_signers }}"]
      viewer_protocol_policy = "{{ viewer_protocol_policy }}"
      forwarded_values {
        headers = ["{{ headers }}"]
        query_string = {{ query_string }}
        query_string_cache_keys = ["{{ query_string_cache_keys }}"]
        cookies {
          forward = "{{ forward }}"
          whitelisted_names = ["{{ whitelisted_names }}"]
        }
      }
      function_association {
        event_type = "{{ event_type }}"
        function_arn = "{{ function_arn }}"
      }
      grpc_config {
        enabled = {{ enabled }}
      }
      lambda_function_association {
        event_type = "{{ event_type }}"
        include_body = {{ include_body }}
        lambda_arn = "{{ lambda_arn }}"
      }
    }
    origin {
      connection_attempts = {{ connection_attempts }}
      connection_timeout = {{ connection_timeout }}
      domain_name = "{{ domain_name }}"
      origin_access_control_id = "{{ origin_access_control_id }}"
      origin_id = "{{ origin_id }}"
      origin_path = "{{ origin_path }}"
      response_completion_timeout = {{ response_completion_timeout }}
      custom_header {
        name = "{{ name }}"
        value = "{{ value }}"
      }
      custom_origin_config {
        http_port = {{ http_port }}
        https_port = {{ https_port }}
        ip_address_type = "{{ ip_address_type }}"
        origin_keepalive_timeout = {{ origin_keepalive_timeout }}
        origin_protocol_policy = "{{ origin_protocol_policy }}"
        origin_read_timeout = {{ origin_read_timeout }}
        origin_ssl_protocols = ["{{ origin_ssl_protocols }}"]
      }
      origin_shield {
        enabled = {{ enabled }}
        origin_shield_region = "{{ origin_shield_region }}"
      }
      s3_origin_config {
        origin_access_identity = "{{ origin_access_identity }}"
      }
      vpc_origin_config {
        origin_keepalive_timeout = {{ origin_keepalive_timeout }}
        origin_read_timeout = {{ origin_read_timeout }}
        owner_account_id = "{{ owner_account_id }}"
        vpc_origin_id = "{{ vpc_origin_id }}"
      }
    }
    origin_group {
      origin_id = "{{ origin_id }}"
      failover_criteria {
        status_codes = ["{{ status_codes }}"]
      }
      member {
        origin_id = "{{ origin_id }}"
      }
    }
    restrictions {
      geo_restriction {
        locations = ["{{ locations }}"]
        restriction_type = "{{ restriction_type }}"
      }
    }
    viewer_certificate {
      acm_certificate_arn = "{{ acm_certificate_arn }}"
      cloudfront_default_certificate = {{ cloudfront_default_certificate }}
      iam_certificate_id = "{{ iam_certificate_id }}"
      minimum_protocol_version = "{{ minimum_protocol_version }}"
      ssl_support_method = "{{ ssl_support_method }}"
    }
    viewer_mtls_config {
      mode = "{{ mode }}"
      trust_store_config {
        advertise_trust_store_ca_names = {{ advertise_trust_store_ca_names }}
        ignore_certificate_expiry = {{ ignore_certificate_expiry }}
        trust_store_id = "{{ trust_store_id }}"
      }
    }
}
