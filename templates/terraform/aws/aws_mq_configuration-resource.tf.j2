resource "aws_mq_configuration" "example" {
    authentication_strategy = "{{ authentication_strategy }}"
    data = "{{ data }}"
    description = "{{ description }}"
    engine_type = "{{ engine_type }}"
    engine_version = "{{ engine_version }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    skip_destroy = {{ skip_destroy }}
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
