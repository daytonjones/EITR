resource "aws_s3outposts_endpoint" "example" {
    access_type = "{{ access_type }}"
    customer_owned_ipv4_pool = "{{ customer_owned_ipv4_pool }}"
    id = "{{ id }}"
    outpost_id = "{{ outpost_id }}"
    region = "{{ region }}"
    security_group_id = "{{ security_group_id }}"
    subnet_id = "{{ subnet_id }}"
}
