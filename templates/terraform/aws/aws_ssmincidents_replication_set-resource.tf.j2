resource "aws_ssmincidents_replication_set" "example" {
    id = "{{ id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    region {
      kms_key_arn = "{{ kms_key_arn }}"
      name = "{{ name }}"
    }
    regions {
      kms_key_arn = "{{ kms_key_arn }}"
      name = "{{ name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
