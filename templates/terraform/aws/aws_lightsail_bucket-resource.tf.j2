resource "aws_lightsail_bucket" "example" {
    bundle_id = "{{ bundle_id }}"
    force_delete = {{ force_delete }}
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
