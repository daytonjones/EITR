resource "aws_grafana_role_association" "example" {
    group_ids = ["{{ group_ids }}"]
    id = "{{ id }}"
    region = "{{ region }}"
    role = "{{ role }}"
    user_ids = ["{{ user_ids }}"]
    workspace_id = "{{ workspace_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
    }
}
