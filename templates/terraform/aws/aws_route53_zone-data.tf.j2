data "aws_route53_zone" "example" {
    enable_accelerated_recovery = {{ enable_accelerated_recovery }}
    id = "{{ id }}"
    name = "{{ name }}"
    private_zone = {{ private_zone }}
    tags = {
        key = "{{ tags_value }}"
      }
    vpc_id = "{{ vpc_id }}"
    zone_id = "{{ zone_id }}"
}
