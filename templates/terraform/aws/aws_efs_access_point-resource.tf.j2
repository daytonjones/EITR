resource "aws_efs_access_point" "example" {
    file_system_id = "{{ file_system_id }}"
    id = "{{ id }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    posix_user {
      gid = {{ gid }}
      secondary_gids = ["{{ secondary_gids }}"]
      uid = {{ uid }}
    }
    root_directory {
      path = "{{ path }}"
      creation_info {
        owner_gid = {{ owner_gid }}
        owner_uid = {{ owner_uid }}
        permissions = "{{ permissions }}"
      }
    }
}
