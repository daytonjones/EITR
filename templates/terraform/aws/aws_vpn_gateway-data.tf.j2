data "aws_vpn_gateway" "example" {
    amazon_side_asn = "{{ amazon_side_asn }}"
    attached_vpc_id = "{{ attached_vpc_id }}"
    availability_zone = "{{ availability_zone }}"
    id = "{{ id }}"
    region = "{{ region }}"
    state = "{{ state }}"
    tags = {
        key = "{{ tags_value }}"
      }
    filter {
      name = "{{ name }}"
      values = ["{{ values }}"]
    }
    timeouts {
      read = "{{ read }}"
    }
}
