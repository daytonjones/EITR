resource "aws_imagebuilder_component" "example" {
    change_description = "{{ change_description }}"
    data = "{{ data }}"
    description = "{{ description }}"
    id = "{{ id }}"
    kms_key_id = "{{ kms_key_id }}"
    name = "{{ name }}"
    platform = "{{ platform }}"
    region = "{{ region }}"
    skip_destroy = {{ skip_destroy }}
    supported_os_versions = ["{{ supported_os_versions }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    uri = "{{ uri }}"
    version = "{{ version }}"
}
