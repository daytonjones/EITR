resource "aws_rds_custom_db_engine_version" "example" {
    database_installation_files_s3_bucket_name = "{{ database_installation_files_s3_bucket_name }}"
    database_installation_files_s3_prefix = "{{ database_installation_files_s3_prefix }}"
    description = "{{ description }}"
    engine = "{{ engine }}"
    engine_version = "{{ engine_version }}"
    filename = "{{ filename }}"
    id = "{{ id }}"
    kms_key_id = "{{ kms_key_id }}"
    manifest = "{{ manifest }}"
    manifest_hash = "{{ manifest_hash }}"
    region = "{{ region }}"
    source_image_id = "{{ source_image_id }}"
    status = "{{ status }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
