resource "aws_resourcegroups_group" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    name = "{{ name }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    configuration {
      type = "{{ type }}"
      parameters {
        name = "{{ name }}"
        values = ["{{ values }}"]
      }
    }
    resource_query {
      query = "{{ query }}"
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      update = "{{ update }}"
    }
}
