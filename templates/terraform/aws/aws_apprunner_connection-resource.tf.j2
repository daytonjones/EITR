resource "aws_apprunner_connection" "example" {
    connection_name = "{{ connection_name }}"
    id = "{{ id }}"
    provider_type = "{{ provider_type }}"
    region = "{{ region }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
}
