resource "aws_networkmanager_site_to_site_vpn_attachment" "example" {
    core_network_id = "{{ core_network_id }}"
    id = "{{ id }}"
    routing_policy_label = "{{ routing_policy_label }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tags_all = {
        key = "{{ tags_all_value }}"
      }
    vpn_connection_arn = "{{ vpn_connection_arn }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
