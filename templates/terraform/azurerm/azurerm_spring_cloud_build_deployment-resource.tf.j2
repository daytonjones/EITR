resource "azurerm_spring_cloud_build_deployment" "example" {
    addon_json = "{{ addon_json }}"
    application_performance_monitoring_ids = ["{{ application_performance_monitoring_ids }}"]
    build_result_id = "{{ build_result_id }}"
    environment_variables = {
        key = "{{ environment_variables_value }}"
      }
    id = "{{ id }}"
    instance_count = {{ instance_count }}
    name = "{{ name }}"
    spring_cloud_app_id = "{{ spring_cloud_app_id }}"
    quota {
      cpu = "{{ cpu }}"
      memory = "{{ memory }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
