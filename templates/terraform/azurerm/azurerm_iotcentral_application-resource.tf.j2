resource "azurerm_iotcentral_application" "example" {
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    public_network_access_enabled = {{ public_network_access_enabled }}
    resource_group_name = "{{ resource_group_name }}"
    sku = "{{ sku }}"
    sub_domain = "{{ sub_domain }}"
    tags = {
        key = "{{ tags_value }}"
      }
    template = "{{ template }}"
    identity {
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
