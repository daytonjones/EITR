data "azurerm_shared_image_version" "example" {
    gallery_name = "{{ gallery_name }}"
    id = "{{ id }}"
    image_name = "{{ image_name }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    sort_versions_by_semver = {{ sort_versions_by_semver }}
