data "azurerm_storage_blob" "example" {
    id = "{{ id }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    name = "{{ name }}"
    storage_account_name = "{{ storage_account_name }}"
    storage_container_name = "{{ storage_container_name }}"
    timeouts {
      read = "{{ read }}"
    }
}
