resource "azurerm_vmware_cluster" "example" {
    cluster_node_count = {{ cluster_node_count }}
    id = "{{ id }}"
    name = "{{ name }}"
    sku_name = "{{ sku_name }}"
    vmware_cloud_id = "{{ vmware_cloud_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
