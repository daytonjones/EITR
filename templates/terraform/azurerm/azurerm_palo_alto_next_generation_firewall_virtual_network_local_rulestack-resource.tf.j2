resource "azurerm_palo_alto_next_generation_firewall_virtual_network_local_rulestack" "example" {
    id = "{{ id }}"
    marketplace_offer_id = "{{ marketplace_offer_id }}"
    name = "{{ name }}"
    plan_id = "{{ plan_id }}"
    resource_group_name = "{{ resource_group_name }}"
    rulestack_id = "{{ rulestack_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    destination_nat {
      name = "{{ name }}"
      protocol = "{{ protocol }}"
      backend_config {
        port = {{ port }}
        public_ip_address = "{{ public_ip_address }}"
      }
      frontend_config {
        port = {{ port }}
        public_ip_address_id = "{{ public_ip_address_id }}"
      }
    }
    dns_settings {
      dns_servers = ["{{ dns_servers }}"]
      use_azure_dns = {{ use_azure_dns }}
    }
    network_profile {
      egress_nat_ip_address_ids = ["{{ egress_nat_ip_address_ids }}"]
      public_ip_address_ids = ["{{ public_ip_address_ids }}"]
      trusted_address_ranges = ["{{ trusted_address_ranges }}"]
      vnet_configuration {
        trusted_subnet_id = "{{ trusted_subnet_id }}"
        untrusted_subnet_id = "{{ untrusted_subnet_id }}"
        virtual_network_id = "{{ virtual_network_id }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
