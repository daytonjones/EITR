resource "azurerm_data_share_dataset_data_lake_gen2" "example" {
    file_path = "{{ file_path }}"
    file_system_name = "{{ file_system_name }}"
    folder_path = "{{ folder_path }}"
    id = "{{ id }}"
    name = "{{ name }}"
    share_id = "{{ share_id }}"
    storage_account_id = "{{ storage_account_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
    }
}
