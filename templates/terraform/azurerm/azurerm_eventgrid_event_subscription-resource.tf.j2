resource "azurerm_eventgrid_event_subscription" "example" {
    advanced_filtering_on_arrays_enabled = {{ advanced_filtering_on_arrays_enabled }}
    event_delivery_schema = "{{ event_delivery_schema }}"
    eventhub_endpoint_id = "{{ eventhub_endpoint_id }}"
    expiration_time_utc = "{{ expiration_time_utc }}"
    hybrid_connection_endpoint_id = "{{ hybrid_connection_endpoint_id }}"
    id = "{{ id }}"
    included_event_types = ["{{ included_event_types }}"]
    labels = ["{{ labels }}"]
    name = "{{ name }}"
    scope = "{{ scope }}"
    service_bus_queue_endpoint_id = "{{ service_bus_queue_endpoint_id }}"
    service_bus_topic_endpoint_id = "{{ service_bus_topic_endpoint_id }}"
    advanced_filter {
      bool_equals {
        key = "{{ key }}"
        value = {{ value }}
      }
      is_not_null {
        key = "{{ key }}"
      }
      is_null_or_undefined {
        key = "{{ key }}"
      }
      number_greater_than {
        key = "{{ key }}"
        value = {{ value }}
      }
      number_greater_than_or_equals {
        key = "{{ key }}"
        value = {{ value }}
      }
      number_in {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      number_in_range {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      number_less_than {
        key = "{{ key }}"
        value = {{ value }}
      }
      number_less_than_or_equals {
        key = "{{ key }}"
        value = {{ value }}
      }
      number_not_in {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      number_not_in_range {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      string_begins_with {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      string_contains {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      string_ends_with {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      string_in {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      string_not_begins_with {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      string_not_contains {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      string_not_ends_with {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
      string_not_in {
        key = "{{ key }}"
        values = ["{{ values }}"]
      }
    }
    azure_function_endpoint {
      function_id = "{{ function_id }}"
      max_events_per_batch = {{ max_events_per_batch }}
      preferred_batch_size_in_kilobytes = {{ preferred_batch_size_in_kilobytes }}
    }
    dead_letter_identity {
      type = "{{ type }}"
      user_assigned_identity = "{{ user_assigned_identity }}"
    }
    delivery_identity {
      type = "{{ type }}"
      user_assigned_identity = "{{ user_assigned_identity }}"
    }
    delivery_property {
      header_name = "{{ header_name }}"
      secret = {{ secret }}
      source_field = "{{ source_field }}"
      type = "{{ type }}"
      value = "{{ value }}"
    }
    retry_policy {
      event_time_to_live = {{ event_time_to_live }}
      max_delivery_attempts = {{ max_delivery_attempts }}
    }
    storage_blob_dead_letter_destination {
      storage_account_id = "{{ storage_account_id }}"
      storage_blob_container_name = "{{ storage_blob_container_name }}"
    }
    storage_queue_endpoint {
      queue_message_time_to_live_in_seconds = {{ queue_message_time_to_live_in_seconds }}
      queue_name = "{{ queue_name }}"
      storage_account_id = "{{ storage_account_id }}"
    }
    subject_filter {
      case_sensitive = {{ case_sensitive }}
      subject_begins_with = "{{ subject_begins_with }}"
      subject_ends_with = "{{ subject_ends_with }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
    webhook_endpoint {
      active_directory_app_id_or_uri = "{{ active_directory_app_id_or_uri }}"
      active_directory_tenant_id = "{{ active_directory_tenant_id }}"
      max_events_per_batch = {{ max_events_per_batch }}
      preferred_batch_size_in_kilobytes = {{ preferred_batch_size_in_kilobytes }}
      url = "{{ url }}"
    }
}
