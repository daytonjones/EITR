resource "azurerm_batch_account" "example" {
    allowed_authentication_modes = ["{{ allowed_authentication_modes }}"]
    encryption = ["{{ encryption }}"]
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    pool_allocation_mode = "{{ pool_allocation_mode }}"
    public_network_access_enabled = {{ public_network_access_enabled }}
    resource_group_name = "{{ resource_group_name }}"
    storage_account_authentication_mode = "{{ storage_account_authentication_mode }}"
    storage_account_id = "{{ storage_account_id }}"
    storage_account_node_identity = "{{ storage_account_node_identity }}"
    tags = {
        key = "{{ tags_value }}"
      }
    identity {
      identity_ids = ["{{ identity_ids }}"]
      type = "{{ type }}"
    }
    key_vault_reference {
      id = "{{ id }}"
      url = "{{ url }}"
    }
    network_profile {
      account_access {
        default_action = "{{ default_action }}"
        ip_rule {
          action = "{{ action }}"
          ip_range = "{{ ip_range }}"
        }
      }
      node_management_access {
        default_action = "{{ default_action }}"
        ip_rule {
          action = "{{ action }}"
          ip_range = "{{ ip_range }}"
        }
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
