resource "azurerm_elastic_cloud_elasticsearch" "example" {
    elastic_cloud_email_address = "{{ elastic_cloud_email_address }}"
    id = "{{ id }}"
    location = "{{ location }}"
    monitoring_enabled = {{ monitoring_enabled }}
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    sku_name = "{{ sku_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    logs {
      send_activity_logs = {{ send_activity_logs }}
      send_azuread_logs = {{ send_azuread_logs }}
      send_subscription_logs = {{ send_subscription_logs }}
      filtering_tag {
        action = "{{ action }}"
        name = "{{ name }}"
        value = "{{ value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
