resource "azurerm_spring_cloud_builder" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    spring_cloud_service_id = "{{ spring_cloud_service_id }}"
    build_pack_group {
      build_pack_ids = ["{{ build_pack_ids }}"]
      name = "{{ name }}"
    }
    stack {
      id = "{{ id }}"
      version = "{{ version }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
