resource "azurerm_logic_app_integration_account_agreement" "example" {
    agreement_type = "{{ agreement_type }}"
    content = "{{ content }}"
    guest_partner_name = "{{ guest_partner_name }}"
    host_partner_name = "{{ host_partner_name }}"
    id = "{{ id }}"
    integration_account_name = "{{ integration_account_name }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    guest_identity {
      qualifier = "{{ qualifier }}"
      value = "{{ value }}"
    }
    host_identity {
      qualifier = "{{ qualifier }}"
      value = "{{ value }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
