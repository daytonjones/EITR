resource "azurerm_app_service_source_control_token" "example" {
    id = "{{ id }}"
    token = "{{ token }}"
    token_secret = "{{ token_secret }}"
    type = "{{ type }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
