data "azurerm_netapp_snapshot" "example" {
    account_name = "{{ account_name }}"
    id = "{{ id }}"
    name = "{{ name }}"
    pool_name = "{{ pool_name }}"
    resource_group_name = "{{ resource_group_name }}"
    volume_name = "{{ volume_name }}"
    timeouts {
      read = "{{ read }}"
    }
}
