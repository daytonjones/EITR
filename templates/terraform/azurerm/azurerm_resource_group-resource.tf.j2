resource "azurerm_resource_group" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    managed_by = "{{ managed_by }}"
    name = "{{ name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
