resource "azurerm_web_app_hybrid_connection" "example" {
    hostname = "{{ hostname }}"
    id = "{{ id }}"
    port = {{ port }}
    relay_id = "{{ relay_id }}"
    send_key_name = "{{ send_key_name }}"
    web_app_id = "{{ web_app_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
