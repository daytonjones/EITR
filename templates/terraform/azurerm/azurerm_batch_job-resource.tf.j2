resource "azurerm_batch_job" "example" {
    batch_pool_id = "{{ batch_pool_id }}"
    common_environment_properties = {
        key = "{{ common_environment_properties_value }}"
      }
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    name = "{{ name }}"
    priority = {{ priority }}
    task_retry_maximum = {{ task_retry_maximum }}
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
