resource "azurerm_private_dns_resolver_outbound_endpoint" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    private_dns_resolver_id = "{{ private_dns_resolver_id }}"
    subnet_id = "{{ subnet_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
