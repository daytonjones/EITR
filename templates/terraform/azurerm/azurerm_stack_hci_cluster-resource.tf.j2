resource "azurerm_stack_hci_cluster" "example" {
    automanage_configuration_id = "{{ automanage_configuration_id }}"
    client_id = "{{ client_id }}"
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tenant_id = "{{ tenant_id }}"
    identity {
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
