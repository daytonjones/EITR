resource "azurerm_servicebus_topic_authorization_rule" "example" {
    id = "{{ id }}"
    listen = {{ listen }}
    manage = {{ manage }}
    name = "{{ name }}"
    send = {{ send }}
    topic_id = "{{ topic_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
