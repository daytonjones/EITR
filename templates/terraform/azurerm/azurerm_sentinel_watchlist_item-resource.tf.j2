resource "azurerm_sentinel_watchlist_item" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    properties = {
        key = "{{ properties_value }}"
      }
    watchlist_id = "{{ watchlist_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
