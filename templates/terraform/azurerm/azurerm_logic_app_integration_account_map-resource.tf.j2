resource "azurerm_logic_app_integration_account_map" "example" {
    content = "{{ content }}"
    id = "{{ id }}"
    integration_account_name = "{{ integration_account_name }}"
    map_type = "{{ map_type }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
