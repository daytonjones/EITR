resource "azurerm_dns_cname_record" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    record = "{{ record }}"
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    target_resource_id = "{{ target_resource_id }}"
    ttl = {{ ttl }}
    zone_name = "{{ zone_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
