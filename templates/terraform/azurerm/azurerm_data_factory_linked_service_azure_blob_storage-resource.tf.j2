resource "azurerm_data_factory_linked_service_azure_blob_storage" "example" {
    additional_properties = {
        key = "{{ additional_properties_value }}"
      }
    annotations = ["{{ annotations }}"]
    connection_string = "{{ connection_string }}"
    connection_string_insecure = "{{ connection_string_insecure }}"
    data_factory_id = "{{ data_factory_id }}"
    description = "{{ description }}"
    id = "{{ id }}"
    integration_runtime_name = "{{ integration_runtime_name }}"
    name = "{{ name }}"
    parameters = {
        key = "{{ parameters_value }}"
      }
    sas_uri = "{{ sas_uri }}"
    service_endpoint = "{{ service_endpoint }}"
    service_principal_id = "{{ service_principal_id }}"
    service_principal_key = "{{ service_principal_key }}"
    storage_kind = "{{ storage_kind }}"
    tenant_id = "{{ tenant_id }}"
    use_managed_identity = {{ use_managed_identity }}
    key_vault_sas_token {
      linked_service_name = "{{ linked_service_name }}"
      secret_name = "{{ secret_name }}"
    }
    sas_token_linked_key_vault_key {
      linked_service_name = "{{ linked_service_name }}"
      secret_name = "{{ secret_name }}"
    }
    service_principal_linked_key_vault_key {
      linked_service_name = "{{ linked_service_name }}"
      secret_name = "{{ secret_name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
