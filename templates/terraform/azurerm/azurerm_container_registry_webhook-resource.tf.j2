resource "azurerm_container_registry_webhook" "example" {
    actions = ["{{ actions }}"]
    custom_headers = {
        key = "{{ custom_headers_value }}"
      }
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    registry_name = "{{ registry_name }}"
    resource_group_name = "{{ resource_group_name }}"
    scope = "{{ scope }}"
    service_uri = "{{ service_uri }}"
    status = "{{ status }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
