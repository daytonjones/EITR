resource "azurerm_api_management_diagnostic" "example" {
    always_log_errors = {{ always_log_errors }}
    api_management_logger_id = "{{ api_management_logger_id }}"
    api_management_name = "{{ api_management_name }}"
    http_correlation_protocol = "{{ http_correlation_protocol }}"
    id = "{{ id }}"
    identifier = "{{ identifier }}"
    log_client_ip = {{ log_client_ip }}
    operation_name_format = "{{ operation_name_format }}"
    resource_group_name = "{{ resource_group_name }}"
    sampling_percentage = {{ sampling_percentage }}
    verbosity = "{{ verbosity }}"
    backend_request {
      body_bytes = {{ body_bytes }}
      headers_to_log = ["{{ headers_to_log }}"]
      data_masking {
        headers {
          mode = "{{ mode }}"
          value = "{{ value }}"
        }
        query_params {
          mode = "{{ mode }}"
          value = "{{ value }}"
        }
      }
    }
    backend_response {
      body_bytes = {{ body_bytes }}
      headers_to_log = ["{{ headers_to_log }}"]
      data_masking {
        headers {
          mode = "{{ mode }}"
          value = "{{ value }}"
        }
        query_params {
          mode = "{{ mode }}"
          value = "{{ value }}"
        }
      }
    }
    frontend_request {
      body_bytes = {{ body_bytes }}
      headers_to_log = ["{{ headers_to_log }}"]
      data_masking {
        headers {
          mode = "{{ mode }}"
          value = "{{ value }}"
        }
        query_params {
          mode = "{{ mode }}"
          value = "{{ value }}"
        }
      }
    }
    frontend_response {
      body_bytes = {{ body_bytes }}
      headers_to_log = ["{{ headers_to_log }}"]
      data_masking {
        headers {
          mode = "{{ mode }}"
          value = "{{ value }}"
        }
        query_params {
          mode = "{{ mode }}"
          value = "{{ value }}"
        }
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
