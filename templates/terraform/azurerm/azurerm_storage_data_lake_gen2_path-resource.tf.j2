resource "azurerm_storage_data_lake_gen2_path" "example" {
    filesystem_name = "{{ filesystem_name }}"
    group = "{{ group }}"
    id = "{{ id }}"
    owner = "{{ owner }}"
    path = "{{ path }}"
    resource = "{{ resource }}"
    storage_account_id = "{{ storage_account_id }}"
    ace {
      id = "{{ id }}"
      permissions = "{{ permissions }}"
      scope = "{{ scope }}"
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
