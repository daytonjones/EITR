resource "azurerm_mssql_job_schedule" "example" {
    enabled = {{ enabled }}
    end_time = "{{ end_time }}"
    id = "{{ id }}"
    interval = "{{ interval }}"
    job_id = "{{ job_id }}"
    start_time = "{{ start_time }}"
    type = "{{ type }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
