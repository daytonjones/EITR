resource "azurerm_logic_app_trigger_custom" "example" {
    body = "{{ body }}"
    id = "{{ id }}"
    logic_app_id = "{{ logic_app_id }}"
    name = "{{ name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
