resource "azurerm_app_configuration_key" "example" {
    configuration_store_id = "{{ configuration_store_id }}"
    content_type = "{{ content_type }}"
    etag = "{{ etag }}"
    id = "{{ id }}"
    key = "{{ key }}"
    label = "{{ label }}"
    locked = {{ locked }}
    tags = {
        key = "{{ tags_value }}"
      }
    type = "{{ type }}"
    value = "{{ value }}"
    vault_key_reference = "{{ vault_key_reference }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
