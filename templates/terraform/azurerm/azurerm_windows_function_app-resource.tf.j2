        client_secret_setting_name = "{{ client_secret_setting_name }}"
      }
      facebook {
        app_id = "{{ app_id }}"
        app_secret = "{{ app_secret }}"
        app_secret_setting_name = "{{ app_secret_setting_name }}"
        oauth_scopes = ["{{ oauth_scopes }}"]
      }
      github {
        client_id = "{{ client_id }}"
        client_secret = "{{ client_secret }}"
        client_secret_setting_name = "{{ client_secret_setting_name }}"
        oauth_scopes = ["{{ oauth_scopes }}"]
      }
      google {
        client_id = "{{ client_id }}"
        client_secret = "{{ client_secret }}"
        client_secret_setting_name = "{{ client_secret_setting_name }}"
        oauth_scopes = ["{{ oauth_scopes }}"]
      }
      microsoft {
        client_id = "{{ client_id }}"
        client_secret = "{{ client_secret }}"
        client_secret_setting_name = "{{ client_secret_setting_name }}"
        oauth_scopes = ["{{ oauth_scopes }}"]
