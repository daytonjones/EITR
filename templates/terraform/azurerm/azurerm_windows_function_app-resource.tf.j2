        keep_at_least_one_backup = {{ keep_at_least_one_backup }}
        retention_period_days = {{ retention_period_days }}
        start_time = "{{ start_time }}"
      }
    }
    connection_string {
      name = "{{ name }}"
      type = "{{ type }}"
      value = "{{ value }}"
    }
    identity {
      identity_ids = ["{{ identity_ids }}"]
