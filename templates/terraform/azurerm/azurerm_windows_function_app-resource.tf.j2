        action = "{{ action }}"
        description = "{{ description }}"
        headers = ["{{ headers }}"]
        ip_address = "{{ ip_address }}"
        name = "{{ name }}"
        priority = {{ priority }}
        service_tag = "{{ service_tag }}"
        virtual_network_subnet_id = "{{ virtual_network_subnet_id }}"
