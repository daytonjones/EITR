resource "azurerm_spring_cloud_configuration_service" "example" {
    generation = "{{ generation }}"
    id = "{{ id }}"
    name = "{{ name }}"
    refresh_interval_in_seconds = {{ refresh_interval_in_seconds }}
    spring_cloud_service_id = "{{ spring_cloud_service_id }}"
    repository {
      ca_certificate_id = "{{ ca_certificate_id }}"
      host_key = "{{ host_key }}"
      host_key_algorithm = "{{ host_key_algorithm }}"
      label = "{{ label }}"
      name = "{{ name }}"
      password = "{{ password }}"
      patterns = ["{{ patterns }}"]
      private_key = "{{ private_key }}"
      search_paths = ["{{ search_paths }}"]
      strict_host_key_checking = {{ strict_host_key_checking }}
      uri = "{{ uri }}"
      username = "{{ username }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
