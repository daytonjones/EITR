resource "azurerm_key_vault_managed_hardware_security_module_role_definition" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    managed_hsm_id = "{{ managed_hsm_id }}"
    name = "{{ name }}"
    role_name = "{{ role_name }}"
    permission {
      actions = ["{{ actions }}"]
      data_actions = ["{{ data_actions }}"]
      not_actions = ["{{ not_actions }}"]
      not_data_actions = ["{{ not_data_actions }}"]
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
