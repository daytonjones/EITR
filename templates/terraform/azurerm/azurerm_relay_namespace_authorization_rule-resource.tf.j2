resource "azurerm_relay_namespace_authorization_rule" "example" {
    id = "{{ id }}"
    listen = {{ listen }}
    manage = {{ manage }}
    name = "{{ name }}"
    namespace_name = "{{ namespace_name }}"
    resource_group_name = "{{ resource_group_name }}"
    send = {{ send }}
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
