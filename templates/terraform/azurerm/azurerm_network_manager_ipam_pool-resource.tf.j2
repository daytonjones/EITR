resource "azurerm_network_manager_ipam_pool" "example" {
    address_prefixes = ["{{ address_prefixes }}"]
    description = "{{ description }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    network_manager_id = "{{ network_manager_id }}"
    parent_pool_name = "{{ parent_pool_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
