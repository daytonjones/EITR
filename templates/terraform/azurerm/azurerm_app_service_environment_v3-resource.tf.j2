resource "azurerm_app_service_environment_v3" "example" {
    allow_new_private_endpoint_connections = {{ allow_new_private_endpoint_connections }}
    dedicated_host_count = {{ dedicated_host_count }}
    id = "{{ id }}"
    internal_load_balancing_mode = "{{ internal_load_balancing_mode }}"
    name = "{{ name }}"
    remote_debugging_enabled = {{ remote_debugging_enabled }}
    resource_group_name = "{{ resource_group_name }}"
    subnet_id = "{{ subnet_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    zone_redundant = {{ zone_redundant }}
    cluster_setting {
      name = "{{ name }}"
      value = "{{ value }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
