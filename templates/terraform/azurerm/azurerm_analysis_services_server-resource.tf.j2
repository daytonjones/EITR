resource "azurerm_analysis_services_server" "example" {
    admin_users = ["{{ admin_users }}"]
    backup_blob_container_uri = "{{ backup_blob_container_uri }}"
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    power_bi_service_enabled = {{ power_bi_service_enabled }}
    querypool_connection_mode = "{{ querypool_connection_mode }}"
    resource_group_name = "{{ resource_group_name }}"
    sku = "{{ sku }}"
    tags = {
        key = "{{ tags_value }}"
      }
    ipv4_firewall_rule {
      name = "{{ name }}"
      range_end = "{{ range_end }}"
      range_start = "{{ range_start }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
