resource "azurerm_cosmosdb_sql_function" "example" {
    body = "{{ body }}"
    container_id = "{{ container_id }}"
    id = "{{ id }}"
    name = "{{ name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
