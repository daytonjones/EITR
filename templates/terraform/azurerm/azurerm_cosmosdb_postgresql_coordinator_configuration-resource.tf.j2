resource "azurerm_cosmosdb_postgresql_coordinator_configuration" "example" {
    cluster_id = "{{ cluster_id }}"
    id = "{{ id }}"
    name = "{{ name }}"
    value = "{{ value }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
