resource "azurerm_dev_center_dev_box_definition" "example" {
    dev_center_id = "{{ dev_center_id }}"
    hibernate_support_enabled = {{ hibernate_support_enabled }}
    id = "{{ id }}"
    image_reference_id = "{{ image_reference_id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    sku_name = "{{ sku_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
