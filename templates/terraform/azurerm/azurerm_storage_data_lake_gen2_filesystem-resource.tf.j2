resource "azurerm_storage_data_lake_gen2_filesystem" "example" {
    default_encryption_scope = "{{ default_encryption_scope }}"
    group = "{{ group }}"
    id = "{{ id }}"
    name = "{{ name }}"
    owner = "{{ owner }}"
    properties = {
        key = "{{ properties_value }}"
      }
    storage_account_id = "{{ storage_account_id }}"
    ace {
      id = "{{ id }}"
      permissions = "{{ permissions }}"
      scope = "{{ scope }}"
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
