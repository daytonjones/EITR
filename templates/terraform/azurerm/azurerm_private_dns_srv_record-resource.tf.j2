resource "azurerm_private_dns_srv_record" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    ttl = {{ ttl }}
    zone_name = "{{ zone_name }}"
    record {
      port = {{ port }}
      priority = {{ priority }}
      target = "{{ target }}"
      weight = {{ weight }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
