resource "azurerm_storage_queue" "example" {
    id = "{{ id }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    name = "{{ name }}"
    storage_account_id = "{{ storage_account_id }}"
    storage_account_name = "{{ storage_account_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
