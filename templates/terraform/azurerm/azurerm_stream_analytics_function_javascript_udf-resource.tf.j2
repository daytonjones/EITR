resource "azurerm_stream_analytics_function_javascript_udf" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    script = "{{ script }}"
    stream_analytics_job_name = "{{ stream_analytics_job_name }}"
    input {
      configuration_parameter = {{ configuration_parameter }}
      type = "{{ type }}"
    }
    output {
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
