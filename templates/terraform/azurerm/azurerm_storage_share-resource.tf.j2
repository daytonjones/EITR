resource "azurerm_storage_share" "example" {
    access_tier = "{{ access_tier }}"
    enabled_protocol = "{{ enabled_protocol }}"
    id = "{{ id }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    name = "{{ name }}"
    quota = {{ quota }}
    storage_account_id = "{{ storage_account_id }}"
    storage_account_name = "{{ storage_account_name }}"
    acl {
      id = "{{ id }}"
      access_policy {
        expiry = "{{ expiry }}"
        permissions = "{{ permissions }}"
        start = "{{ start }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
