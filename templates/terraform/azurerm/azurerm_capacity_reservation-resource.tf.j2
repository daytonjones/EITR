resource "azurerm_capacity_reservation" "example" {
    capacity_reservation_group_id = "{{ capacity_reservation_group_id }}"
    id = "{{ id }}"
    name = "{{ name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    zone = "{{ zone }}"
    sku {
      capacity = {{ capacity }}
      name = "{{ name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
