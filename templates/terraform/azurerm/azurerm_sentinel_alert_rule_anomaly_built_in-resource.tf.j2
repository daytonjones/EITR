resource "azurerm_sentinel_alert_rule_anomaly_built_in" "example" {
    display_name = "{{ display_name }}"
    enabled = {{ enabled }}
    id = "{{ id }}"
    log_analytics_workspace_id = "{{ log_analytics_workspace_id }}"
    mode = "{{ mode }}"
    name = "{{ name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
