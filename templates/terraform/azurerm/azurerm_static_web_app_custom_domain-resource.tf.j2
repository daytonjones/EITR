resource "azurerm_static_web_app_custom_domain" "example" {
    domain_name = "{{ domain_name }}"
    id = "{{ id }}"
    static_web_app_id = "{{ static_web_app_id }}"
    validation_type = "{{ validation_type }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
    }
}
