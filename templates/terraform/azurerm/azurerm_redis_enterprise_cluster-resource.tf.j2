resource "azurerm_redis_enterprise_cluster" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    minimum_tls_version = "{{ minimum_tls_version }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    sku_name = "{{ sku_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    zones = ["{{ zones }}"]
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
