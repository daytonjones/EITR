resource "azurerm_private_dns_resolver_forwarding_rule" "example" {
    dns_forwarding_ruleset_id = "{{ dns_forwarding_ruleset_id }}"
    domain_name = "{{ domain_name }}"
    enabled = {{ enabled }}
    id = "{{ id }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    name = "{{ name }}"
    target_dns_servers {
      ip_address = "{{ ip_address }}"
      port = {{ port }}
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
