resource "azurerm_kusto_script" "example" {
    continue_on_errors_enabled = {{ continue_on_errors_enabled }}
    database_id = "{{ database_id }}"
    force_an_update_when_value_changed = "{{ force_an_update_when_value_changed }}"
    id = "{{ id }}"
    name = "{{ name }}"
    principal_permissions_action = "{{ principal_permissions_action }}"
    sas_token = "{{ sas_token }}"
    script_content = "{{ script_content }}"
    script_level = "{{ script_level }}"
    url = "{{ url }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
