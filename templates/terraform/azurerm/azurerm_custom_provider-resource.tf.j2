resource "azurerm_custom_provider" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    action {
      endpoint = "{{ endpoint }}"
      name = "{{ name }}"
    }
    resource_type {
      endpoint = "{{ endpoint }}"
      name = "{{ name }}"
      routing_type = "{{ routing_type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
    validation {
      specification = "{{ specification }}"
    }
}
