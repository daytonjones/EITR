resource "azurerm_monitor_data_collection_endpoint" "example" {
    description = "{{ description }}"
    id = "{{ id }}"
    kind = "{{ kind }}"
    location = "{{ location }}"
    name = "{{ name }}"
    public_network_access_enabled = {{ public_network_access_enabled }}
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
