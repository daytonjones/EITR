resource "azurerm_mssql_job_credential" "example" {
    id = "{{ id }}"
    job_agent_id = "{{ job_agent_id }}"
    name = "{{ name }}"
    password = "{{ password }}"
    password_wo = "{{ password_wo }}"
    password_wo_version = {{ password_wo_version }}
    username = "{{ username }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
