resource "azurerm_storage_share_directory" "example" {
    id = "{{ id }}"
    metadata = {
        key = "{{ metadata_value }}"
      }
    name = "{{ name }}"
    storage_share_id = "{{ storage_share_id }}"
    storage_share_url = "{{ storage_share_url }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
