resource "azurerm_application_insights_workbook_template" "example" {
    author = "{{ author }}"
    id = "{{ id }}"
    localized = "{{ localized }}"
    location = "{{ location }}"
    name = "{{ name }}"
    priority = {{ priority }}
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    template_data = "{{ template_data }}"
    galleries {
      category = "{{ category }}"
      name = "{{ name }}"
      order = {{ order }}
      resource_type = "{{ resource_type }}"
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
