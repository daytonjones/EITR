resource "azurerm_private_dns_aaaa_record" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    records = ["{{ records }}"]
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    ttl = {{ ttl }}
    zone_name = "{{ zone_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
