resource "azurerm_logic_app_trigger_http_request" "example" {
    id = "{{ id }}"
    logic_app_id = "{{ logic_app_id }}"
    method = "{{ method }}"
    name = "{{ name }}"
    relative_path = "{{ relative_path }}"
    schema = "{{ schema }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
