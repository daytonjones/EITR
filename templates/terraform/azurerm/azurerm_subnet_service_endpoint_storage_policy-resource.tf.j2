resource "azurerm_subnet_service_endpoint_storage_policy" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    definition {
      description = "{{ description }}"
      name = "{{ name }}"
      service = "{{ service }}"
      service_resources = ["{{ service_resources }}"]
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
