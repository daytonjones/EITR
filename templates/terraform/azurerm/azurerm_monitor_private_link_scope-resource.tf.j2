resource "azurerm_monitor_private_link_scope" "example" {
    id = "{{ id }}"
    ingestion_access_mode = "{{ ingestion_access_mode }}"
    name = "{{ name }}"
    query_access_mode = "{{ query_access_mode }}"
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
