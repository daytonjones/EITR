resource "azurerm_cosmosdb_mongo_role_definition" "example" {
    cosmos_mongo_database_id = "{{ cosmos_mongo_database_id }}"
    id = "{{ id }}"
    inherited_role_names = ["{{ inherited_role_names }}"]
    role_name = "{{ role_name }}"
    privilege {
      actions = ["{{ actions }}"]
      resource {
        collection_name = "{{ collection_name }}"
        db_name = "{{ db_name }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
