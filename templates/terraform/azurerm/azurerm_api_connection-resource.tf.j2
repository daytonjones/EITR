resource "azurerm_api_connection" "example" {
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    managed_api_id = "{{ managed_api_id }}"
    name = "{{ name }}"
    parameter_values = {
        key = "{{ parameter_values_value }}"
      }
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
