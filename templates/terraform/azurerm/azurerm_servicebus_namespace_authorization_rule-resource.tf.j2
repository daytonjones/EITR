resource "azurerm_servicebus_namespace_authorization_rule" "example" {
    id = "{{ id }}"
    listen = {{ listen }}
    manage = {{ manage }}
    name = "{{ name }}"
    namespace_id = "{{ namespace_id }}"
    send = {{ send }}
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
