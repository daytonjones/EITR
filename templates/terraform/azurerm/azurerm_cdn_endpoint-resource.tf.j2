        query_string = "{{ query_string }}"
        redirect_type = "{{ redirect_type }}"
      }
      url_rewrite_action {
        destination = "{{ destination }}"
        preserve_unmatched_path = {{ preserve_unmatched_path }}
        source_pattern = "{{ source_pattern }}"
      }
    }
    origin {
      host_name = "{{ host_name }}"
      http_port = {{ http_port }}
      https_port = {{ https_port }}
      name = "{{ name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
