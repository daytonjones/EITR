resource "azurerm_virtual_hub_route_table" "example" {
    id = "{{ id }}"
    labels = ["{{ labels }}"]
    name = "{{ name }}"
    virtual_hub_id = "{{ virtual_hub_id }}"
    route {
      destinations = ["{{ destinations }}"]
      destinations_type = "{{ destinations_type }}"
      name = "{{ name }}"
      next_hop = "{{ next_hop }}"
      next_hop_type = "{{ next_hop_type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
