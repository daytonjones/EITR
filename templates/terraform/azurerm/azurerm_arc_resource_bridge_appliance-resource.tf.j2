resource "azurerm_arc_resource_bridge_appliance" "example" {
    distro = "{{ distro }}"
    id = "{{ id }}"
    infrastructure_provider = "{{ infrastructure_provider }}"
    location = "{{ location }}"
    name = "{{ name }}"
    public_key_base64 = "{{ public_key_base64 }}"
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    identity {
      type = "{{ type }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
