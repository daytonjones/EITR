resource "azurerm_batch_certificate" "example" {
    account_name = "{{ account_name }}"
    certificate = "{{ certificate }}"
    format = "{{ format }}"
    id = "{{ id }}"
    password = "{{ password }}"
    resource_group_name = "{{ resource_group_name }}"
    thumbprint = "{{ thumbprint }}"
    thumbprint_algorithm = "{{ thumbprint_algorithm }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
