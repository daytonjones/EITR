resource "azurerm_function_app_function" "example" {
    config_json = "{{ config_json }}"
    enabled = {{ enabled }}
    function_app_id = "{{ function_app_id }}"
    id = "{{ id }}"
    language = "{{ language }}"
    name = "{{ name }}"
    test_data = "{{ test_data }}"
    file {
      content = "{{ content }}"
      name = "{{ name }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
