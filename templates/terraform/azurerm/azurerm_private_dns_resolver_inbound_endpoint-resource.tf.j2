resource "azurerm_private_dns_resolver_inbound_endpoint" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    private_dns_resolver_id = "{{ private_dns_resolver_id }}"
    tags = {
        key = "{{ tags_value }}"
      }
    ip_configurations {
      private_ip_address = "{{ private_ip_address }}"
      private_ip_allocation_method = "{{ private_ip_allocation_method }}"
      subnet_id = "{{ subnet_id }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
