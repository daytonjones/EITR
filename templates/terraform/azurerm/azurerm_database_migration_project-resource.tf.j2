resource "azurerm_database_migration_project" "example" {
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    service_name = "{{ service_name }}"
    source_platform = "{{ source_platform }}"
    tags = {
        key = "{{ tags_value }}"
      }
    target_platform = "{{ target_platform }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
