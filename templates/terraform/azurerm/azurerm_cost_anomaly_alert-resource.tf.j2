resource "azurerm_cost_anomaly_alert" "example" {
    display_name = "{{ display_name }}"
    email_addresses = ["{{ email_addresses }}"]
    email_subject = "{{ email_subject }}"
    id = "{{ id }}"
    message = "{{ message }}"
    name = "{{ name }}"
    notification_email = "{{ notification_email }}"
    subscription_id = "{{ subscription_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
