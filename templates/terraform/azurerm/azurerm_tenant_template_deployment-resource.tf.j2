resource "azurerm_tenant_template_deployment" "example" {
    debug_level = "{{ debug_level }}"
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    parameters_content = "{{ parameters_content }}"
    tags = {
        key = "{{ tags_value }}"
      }
    template_content = "{{ template_content }}"
    template_spec_version_id = "{{ template_spec_version_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
