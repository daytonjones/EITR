resource "azurerm_dns_caa_record" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    ttl = {{ ttl }}
    zone_name = "{{ zone_name }}"
    record {
      flags = {{ flags }}
      tag = "{{ tag }}"
      value = "{{ value }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
