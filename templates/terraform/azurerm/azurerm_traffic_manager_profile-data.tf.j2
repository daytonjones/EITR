data "azurerm_traffic_manager_profile" "example" {
    id = "{{ id }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    traffic_view_enabled = {{ traffic_view_enabled }}
    timeouts {
      read = "{{ read }}"
    }
}
