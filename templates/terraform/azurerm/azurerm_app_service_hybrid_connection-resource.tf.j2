resource "azurerm_app_service_hybrid_connection" "example" {
    app_service_name = "{{ app_service_name }}"
    hostname = "{{ hostname }}"
    id = "{{ id }}"
    port = {{ port }}
    relay_id = "{{ relay_id }}"
    resource_group_name = "{{ resource_group_name }}"
    send_key_name = "{{ send_key_name }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
