resource "azurerm_iothub_device_update_instance" "example" {
    device_update_account_id = "{{ device_update_account_id }}"
    diagnostic_enabled = {{ diagnostic_enabled }}
    id = "{{ id }}"
    iothub_id = "{{ iothub_id }}"
    name = "{{ name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    diagnostic_storage_account {
      connection_string = "{{ connection_string }}"
      id = "{{ id }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
