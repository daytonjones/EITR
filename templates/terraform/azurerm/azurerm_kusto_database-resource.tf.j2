resource "azurerm_kusto_database" "example" {
    cluster_name = "{{ cluster_name }}"
    hot_cache_period = "{{ hot_cache_period }}"
    id = "{{ id }}"
    location = "{{ location }}"
    name = "{{ name }}"
    resource_group_name = "{{ resource_group_name }}"
    soft_delete_period = "{{ soft_delete_period }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
