resource "azurerm_data_factory_custom_dataset" "example" {
    additional_properties = {
        key = "{{ additional_properties_value }}"
      }
    annotations = ["{{ annotations }}"]
    data_factory_id = "{{ data_factory_id }}"
    description = "{{ description }}"
    folder = "{{ folder }}"
    id = "{{ id }}"
    name = "{{ name }}"
    parameters = {
        key = "{{ parameters_value }}"
      }
    schema_json = "{{ schema_json }}"
    type = "{{ type }}"
    type_properties_json = "{{ type_properties_json }}"
    linked_service {
      name = "{{ name }}"
      parameters = {
        key = "{{ parameters_value }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
