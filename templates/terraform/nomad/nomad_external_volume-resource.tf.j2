resource "nomad_external_volume" "example" {
    capacity_max = "{{ capacity_max }}"
    capacity_min = "{{ capacity_min }}"
    clone_id = "{{ clone_id }}"
    id = "{{ id }}"
    name = "{{ name }}"
    namespace = "{{ namespace }}"
    parameters = {
        key = "{{ parameters_value }}"
      }
    plugin_id = "{{ plugin_id }}"
    secrets = {
        key = "{{ secrets_value }}"
      }
    snapshot_id = "{{ snapshot_id }}"
    type = "{{ type }}"
    volume_id = "{{ volume_id }}"
    capability {
      access_mode = "{{ access_mode }}"
      attachment_mode = "{{ attachment_mode }}"
    }
    mount_options {
      fs_type = "{{ fs_type }}"
      mount_flags = ["{{ mount_flags }}"]
    }
    topology_request {
      preferred {
        topology {
          segments = {
        key = "{{ segments_value }}"
      }
        }
      }
      required {
        topology {
          segments = {
        key = "{{ segments_value }}"
      }
        }
      }
    }
}
