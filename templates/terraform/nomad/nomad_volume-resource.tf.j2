resource "nomad_volume" "example" {
    access_mode = "{{ access_mode }}"
    attachment_mode = "{{ attachment_mode }}"
    context = {
        key = "{{ context_value }}"
      }
    deregister_on_destroy = {{ deregister_on_destroy }}
    external_id = "{{ external_id }}"
    id = "{{ id }}"
    name = "{{ name }}"
    namespace = "{{ namespace }}"
    parameters = {
        key = "{{ parameters_value }}"
      }
    plugin_id = "{{ plugin_id }}"
    secrets = {
        key = "{{ secrets_value }}"
      }
    type = "{{ type }}"
    volume_id = "{{ volume_id }}"
    capability {
      access_mode = "{{ access_mode }}"
      attachment_mode = "{{ attachment_mode }}"
    }
    mount_options {
      fs_type = "{{ fs_type }}"
      mount_flags = ["{{ mount_flags }}"]
    }
    topology_request {
      required {
        topology {
          segments = {
        key = "{{ segments_value }}"
      }
        }
      }
    }
}
