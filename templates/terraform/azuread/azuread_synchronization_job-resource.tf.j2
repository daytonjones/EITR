resource "azuread_synchronization_job" "example" {
    enabled = {{ enabled }}
    id = "{{ id }}"
    service_principal_id = "{{ service_principal_id }}"
    template_id = "{{ template_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
