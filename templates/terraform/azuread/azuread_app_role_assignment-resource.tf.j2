resource "azuread_app_role_assignment" "example" {
    app_role_id = "{{ app_role_id }}"
    id = "{{ id }}"
    principal_object_id = "{{ principal_object_id }}"
    resource_object_id = "{{ resource_object_id }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
    }
}
