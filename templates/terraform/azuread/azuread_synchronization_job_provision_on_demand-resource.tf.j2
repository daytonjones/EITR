resource "azuread_synchronization_job_provision_on_demand" "example" {
    id = "{{ id }}"
    service_principal_id = "{{ service_principal_id }}"
    synchronization_job_id = "{{ synchronization_job_id }}"
    triggers = {
        key = "{{ triggers_value }}"
      }
    parameter {
      rule_id = "{{ rule_id }}"
      subject {
        object_id = "{{ object_id }}"
        object_type_name = "{{ object_type_name }}"
      }
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
    }
}
