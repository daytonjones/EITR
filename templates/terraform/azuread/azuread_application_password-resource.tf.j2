resource "azuread_application_password" "example" {
    application_id = "{{ application_id }}"
    display_name = "{{ display_name }}"
    end_date = "{{ end_date }}"
    end_date_relative = "{{ end_date_relative }}"
    id = "{{ id }}"
    rotate_when_changed = {
        key = "{{ rotate_when_changed_value }}"
      }
    start_date = "{{ start_date }}"
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
