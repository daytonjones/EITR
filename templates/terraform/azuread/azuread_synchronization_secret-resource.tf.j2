resource "azuread_synchronization_secret" "example" {
    id = "{{ id }}"
    service_principal_id = "{{ service_principal_id }}"
    credential {
      key = "{{ key }}"
      value = "{{ value }}"
    }
    timeouts {
      create = "{{ create }}"
      delete = "{{ delete }}"
      read = "{{ read }}"
      update = "{{ update }}"
    }
}
