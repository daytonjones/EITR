resource "hcs_snapshot" "example" {
    id = "{{ id }}"
    managed_application_name = "{{ managed_application_name }}"
    resource_group_name = "{{ resource_group_name }}"
    snapshot_name = "{{ snapshot_name }}"
    timeouts {
      create = "{{ create }}"
      default = "{{ default }}"
      delete = "{{ delete }}"
      update = "{{ update }}"
    }
}
