resource "consul_keys" "example" {
    datacenter = "{{ datacenter }}"
    id = "{{ id }}"
    namespace = "{{ namespace }}"
    partition = "{{ partition }}"
    token = "{{ token }}"
    key {
      default = "{{ default }}"
      delete = {{ delete }}
      flags = {{ flags }}
      name = "{{ name }}"
      path = "{{ path }}"
      value = "{{ value }}"
    }
}
