resource "consul_acl_auth_method" "example" {
    config = {
        key = "{{ config_value }}"
      }
    config_json = "{{ config_json }}"
    description = "{{ description }}"
    display_name = "{{ display_name }}"
    id = "{{ id }}"
    max_token_ttl = "{{ max_token_ttl }}"
    name = "{{ name }}"
    namespace = "{{ namespace }}"
    partition = "{{ partition }}"
    token_locality = "{{ token_locality }}"
    type = "{{ type }}"
    namespace_rule {
      bind_namespace = "{{ bind_namespace }}"
      selector = "{{ selector }}"
    }
}
