resource "consul_key_prefix" "example" {
    datacenter = "{{ datacenter }}"
    id = "{{ id }}"
    namespace = "{{ namespace }}"
    partition = "{{ partition }}"
    path_prefix = "{{ path_prefix }}"
    subkeys = {
        key = "{{ subkeys_value }}"
      }
    token = "{{ token }}"
    subkey {
      flags = {{ flags }}
      path = "{{ path }}"
      value = "{{ value }}"
    }
}
