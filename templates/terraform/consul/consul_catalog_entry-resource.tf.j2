resource "consul_catalog_entry" "example" {
    address = "{{ address }}"
    datacenter = "{{ datacenter }}"
    id = "{{ id }}"
    node = "{{ node }}"
    token = "{{ token }}"
    service {
      address = "{{ address }}"
      id = "{{ id }}"
      name = "{{ name }}"
      port = {{ port }}
      tags = ["{{ tags }}"]
    }
}
