data "consul_nodes" "example" {
    id = "{{ id }}"
    query_options {
      allow_stale = {{ allow_stale }}
      datacenter = "{{ datacenter }}"
      near = "{{ near }}"
      node_meta = {
        key = "{{ node_meta_value }}"
      }
      partition = "{{ partition }}"
      require_consistent = {{ require_consistent }}
      token = "{{ token }}"
      wait_index = {{ wait_index }}
      wait_time = "{{ wait_time }}"
    }
}
