resource "consul_prepared_query" "example" {
    connect = {{ connect }}
    datacenter = "{{ datacenter }}"
    id = "{{ id }}"
    ignore_check_ids = ["{{ ignore_check_ids }}"]
    name = "{{ name }}"
    near = "{{ near }}"
    node_meta = {
        key = "{{ node_meta_value }}"
      }
    only_passing = {{ only_passing }}
    service = "{{ service }}"
    service_meta = {
        key = "{{ service_meta_value }}"
      }
    session = "{{ session }}"
    stored_token = "{{ stored_token }}"
    tags = ["{{ tags }}"]
    token = "{{ token }}"
    dns {
      ttl = "{{ ttl }}"
    }
    failover {
      datacenters = ["{{ datacenters }}"]
      nearest_n = {{ nearest_n }}
      targets {
        datacenter = "{{ datacenter }}"
        peer = "{{ peer }}"
      }
    }
    template {
      regexp = "{{ regexp }}"
      remove_empty_tags = {{ remove_empty_tags }}
      type = "{{ type }}"
    }
}
