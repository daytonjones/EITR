resource "awscc_elasticloadbalancingv2_load_balancer" "example" {
    enable_capacity_reservation_provision_stabilize = {{ enable_capacity_reservation_provision_stabilize }}
    enable_prefix_for_ipv_6_source_nat = "{{ enable_prefix_for_ipv_6_source_nat }}"
    enforce_security_group_inbound_rules_on_private_link_traffic = "{{ enforce_security_group_inbound_rules_on_private_link_traffic }}"
    ip_address_type = "{{ ip_address_type }}"
    ipv_4_ipam_pool_id = "{{ ipv_4_ipam_pool_id }}"
    load_balancer_attributes = "{{ load_balancer_attributes }}"
    minimum_load_balancer_capacity = "{{ minimum_load_balancer_capacity }}"
    name = "{{ name }}"
    scheme = "{{ scheme }}"
    security_groups = ["{{ security_groups }}"]
    subnet_mappings = "{{ subnet_mappings }}"
    subnets = ["{{ subnets }}"]
    tags = "{{ tags }}"
    type = "{{ type }}"
}
