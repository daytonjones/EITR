resource "awscc_glue_trigger" "example" {
    actions = "{{ actions }}"
    description = "{{ description }}"
    event_batching_condition = "{{ event_batching_condition }}"
    name = "{{ name }}"
    predicate = "{{ predicate }}"
    schedule = "{{ schedule }}"
    start_on_creation = {{ start_on_creation }}
    tags = "{{ tags }}"
    type = "{{ type }}"
    workflow_name = "{{ workflow_name }}"
}
