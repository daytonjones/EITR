resource "awscc_entityresolution_matching_workflow" "example" {
    description = "{{ description }}"
    incremental_run_config = "{{ incremental_run_config }}"
    input_source_config = "{{ input_source_config }}"
    output_source_config = "{{ output_source_config }}"
    resolution_techniques = "{{ resolution_techniques }}"
    role_arn = "{{ role_arn }}"
    tags = "{{ tags }}"
    workflow_name = "{{ workflow_name }}"
}
