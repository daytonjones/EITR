resource "awscc_bedrock_flow_alias" "example" {
    concurrency_configuration = "{{ concurrency_configuration }}"
    description = "{{ description }}"
    flow_arn = "{{ flow_arn }}"
    name = "{{ name }}"
    routing_configuration = "{{ routing_configuration }}"
    tags = {
        key = "{{ tags_value }}"
      }
}
