resource "awscc_quicksight_theme" "example" {
    aws_account_id = "{{ aws_account_id }}"
    base_theme_id = "{{ base_theme_id }}"
    configuration = "{{ configuration }}"
    name = "{{ name }}"
    permissions = "{{ permissions }}"
    tags = "{{ tags }}"
    theme_id = "{{ theme_id }}"
    version_description = "{{ version_description }}"
}
