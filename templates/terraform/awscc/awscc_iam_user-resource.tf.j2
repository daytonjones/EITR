resource "awscc_iam_user" "example" {
    groups = ["{{ groups }}"]
    login_profile = "{{ login_profile }}"
    managed_policy_arns = ["{{ managed_policy_arns }}"]
    path = "{{ path }}"
    permissions_boundary = "{{ permissions_boundary }}"
    policies = "{{ policies }}"
    tags = "{{ tags }}"
    user_name = "{{ user_name }}"
}
