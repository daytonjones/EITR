resource "awscc_s3files_mount_target" "example" {
    file_system_id = "{{ file_system_id }}"
    ip_address_type = "{{ ip_address_type }}"
    ipv_4_address = "{{ ipv_4_address }}"
    ipv_6_address = "{{ ipv_6_address }}"
    security_groups = ["{{ security_groups }}"]
    subnet_id = "{{ subnet_id }}"
}
