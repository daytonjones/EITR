resource "awscc_sagemaker_inference_component" "example" {
    deployment_config = "{{ deployment_config }}"
    endpoint_arn = "{{ endpoint_arn }}"
    endpoint_name = "{{ endpoint_name }}"
    inference_component_name = "{{ inference_component_name }}"
