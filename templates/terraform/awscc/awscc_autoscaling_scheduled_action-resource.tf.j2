resource "awscc_autoscaling_scheduled_action" "example" {
    auto_scaling_group_name = "{{ auto_scaling_group_name }}"
    desired_capacity = {{ desired_capacity }}
    end_time = "{{ end_time }}"
    max_size = {{ max_size }}
    min_size = {{ min_size }}
    recurrence = "{{ recurrence }}"
    start_time = "{{ start_time }}"
    time_zone = "{{ time_zone }}"
}
