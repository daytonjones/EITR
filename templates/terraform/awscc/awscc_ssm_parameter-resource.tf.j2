resource "awscc_ssm_parameter" "example" {
    allowed_pattern = "{{ allowed_pattern }}"
    data_type = "{{ data_type }}"
    description = "{{ description }}"
    name = "{{ name }}"
    policies = "{{ policies }}"
    tags = {
        key = "{{ tags_value }}"
      }
    tier = "{{ tier }}"
    type = "{{ type }}"
    value = "{{ value }}"
}
