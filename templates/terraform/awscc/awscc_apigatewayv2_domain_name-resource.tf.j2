resource "awscc_apigatewayv2_domain_name" "example" {
    domain_name = "{{ domain_name }}"
    domain_name_configurations = "{{ domain_name_configurations }}"
    mutual_tls_authentication = "{{ mutual_tls_authentication }}"
    routing_mode = "{{ routing_mode }}"
    tags = {
        key = "{{ tags_value }}"
      }
}
