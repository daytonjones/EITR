resource "awscc_quicksight_folder" "example" {
    aws_account_id = "{{ aws_account_id }}"
    folder_id = "{{ folder_id }}"
    folder_type = "{{ folder_type }}"
    name = "{{ name }}"
    parent_folder_arn = "{{ parent_folder_arn }}"
    permissions = "{{ permissions }}"
    sharing_model = "{{ sharing_model }}"
    tags = "{{ tags }}"
}
