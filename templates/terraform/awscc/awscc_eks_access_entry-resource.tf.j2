resource "awscc_eks_access_entry" "example" {
    access_policies = "{{ access_policies }}"
    cluster_name = "{{ cluster_name }}"
    kubernetes_groups = ["{{ kubernetes_groups }}"]
    principal_arn = "{{ principal_arn }}"
    tags = "{{ tags }}"
    type = "{{ type }}"
    username = "{{ username }}"
}
