resource "awscc_licensemanager_grant" "example" {
    allowed_operations = ["{{ allowed_operations }}"]
    grant_name = "{{ grant_name }}"
    home_region = "{{ home_region }}"
    license_arn = "{{ license_arn }}"
    principals = ["{{ principals }}"]
    status = "{{ status }}"
    tags = "{{ tags }}"
}
