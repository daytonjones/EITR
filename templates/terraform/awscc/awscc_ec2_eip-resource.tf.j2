resource "awscc_ec2_eip" "example" {
    address = "{{ address }}"
    domain = "{{ domain }}"
    instance_id = "{{ instance_id }}"
    ipam_pool_id = "{{ ipam_pool_id }}"
    network_border_group = "{{ network_border_group }}"
    public_ipv_4_pool = "{{ public_ipv_4_pool }}"
    tags = "{{ tags }}"
    transfer_address = "{{ transfer_address }}"
}
