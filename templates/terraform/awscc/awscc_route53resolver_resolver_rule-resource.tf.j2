resource "awscc_route53resolver_resolver_rule" "example" {
    delegation_record = "{{ delegation_record }}"
    domain_name = "{{ domain_name }}"
    name = "{{ name }}"
    resolver_endpoint_id = "{{ resolver_endpoint_id }}"
    rule_type = "{{ rule_type }}"
    tags = "{{ tags }}"
    target_ips = "{{ target_ips }}"
}
