resource "awscc_aps_scraper" "example" {
    alias = "{{ alias }}"
    destination = "{{ destination }}"
    role_configuration = "{{ role_configuration }}"
    scrape_configuration = "{{ scrape_configuration }}"
    scraper_logging_configuration = "{{ scraper_logging_configuration }}"
    source = "{{ source }}"
    tags = "{{ tags }}"
}
