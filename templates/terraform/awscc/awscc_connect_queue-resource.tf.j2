resource "awscc_connect_queue" "example" {
    additional_email_addresses = "{{ additional_email_addresses }}"
    description = "{{ description }}"
    hours_of_operation_arn = "{{ hours_of_operation_arn }}"
    instance_arn = "{{ instance_arn }}"
    max_contacts = {{ max_contacts }}
    name = "{{ name }}"
    outbound_caller_config = "{{ outbound_caller_config }}"
    outbound_email_config = "{{ outbound_email_config }}"
    quick_connect_arns = ["{{ quick_connect_arns }}"]
    status = "{{ status }}"
    tags = "{{ tags }}"
}
