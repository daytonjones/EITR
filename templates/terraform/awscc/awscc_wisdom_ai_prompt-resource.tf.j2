resource "awscc_wisdom_ai_prompt" "example" {
    api_format = "{{ api_format }}"
    assistant_id = "{{ assistant_id }}"
    description = "{{ description }}"
    model_id = "{{ model_id }}"
    name = "{{ name }}"
    tags = {
        key = "{{ tags_value }}"
      }
    template_configuration = "{{ template_configuration }}"
    template_type = "{{ template_type }}"
    type = "{{ type }}"
}
