resource "awscc_imagebuilder_component" "example" {
    change_description = "{{ change_description }}"
    data = "{{ data }}"
    description = "{{ description }}"
    kms_key_id = "{{ kms_key_id }}"
    name = "{{ name }}"
    platform = "{{ platform }}"
    supported_os_versions = ["{{ supported_os_versions }}"]
    tags = {
        key = "{{ tags_value }}"
      }
    uri = "{{ uri }}"
    version = "{{ version }}"
}
