resource "awscc_iottwinmaker_scene" "example" {
    capabilities = ["{{ capabilities }}"]
    content_location = "{{ content_location }}"
    description = "{{ description }}"
    scene_id = "{{ scene_id }}"
    scene_metadata = {
        key = "{{ scene_metadata_value }}"
      }
    tags = {
        key = "{{ tags_value }}"
      }
    workspace_id = "{{ workspace_id }}"
}
