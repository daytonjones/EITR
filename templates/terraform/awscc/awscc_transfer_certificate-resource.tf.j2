resource "awscc_transfer_certificate" "example" {
    active_date = "{{ active_date }}"
    certificate = "{{ certificate }}"
    certificate_chain = "{{ certificate_chain }}"
    description = "{{ description }}"
    inactive_date = "{{ inactive_date }}"
    private_key = "{{ private_key }}"
    tags = "{{ tags }}"
    usage = "{{ usage }}"
}
