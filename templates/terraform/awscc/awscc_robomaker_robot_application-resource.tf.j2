resource "awscc_robomaker_robot_application" "example" {
    current_revision_id = "{{ current_revision_id }}"
    environment = "{{ environment }}"
    name = "{{ name }}"
    robot_software_suite = "{{ robot_software_suite }}"
    sources = "{{ sources }}"
    tags = {
        key = "{{ tags_value }}"
      }
}
